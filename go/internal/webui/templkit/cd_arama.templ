package templkit

// Arama sonuçları sayfası — bitcosar kabuğu.
//
// ÖNCEKİ DURUM: `site_public.html` içindeki `{{define "arama"}}` bloğu
// (site-header/site-footer + kategori listesi motoru). Üst çubuktaki arama
// JS kapalıyken bu sayfaya düşüyor; yani yeni tasarımda arama yapan
// kullanıcı eski kabuğa geçiyordu.
//
// ÇÖZÜM: aynı sonuç verisi (`repo.Content` → `CDStory`), `cd-*` kabuğu.
// Sonuçlar satır listesi olarak basılıyor: arama sonucu tarama işidir,
// büyük kartlar 30 sonucu okunamaz yığın yapıyordu (eski şablon da liste
// kullanıyordu).

// CDAramaSayfa arama sayfası görünümü.
type CDAramaSayfa struct {
	Shell     CDShell
	Title     string
	Desc      string
	Canonical string
	JSONLD    string
	BaseURL   string
	Locale    string

	PageCategory    string
	ContentCategory string

	// Sorgu boşsa sonuç listesi basılmaz, yalnız yönlendirme metni çıkar.
	Sorgu   string
	Sonuclar []CDStory
}

templ CDAramaSayfaView(v CDAramaSayfa) {
	<!doctype html>
	<html lang={ cdDilKodu(v.Shell.Locale) }>
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", SiteName: v.Shell.SiteName, FaviconURL: v.Shell.FaviconURL, RSSFeed: "/rss.xml",
				JSONLD: v.JSONLD, Locale: v.Locale, PageCategory: v.PageCategory,
				ContentCategory: v.ContentCategory, BaseURL: v.BaseURL})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap cd-arama-sayfa">
				<header class="cd-section-title">
					if v.Sorgu != "" {
						<h1>Arama: “{ v.Sorgu }”</h1>
					} else {
						<h1>Arama</h1>
					}
				</header>

				<form class="cd-hisse-ara cd-arama-formu" action="/arama" method="get" role="search">
					<svg class="cd-hisse-ara__ikon" viewBox="0 0 24 24" width="16" height="16"
						fill="none" stroke="currentColor" stroke-width="1.5"
						stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
						focusable="false">
						<path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"></path>
					</svg>
					<input class="cd-hisse-ara__girdi" type="search" name="q" value={ v.Sorgu }
						placeholder="Haber, fiyat veya kategori ara" aria-label="Arama metni"
						autocomplete="off"/>
					<button class="cd-hisse-ara__dugme" type="submit">Ara</button>
				</form>

				if v.Sorgu == "" {
					<p class="cd-arama-bos">{ cdT(v.Locale, "Arama yapmak için bir sözcük yazın.") }</p>
				} else if len(v.Sonuclar) == 0 {
					<p class="cd-arama-bos">“{ v.Sorgu }” için sonuç bulunamadı.</p>
				} else {
					<p class="cd-arama-sayi">{ cdItoa(len(v.Sonuclar)) } sonuç</p>
					<ul class="cd-arama-liste">
						for _, s := range v.Sonuclar {
							<li class="cd-arama-satir">
								if s.Kicker != "" {
									<span class="cd-kicker">{ s.Kicker }</span>
								}
								<h2 class="cd-arama-baslik"><a href={ s.Href }>{ s.Title }</a></h2>
								if s.Spot != "" {
									<p class="cd-arama-spot">{ s.Spot }</p>
								}
								@cdMeta(s)
							</li>
						}
					</ul>
				}
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}
