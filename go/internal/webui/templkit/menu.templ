// Menü Yapısı paneli (templ) — html/template menu_panel karşılığı.
// Sürükle-bırak/sıralama etkileşimleri static/menu.js'te.
package templkit

// MenuRowV menü öğesi satırı.
type MenuRowV struct {
	Slug  string
	URL   string
	Label string
	Name  string
	Sub   bool
}

// MenuCatV eklenebilir kategori.
type MenuCatV struct {
	Slug string
	Name string
}

// MenuDesignOpt tasarım seçeneği.
type MenuDesignOpt struct {
	Key      string
	Name     string
	Desc     string
	Selected bool
	IsCurrent bool
}

// MenuBgV arka plan görünümü.
type MenuBgV struct {
	HasCustom bool
	URL       string
	Disabled  bool
	Size      string
	Position  string
	Repeat    string
	Attach    string
	Overlay   string
}

// MenuView menü paneli görünümü.
type MenuView struct {
	FlashKind    string
	FlashText    string
	Rows         []MenuRowV
	Cats         []MenuCatV
	MegaOptions  []MenuDesignOpt
	CatNav       []MenuDesignOpt
	Bg           MenuBgV
}

// MenuPanel menü yapısı (HTMX hedefi: #menu-panel).
templ MenuPanel(v MenuView) {
	<div id="menu-panel">
		if v.FlashText != "" {
			<div class={ "flash", v.FlashKind }>{ v.FlashText }</div>
		}
		@Yukleniyor("menu-yukleniyor", "Kaydediliyor…")
		<form id="menuHtmxForm" method="post" action="/admin/menu/kaydet" hx-post="/admin/menu/kaydet" hx-target="#menu-panel" hx-swap="outerHTML" hx-indicator="#menu-yukleniyor">
			<input type="hidden" name="items"/>
		</form>
		<div class="grid-2" style="grid-template-columns:2.1fr 1fr;align-items:start">
			<div class="card card-pad">
				<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
					<h2 style="margin-top:0;font-size:1.1rem">Menü Yapısı</h2>
					<div style="display:flex;gap:6px">
						<button class="btn" type="button" id="menuSave"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-device-floppy"></use></svg> Kaydet</button>
						<button class="btn danger small" type="button" id="menuReset" title="Varsayılana dön" hx-post="/admin/menu/sifirla" hx-target="#menu-panel" hx-swap="outerHTML" hx-confirm="Menüyü varsayılana sıfırlasın mı?" hx-indicator="#menu-yukleniyor">Sıfırla</button>
					</div>
				</div>
				<p class="hint">Sürükle-bırak veya ok butonlarıyla sıralayın. Her öğenin <b>adını</b> düzenleyin (boş bırakırsanız kategori adı kullanılır). <b>Ana / Alt (Diğer)</b> anahtarıyla menüde nerede görüneceğini seçin.</p>
				<div id="menuStatus"></div>
				<ul id="menuItems" style="list-style:none;margin:12px 0 0;padding:0;min-height:40px">
					for _, m := range v.Rows {
						<li
							data-slug={ m.Slug }
							data-url={ m.URL }
							data-sub={ subFlag(m.Sub) }
							draggable="true"
							style="display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--border);border-radius:10px;margin-bottom:8px;background:var(--surface,#fff)"
						>
							<span class="m-drag" style="cursor:grab;color:#a1a1aa;font-size:18px;user-select:none" title="Sürükle"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-grip-vertical"></use></svg></span>
							<button type="button" class="btn ghost small m-up" title="Yukarı"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-arrow-up"></use></svg></button>
							<button type="button" class="btn ghost small m-down" title="Aşağı"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-arrow-down"></use></svg></button>
							if m.URL != "" {
								<span class="badge" style="margin-right:2px;flex:0 0 auto"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-link"></use></svg></span>
							}
							<input class="input m-label" value={ m.Label } placeholder={ menuPlaceholder(m) } aria-label={ menuPlaceholder(m) } style="flex:1;min-width:120px" title="Menüde görünecek ad"/>
							<span class={ "shape", "small", "m-type" } style={ menuTypeStyle(m) }>
								if m.URL != "" {
									Özel Link
								} else {
									/{ m.Slug }
								}
							</span>
							<button
								type="button"
								class="btn ghost small m-sub"
								data-role="toggle"
								style={ menuSubStyle(m.Sub) }
								title="Ana menü / Alt menü geçişi"
							>
								if m.Sub {
									Alt menü (Diğer)
								} else {
									Ana menü
								}
							</button>
							<a class="btn danger small m-del" href="#" title="Kaldır"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-x"></use></svg></a>
						</li>
					}
				</ul>
				<p class="hint" style="margin-top:8px">Toplam: <span id="menuCount">{ itoaT(len(v.Rows)) }</span> öğe · Ana: <span id="menuMainCount">0</span> · Alt (Diğer): <span id="menuSubCount">0</span></p>
			</div>
			<div class="gap">
				<div class="card card-pad">
					<h2 style="margin-top:0;font-size:1.1rem">Kategori Ekle</h2>
					<div class="gap">
						for _, c := range v.Cats {
							<label class="tag" style="cursor:pointer;display:flex;gap:6px;align-items:center" data-add={ c.Slug } data-name={ c.Name }>
								<input type="checkbox" class="add-cat" value={ c.Slug }/> { c.Name }
							</label>
						}
					</div>
					<button class="btn" type="button" id="menuAddCats" style="margin-top:10px">Seçilenleri Ekle</button>
				</div>
				<div class="card card-pad">
					<h2 style="margin-top:0;font-size:1.1rem">Özel Link Ekle</h2>
					<div class="field"><label for="linkName">Ad (menüde görünecek)</label><input class="input" id="linkName" placeholder="örn: Hakkımızda"/></div>
					<div class="field"><label for="linkUrl">Bağlantı (URL)</label><input class="input" id="linkUrl" placeholder="örn: /sayfa/hakkimizda"/></div>
					<button class="btn" type="button" id="menuAddLink">Ekle</button>
				</div>
			</div>
		</div>
		<div class="card card-pad" style="margin-top:14px">
			<h2 style="margin-top:0;font-size:1.1rem">Mega Menü Tasarımı</h2>
			<p class="hint" style="margin-top:0">Üst menüde bir kategoriye tıklandığında açılan panelin ve kategori sayfasındaki alt kategori menüsünün görünümü.</p>
			<form method="post" action="/admin/menu/tasarim" hx-post="/admin/menu/tasarim" hx-target="#menu-panel" hx-swap="outerHTML" hx-indicator="#menu-yukleniyor">
				<div class="grid-2" style="align-items:start">
					<div class="field">
						<label for="f_mega">Mega menü paneli</label>
						<select id="f_mega" class="select" name="mega">
							for _, o := range v.MegaOptions {
								<option value={ o.Key } if o.Selected { selected }>{ o.Name }</option>
							}
						</select>
						<p class="hint">{ menuDesignDesc(v.MegaOptions) }</p>
					</div>
					<div class="field">
						<label for="f_catnav">Kategori alt menüsü</label>
						<select id="f_catnav" class="select" name="catnav">
							for _, o := range v.CatNav {
								<option value={ o.Key } if o.Selected { selected }>{ o.Name }</option>
							}
						</select>
						<p class="hint">{ menuDesignDesc(v.CatNav) }</p>
					</div>
				</div>
				<button class="btn" type="submit">Tasarımı kaydet</button>
			</form>
			<p class="hint" style="margin:10px 0 0">Kategori sayfasının modülleri ve şablonları için <a href="/admin/tasarim?sayfa=kategori">Sayfa Tasarımcısı → Kategori Sayfası</a>.</p>
			<div id="mega-bg" style="margin-top:18px;border-top:1px solid var(--line);padding-top:14px">
				<h3 style="margin:0 0 4px;font-size:.98rem">Sayfa Boyu Arka Planı</h3>
				<p class="hint" style="margin-top:0">Yalnızca “Sayfa Boyu (Tam Ekran)” mega menü tasarımında görünür. PNG, JPG, WEBP, GIF veya SVG yükleyebilirsiniz.</p>
				<form method="post" action="/admin/menu/tasarim/arka-plan" enctype="multipart/form-data">
					<div style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-start">
						<div class="bg-preview">
							if v.Bg.HasCustom {
								<img src={ templ.SafeURL(v.Bg.URL) } alt="Mega menü arka plan önizleme"/>
							} else if v.Bg.Disabled {
								<div class="bg-preview-empty">Arka plan<br/>kapalı</div>
							} else {
								<div class="bg-preview-empty">Beyaz zemin<br/>(görsel yok)</div>
							}
						</div>
						<div style="flex:1;min-width:240px;display:grid;gap:8px">
							<input class="input" type="file" name="mega_arka" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,.svg"/>
							<div class="input-row">
								<select class="select" name="size" title="Boyut">
									<option value="cover" if v.Bg.Size == "cover" { selected }>Kapla (cover)</option>
									<option value="contain" if v.Bg.Size == "contain" { selected }>Sığdır (contain)</option>
									<option value="auto" if v.Bg.Size == "auto" { selected }>Otomatik</option>
									<option value="100% 100%" if v.Bg.Size == "100% 100%" { selected }>Uzat</option>
								</select>
								<select class="select" name="position" title="Konum">
									<option value="center top" if v.Bg.Position == "center top" { selected }>Üst orta</option>
									<option value="center" if v.Bg.Position == "center" { selected }>Orta</option>
									<option value="top" if v.Bg.Position == "top" { selected }>Üst</option>
									<option value="bottom" if v.Bg.Position == "bottom" { selected }>Alt</option>
									<option value="left center" if v.Bg.Position == "left center" { selected }>Sol orta</option>
									<option value="right center" if v.Bg.Position == "right center" { selected }>Sağ orta</option>
								</select>
							</div>
							<div class="input-row">
								<select class="select" name="repeat" title="Tekrar">
									<option value="no-repeat" if v.Bg.Repeat == "no-repeat" { selected }>Tekrarsız</option>
									<option value="repeat" if v.Bg.Repeat == "repeat" { selected }>Tekrarla</option>
									<option value="repeat-x" if v.Bg.Repeat == "repeat-x" { selected }>Yatay tekrar</option>
									<option value="repeat-y" if v.Bg.Repeat == "repeat-y" { selected }>Dikey tekrar</option>
								</select>
								<select class="select" name="attach" title="Kaydırma">
									<option value="scroll" if v.Bg.Attach == "scroll" { selected }>Sayfayla kaydır</option>
									<option value="fixed" if v.Bg.Attach == "fixed" { selected }>Sabit</option>
								</select>
							</div>
							<label class="small muted">Beyaz okunabilirlik katmanı: <input class="input" type="number" name="overlay" min="0" max="100" value={ v.Bg.Overlay } style="width:80px" title="0 = görsel tamamen görünür, 100 = tamamen beyaz"/> %</label>
						</div>
					</div>
					<div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:10px">
						<label class="tag" style="cursor:pointer"><input type="checkbox" name="remove_bg"/> Görseli kaldır</label>
						<label class="tag" style="cursor:pointer"><input type="checkbox" name="disable_bg"/> Arka planı kapat</label>
						<button class="btn" type="submit">Arka planı kaydet</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

func subFlag(sub bool) string {
	if sub {
		return "1"
	}
	return "0"
}

func menuPlaceholder(m MenuRowV) string {
	if m.URL != "" {
		return "Link adı"
	}
	if m.Name != "" {
		return m.Name
	}
	return "Kategori"
}

func menuTypeStyle(m MenuRowV) string {
	if m.URL != "" {
		return "border-color:var(--warn);color:var(--warn)"
	}
	return "color:var(--muted-fg)"
}

func menuSubStyle(sub bool) string {
	if sub {
		return "background:var(--tema,transparent);color:#fff"
	}
	return ""
}

func menuDesignDesc(opts []MenuDesignOpt) string {
	for _, o := range opts {
		if o.Selected {
			return o.Desc
		}
	}
	return ""
}