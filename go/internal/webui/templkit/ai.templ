// AI panelleri (templ): 2FA, AI Kaynak Merkezi, AI Sohbet (+ mesaj parçası).
// Sohbet davranışı static/ai-sohbet.js içindedir (inline script kaldırıldı).
package templkit

// TFAView iki aşamalı doğrulama paneli.
type TFAView struct {
	FlashKind   string
	FlashText   string
	Enabled     bool
	Secret      string
}

// TFAPanel 2FA/TOTP paneli (HTMX hedefi: #2fa-panel).
templ TFAPanel(v TFAView) {
	<div id="2fa-panel">
		if v.FlashText != "" {
			<div class={ "flash", v.FlashKind }>{ v.FlashText }</div>
		}
		@Yukleniyor("2fa-yukleniyor", "Değiştiriliyor…")
		<div class="card card-pad" style="max-width:560px">
			<h2 style="margin:0 0 8px;font-size:1.1rem">
				İki Aşamalı Doğrulama (2FA / TOTP)
				if v.Enabled {
					<span class="badge" style="background:var(--ok-fill,var(--ok));color:#fff">Açık</span>
				} else {
					<span class="badge" style="background:var(--warn-fill,var(--warn));color:#fff">Kapalı</span>
				}
			</h2>
			if v.Enabled {
				<p class="small muted">Oturum açarken şifre + TOTP kodu istenir.</p>
				<form method="post" action="/admin/2fa/kapat" class="field" hx-post="/admin/2fa/kapat" hx-target="#2fa-panel" hx-swap="outerHTML" hx-indicator="#2fa-yukleniyor">
					<div class="field">
						<label for="f_kod_kapat">Geçerli TOTP kodu (kapatmak için)</label>
						<div style="display:flex;gap:8px">
							<input id="f_kod_kapat" class="input" name="kod" autocomplete="one-time-code" maxlength="6" required style="width:180px"/>
							<button class="btn danger" type="submit">2FA'yı Kapat</button>
						</div>
					</div>
				</form>
			} else {
				<p class="small muted">Authenticator uygulamanıza (Google Authenticator, Authy, 1Password…) ekleyin:</p>
				<div class="field">
					<label for="f_2fa_secret">Secret</label>
					<input class="input" id="f_2fa_secret" readonly value={ v.Secret } data-sec style="font-family:monospace"/>
					<div class="hint">İpucu: kod adı <code>theblock</code>; zaman tabanlı (TOTP). QR uygulaması için gerekirse secret'ı elle girin.</div>
				</div>
				<form method="post" action="/admin/2fa/kur" class="field" hx-post="/admin/2fa/kur" hx-target="#2fa-panel" hx-swap="outerHTML" hx-indicator="#2fa-yukleniyor">
					<div class="field">
						<label for="f_kod_kur">Doğrulama kodu</label>
						<div style="display:flex;gap:8px">
							<input id="f_kod_kur" class="input" name="kod" autocomplete="one-time-code" maxlength="6" required style="width:180px"/>
							<button class="btn" type="submit">Etkinleştir</button>
						</div>
					</div>
				</form>
			}
		</div>
	</div>
}

// ---- AI Kaynak Merkezi ----

// AIKaynakFeed kaynak bankası satırı.
type AIKaynakFeed struct {
	ID           string
	Name         string
	URL          string
	Homepage     string
	CategoryName string
	KindLabel    string
	Trust        string
	Aktif        bool
	LastStatus   string
	LastError    string
	LastChecked  string
	LastItems    string
	// --- sağlık ve kalite (12 Kasım 2026) ---
	// Dil: kaynağın yayın dili rozeti ("TR"/"EN").
	Dil string
	// GorselOran son çekimde görselli öğe yüzdesi ("" = ölçülmemiş).
	// Görselsiz kaynak kart düzenini bozuyor; listede görünmeli.
	GorselOran string
	// SonBasari son BAŞARILI çekim; boşsa kaynak hiç çalışmamış.
	SonBasari string
	// ArdisikHata üst üste hata sayısı (0 ise boş).
	ArdisikHata string
	// OtomatikKapandi true ise kaynağı bot kapattı, kullanıcı değil.
	OtomatikKapandi bool
	// KapanmaNedeni notes alanından çıkarılan kısa etiket
	// ("KONU DIŞI", "BOZUK"); kapalı kaynağın neden kapalı olduğu
	// listede görünmezse kimse yanıtlayamıyordu.
	KapanmaNedeni string
}

// AIKaynakPlan kategori üretim planı satırı.
type AIKaynakPlan struct {
	ID             string
	CategoryName   string
	DraftedToday   string
	DailyTarget    string
	Eligible       string
	LastRun        string
	MinSources     string
	TrendWeight    string
	MaxAgeHours    string
	Aktif          bool
}

// AIKaynakKume benzer haber kümesi.
type AIKaynakKume struct {
	ID            string
	Title         string
	CategoryName  string
	ItemCount     string
	SourceCount   string
	CrossCategory bool
	TrendTerm     string
	TrendScore    string
	Sources       string
	ContentID     string
}

// AIKaynakPlanSatir kategori planı özet satırı.
type AIKaynakPlanSatir struct {
	Name       string
	Feeds      string
	Clusters   string
	TrendHits  string
	TopCluster string
}

// AIKaynakView AI Kaynak Merkezi paneli.
type AIKaynakView struct {
	FlashKind     string
	FlashText     string
	// --- AI sağlayıcı ve çeviri kuyruğu (12 Kasım 2026) ---
	// AISaglayici bağlı sağlayıcıların adı ("omniroute" gibi);
	// boşsa yapılandırılmamış ve AI işleri (çeviri, taslak yazımı)
	// sessizce mock yanıt üretiyor demektir.
	AISaglayici string
	// CeviriBekleyen kuyrukta bekleyen çeviri isteği sayısı.
	CeviriBekleyen string
	// CeviriHatali başarısız çeviri sayısı.
	CeviriHatali string
	TotalItems    string
	ClusterCount  string
	FeedCount     string
	TrendCount    string
	EnrichPending string
	Plan          []AIKaynakPlanSatir
	Plans         []AIKaynakPlan
	Clusters      []AIKaynakKume
	Feeds         []AIKaynakFeed
	Trends        []TrendBasit
}

// AIKaynakPanel AI Kaynak Merkezi (HTMX hedefi: #ai-source-panel).
templ AIKaynakPanel(v AIKaynakView) {
	<div id="ai-source-panel">
		if v.FlashText != "" {
			<div class={ "flash", v.FlashKind }>{ v.FlashText }</div>
		}
		@Yukleniyor("ai-source-yukleniyor", "Taranıyor…")
		<div class="card card-pad" style="margin-bottom:14px">
			<div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:flex-start">
				<div>
					<h2 style="margin:0 0 4px;font-size:1.15rem">AI Kaynak Merkezi</h2>
					<p class="hint" style="margin:0;max-width:80ch">RSS, HTML ve sitemap kaynaklarını tarar, aynı olayı anlatan haberleri benzerlikle kümeler ve Google Trends terimleriyle eşleştirir. Kümelerden tek tıkla editoryal taslak üretilir.</p>
					if v.EnrichPending != "" {
						<p class="small muted" style="margin:6px 0 0">{ v.EnrichPending } kaynak öğesi özet/kategori kontrolü bekliyor.</p>
					}
					// AI sağlayıcı durumu: yapılandırılmamışsa çeviri ve
					// taslak yazımı sessizce MOCK yanıt üretir — bu
					// panelde görünmezse kimse fark etmiyor.
					<p class="small" style="margin:8px 0 0">
						if v.AISaglayici != "" {
							<span class="tag">AI: { v.AISaglayici }</span>
						} else {
							<span class="tag" style="color:var(--uyari,#b45309)">AI yapılandırılmadı</span>
							<span class="muted"> · çeviri ve taslak yazımı örnek yanıt üretir · </span>
							<a href="/admin/ayarlar#yapay-zeka">Ayarlar → Yapay Zeka</a>
						}
						if v.CeviriBekleyen != "" {
							<span class="muted"> · </span>
							<span class="tag">{ v.CeviriBekleyen } çeviri kuyrukta</span>
						}
						if v.CeviriHatali != "" {
							<span class="muted"> · </span>
							<span class="tag" style="color:var(--uyari,#b45309)">{ v.CeviriHatali } çeviri hatası</span>
						}
					</p>
				</div>
				<div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end">
					<form method="post" action="/admin/ai-kaynak/tara" hx-post="/admin/ai-kaynak/tara" hx-target="#ai-source-panel" hx-swap="outerHTML" hx-indicator="#ai-source-yukleniyor">
						<button class="btn" type="submit">Kaynakları tara</button>
					</form>
					<form method="post" action="/admin/ai-kaynak/zenginlestir" hx-post="/admin/ai-kaynak/zenginlestir" hx-target="#ai-source-panel" hx-swap="outerHTML" hx-indicator="#ai-source-yukleniyor">
						<button class="btn ghost" type="submit">
							Eksik özet/kategori tamamla
							if v.EnrichPending != "" {
								({ v.EnrichPending })
							}
						</button>
					</form>
				</div>
			</div>
		</div>
		<div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px">
			<div class="card card-pad"><div class="small muted">Kaynak öğesi</div><strong style="display:block;font-size:1.6rem">{ v.TotalItems }</strong></div>
			<div class="card card-pad"><div class="small muted">Benzer haber kümesi</div><strong style="display:block;font-size:1.6rem">{ v.ClusterCount }</strong></div>
			<div class="card card-pad"><div class="small muted">Kaynak</div><strong style="display:block;font-size:1.6rem">{ v.FeedCount }</strong></div>
			<div class="card card-pad"><div class="small muted">Trend terimi</div><strong style="display:block;font-size:1.6rem">{ v.TrendCount }</strong></div>
		</div>
		<div class="card card-pad" style="margin-top:14px">
			<h2 style="margin-top:0;font-size:1.05rem">Kategori planı</h2>
			<table class="table" style="width:100%">
				<thead>
					<tr><th>Kategori</th><th>Kayıtlı kaynak</th><th>Küme</th><th>Trend</th><th>Öne çıkan başlık</th></tr>
				</thead>
				<tbody>
					if len(v.Plan) == 0 {
						@TabloBos(5, "stack", "Henüz küme yok", "“Kaynakları tara” ile ilk konu kümesini oluşturun.", "", "")
					}
					for _, p := range v.Plan {
						<tr>
							<td><strong>{ p.Name }</strong></td>
							<td>{ p.Feeds }</td>
							<td>{ p.Clusters }</td>
							<td>{ p.TrendHits }</td>
							<td class="small muted">
								if p.TopCluster != "" {
									{ p.TopCluster }
								} else {
									—
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="card card-pad" style="margin-top:14px">
			<h2 style="margin-top:0;font-size:1.05rem">Kategori üretim planı</h2>
			<p class="hint" style="margin-top:0">Her kategori için günlük taslak hedefi, minimum kaynak sayısı ve trend ağırlığı. “Çalıştır” uygun kümelerden taslak üretir; hiçbir taslak otomatik yayınlanmaz.</p>
			<div style="display:grid;gap:8px">
				if len(v.Plans) == 0 {
					<p class="muted">Kategori planı yok.</p>
				}
				for _, p := range v.Plans {
					<form method="post" action={ templ.SafeURL("/admin/ai-kaynak/plan/" + p.ID) } hx-post={ "/admin/ai-kaynak/plan/" + p.ID } hx-target="#ai-source-panel" hx-swap="outerHTML" hx-indicator="#ai-source-yukleniyor">
						<div style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;border:1px solid var(--line);border-radius:10px;padding:10px">
							<div style="min-width:150px;flex:1">
								<strong>{ p.CategoryName }</strong>
								<div class="small muted">
									Bugün { p.DraftedToday }/{ p.DailyTarget } · { p.Eligible } uygun küme
									if p.LastRun != "" {
										· son { p.LastRun }
									}
								</div>
							</div>
							<label class="small muted">Günlük hedef<br/><input class="input" style="width:70px" type="number" min="0" max="50" name="hedef" value={ p.DailyTarget }/></label>
							<label class="small muted">Min. kaynak<br/><input class="input" style="width:70px" type="number" min="1" max="20" name="minsrc" value={ p.MinSources }/></label>
							<label class="small muted">Trend %<br/><input class="input" style="width:70px" type="number" min="0" max="100" name="trend" value={ p.TrendWeight }/></label>
							<label class="small muted">Yaş (saat)<br/><input class="input" style="width:70px" type="number" min="1" max="720" name="yas" value={ p.MaxAgeHours }/></label>
							<label class="small muted">Durum<br/>
								<select class="input" name="aktif">
									<option value="1" if p.Aktif { selected }>Aktif</option>
									<option value="0" if !p.Aktif { selected }>Pasif</option>
								</select>
							</label>
							<button class="btn ghost small" type="submit">Kaydet</button>
							<button class="btn small" type="submit" formaction={ templ.SafeURL("/admin/ai-kaynak/plan/" + p.ID + "/calistir") } hx-post={ "/admin/ai-kaynak/plan/" + p.ID + "/calistir" } hx-include="closest form" hx-target="#ai-source-panel" hx-swap="outerHTML" hx-indicator="#ai-source-yukleniyor">Çalıştır</button>
						</div>
					</form>
				}
			</div>
		</div>
		<div class="card card-pad" style="margin-top:14px">
			<h2 style="margin-top:0;font-size:1.05rem">Benzer haber kümeleri</h2>
			<div style="display:grid;gap:8px">
				if len(v.Clusters) == 0 {
					<p class="muted">Kaynak taraması sonrası kümeler burada görünecek.</p>
				}
				for _, c := range v.Clusters {
					<div class="card card-pad" style="box-shadow:none;border:1px solid var(--line)">
						<div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center">
							<div style="min-width:0">
								<strong>{ c.Title }</strong>
								<div class="small muted" style="margin-top:3px">
									if c.CategoryName != "" {
										{ c.CategoryName } · 
									}
									{ c.ItemCount } haber · { c.SourceCount } kaynak
									if c.CrossCategory {
										· <span class="tag">Çapraz kategori</span>
									}
									if c.TrendTerm != "" {
										· <span style="color:var(--accent)">Trend: { c.TrendTerm } ({ c.TrendScore })</span>
									}
								</div>
								<div class="small muted" style="margin-top:2px">{ c.Sources }</div>
							</div>
							if c.ContentID != "" {
								<a class="btn ghost small" href={ templ.SafeURL("/admin/icerikler/" + c.ContentID) }>Taslak #{ c.ContentID }</a>
							} else {
								<form method="post" action={ templ.SafeURL("/admin/ai-kaynak/kume/" + c.ID + "/taslak") } hx-post={ "/admin/ai-kaynak/kume/" + c.ID + "/taslak" } hx-target="#ai-source-panel" hx-swap="outerHTML" hx-indicator="#ai-source-yukleniyor">
									<button class="btn ghost small" type="submit">AI Taslak</button>
								</form>
							}
						</div>
					</div>
				}
			</div>
		</div>
		<div class="card card-pad" style="margin-top:14px">
			<h2 style="margin-top:0;font-size:1.05rem">Kaynak bankası</h2>
			<p class="hint" style="margin-top:0">Site adresi, doğrulanmış RSS/HTML kaynağı, kategori, güven puanı ve son tarama durumu.</p>
			<table class="table" style="width:100%">
				<thead>
					<tr><th>Kaynak</th><th>Dil</th><th>Kategori</th><th>Güven</th><th>Görsel</th><th>Durum</th><th>Son tarama</th><th>Son başarı</th><th></th></tr>
				</thead>
				<tbody>
					if len(v.Feeds) == 0 {
						@TabloBos(9, "rss", "Kaynak yok", "AI beslemek için bir kaynak ekleyin.", "", "")
					}
					for _, f := range v.Feeds {
						<tr>
							<td>
								<a href={ templ.SafeURL(feedLink(f)) } target="_blank" rel="noopener"><strong>{ f.Name }</strong></a>
								if f.URL != "" {
									<div class="small muted" style="max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
										<a href={ templ.SafeURL(f.URL) } target="_blank" rel="noopener">{ f.URL }</a>
									</div>
								}
							</td>
							<td><span class="tag">{ feedDilEtiketi(f.Dil) }</span></td>
							<td>{ f.CategoryName }</td>
							<td>{ f.Trust }</td>
							<td class={ feedGorselSinifi(f.GorselOran) } title="Son çekimde görseli olan öğelerin yüzdesi; düşük oran kart düzenini bozar">
								if f.GorselOran != "" {
									%{ f.GorselOran }
								} else {
									—
								}
							</td>
							<td>
								if !f.Aktif {
									<span class="tag">{ feedPasifEtiketi(f) }</span>
									if f.OtomatikKapandi {
										<div class="small" style="color:var(--uyari,#b45309)">
											{ f.ArdisikHata } ardışık hata sonrası bot kapattı
										</div>
									}
									if f.LastError != "" {
										<div class="small muted" title={ f.LastError }>{ kirpEtiket(f.LastError, 48) }</div>
									}
								} else if f.LastStatus != "" {
									{ f.LastStatus }
									if f.ArdisikHata != "" {
										<span class="small" style="color:var(--uyari,#b45309)" title="Üst üste başarısız çekim">· { f.ArdisikHata } hata</span>
									}
									if f.LastError != "" {
										<div class="small muted" title={ f.LastError }>{ kirpEtiket(f.LastError, 48) }</div>
									}
								} else {
									bekliyor
								}
							</td>
							<td class="small muted">
								if f.LastChecked != "" {
									{ f.LastChecked }
								} else {
									—
								}
								if f.LastItems != "" {
									· { f.LastItems } öğe
								}
							</td>
							<td class="small muted" title="Son BAŞARILI çekim: kaynağın ne zamandır ölü olduğunu gösterir">
								if f.SonBasari != "" {
									{ f.SonBasari }
								} else {
									hiç
								}
							</td>
							<td>
								<form method="post" action={ templ.SafeURL("/admin/ai-kaynak/feed/" + f.ID + "/durum") }
									hx-post={ "/admin/ai-kaynak/feed/" + f.ID + "/durum" }
									hx-target="#ai-source-panel" hx-swap="outerHTML"
									hx-indicator="#ai-source-yukleniyor">
									if f.Aktif {
										<input type="hidden" name="durum" value="kapat"/>
										<button class="btn ghost small" type="submit">Kapat</button>
									} else {
										<button class="btn small" type="submit" title="Açar ve hata sayacını sıfırlar">Aç</button>
									}
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="card card-pad" style="margin-top:14px">
			<h2 style="margin-top:0;font-size:1.05rem">Trend eşleşmeleri</h2>
			<div style="display:flex;flex-wrap:wrap;gap:6px">
				if len(v.Trends) == 0 {
					<span class="muted">Trend terimi yok.</span>
				}
				for _, t := range v.Trends {
					<span class="tag">
						{ t.A }
						if t.B != "" {
							· { t.B }
						}
					</span>
				}
			</div>
		</div>
	</div>
}

// feedLink kaynak bağlantısı (ana sayfa varsa o, yoksa URL).
func feedLink(f AIKaynakFeed) string {
	if f.Homepage != "" {
		return f.Homepage
	}
	return f.URL
}

// ---- AI Sohbet ----

// AISohbetKonu sohbet listesi satırı.
type AISohbetKonu struct {
	ID     string
	Title  string
	Active bool
}

// AISohbetSablon hızlı istem şablonu.
type AISohbetSablon struct {
	Icon   string
	Title  string
	Prompt string
}

// AISohbetMesaj mesaj balonu.
type AISohbetMesaj struct {
	Role    string // user | assistant
	Content string
}

// AISohbetView AI sohbet paneli.
type AISohbetView struct {
	FlashKind  string
	FlashText  string
	Convs      []AISohbetKonu
	ActiveID   string
	Msgs       []AISohbetMesaj
	Templates  []AISohbetSablon
}

// AISohbetPanel AI sohbet (HTMX hedefi: #ai-sohbet-panel).
templ AISohbetPanel(v AISohbetView) {
	<div id="ai-sohbet-panel" data-ai-chat>
		if v.FlashText != "" {
			<div class={ "flash", v.FlashKind }>{ v.FlashText }</div>
		}
		@Yukleniyor("ai-yukleniyor", "Yanıt bekleniyor…")
		<div style="display:grid;grid-template-columns:240px 1fr;gap:14px;align-items:start">
			<div class="card card-pad">
				<a class="btn small" style="width:100%;justify-content:center" href="/admin/ai-sohbet/yeni" hx-post="/admin/ai-sohbet/yeni" hx-target="#ai-sohbet-panel" hx-swap="outerHTML" hx-indicator="#ai-yukleniyor">＋ Yeni Sohbet</a>
				<div style="margin-top:10px">
					if len(v.Convs) == 0 {
						<p class="muted small">Henüz sohbet yok.</p>
					}
					for _, c := range v.Convs {
						<a href={ templ.SafeURL("/admin/ai-sohbet?konu=" + c.ID) } hx-get={ "/admin/ai-sohbet?konu=" + c.ID } hx-target="#ai-sohbet-panel" hx-swap="outerHTML" hx-indicator="#ai-yukleniyor" style={ convStyle(c.Active) }>{ c.Title }</a>
					}
				</div>
			</div>
			<div class="card card-pad" style="display:flex;flex-direction:column;min-height:520px">
				<div id="ai-msgs" style="flex:1;overflow:auto;padding:4px">@AISohbetMsgs(v.Msgs)</div>
				<div style="display:flex;gap:6px;flex-wrap:wrap;border-top:1px solid var(--border);padding-top:10px;margin-top:10px">
					for _, t := range v.Templates {
						<button class="btn ghost small" data-tpl={ t.Prompt }>{ t.Icon } { t.Title }</button>
					}
				</div>
				<form id="ai-form" style="display:flex;gap:8px;margin-top:10px" data-conv={ v.ActiveID } hx-post={ "/admin/ai-sohbet/" + v.ActiveID + "/mesaj" } hx-target="#ai-msgs" hx-swap="innerHTML" hx-indicator="#ai-yukleniyor" hx-on::after-request="var i=document.getElementById('ai-input'); if(i)i.value=''; var m=document.getElementById('ai-msgs'); if(m)m.scrollTop=m.scrollHeight;">
					<textarea id="ai-input" name="metin" class="textarea" style="min-height:56px;flex:1" placeholder="AI editör asistanına yaz… (Enter = gönder, Shift+Enter = yeni satır)" aria-label="AI editör asistanına yaz… (Enter = gönder, Shift+Enter = yeni satır)"></textarea>
					<button class="btn" type="submit" id="ai-send">Gönder</button>
				</form>
				<div id="ai-status" class="small muted" style="min-height:1.2em"></div>
			</div>
		</div>
	</div>
}

// convStyle aktif sohbet vurgusu.
func convStyle(active bool) string {
	base := "display:block;padding:8px;border-radius:6px;margin-bottom:4px;"
	if active {
		return base + "background:var(--accent);color:#fff"
	}
	return base + "background:var(--surface-2)"
}

// AISohbetMsgs mesaj listesi parçası (HTMX hedefi: #ai-msgs).
templ AISohbetMsgs(msgs []AISohbetMesaj) {
	for _, m := range msgs {
		<div style="margin:10px 0;max-width:85%">
			<div class="small muted">
				if m.Role == "user" {
					Siz
				} else {
					AI
				}
			</div>
			<div style={ msgStyle(m.Role) }>{ m.Content }</div>
		</div>
	}
}

// msgStyle mesaj balonu stili.
func msgStyle(role string) string {
	base := "white-space:pre-wrap;padding:9px 12px;border-radius:10px;margin-top:3px;"
	if role == "user" {
		return base + "background:var(--accent);color:#fff"
	}
	return base + "background:var(--surface-2)"
}
