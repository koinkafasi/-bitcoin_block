package templkit

// Abonelik sayfası (/abonelik) — CoinDesk kabuğu (12 Kasım 2026).
//
// Sayfa eskiden theblock kabuğunu (site_header/site_footer) basıyordu;
// üst çubuk, piyasa şeridi ve tipografi sitenin geri kalanından farklıydı.
//
// ÖDEME AKIŞI DEĞİŞMEDİ: katman listesi, fatura dönemi anahtarı, iyzico
// formu ve mesafeli satış onayları aynı. Değişen yalnız görünüm.

// CDAbonelikPlan tek katmanın görünümü.
type CDAbonelikPlan struct {
	Slug     string
	Ad       string
	Aciklama string
	Renk     string
	// Aylik/Yillik panelde girilen tutarlar (₺). Biçimlenmiş metin.
	Aylik  string
	Yillik string
	// YillikEtiket "yıllık" fiyatın altındaki küçük not (ör. "2 ay hediye").
	YillikEtiket string
	Perks        []string
	// Mevcut oturumdaki plan bu ise "Mevcut planınız" rozeti basılır.
	Mevcut bool
}

// CDAbonelikSayfa /abonelik ve /abonelik hata görünümü.
type CDAbonelikSayfa struct {
	Shell     CDShell
	Title     string
	Desc      string
	Canonical string
	JSONLD    string

	Planlar []CDAbonelikPlan
	// GirisYapildi ödeme formunun açılabilmesi için gerekli.
	GirisYapildi bool
	// GirisHref oturum yoksa CTA'nın gideceği adres.
	GirisHref string

	Hata  string
	Bilgi string
	// CheckoutHTML iyzico'nun gömülü ödeme formu (yalnız ödeme adımında).
	CheckoutHTML string
	// OdemeAdimi true ise plan kartları değil ödeme yuvası basılır.
	OdemeAdimi bool

	Locale          string
	BaseURL         string
	PageCategory    string
	ContentCategory string
}

// CDAbonelikSorular sık sorulan sorular. Hukuki metinler sözleşme
// sayfalarına bağlanır; burada özet var.
type CDAbonelikSoru struct {
	Soru    string
	Cevap   string
	Hukuki  bool
}

templ CDAbonelikSayfaView(v CDAbonelikSayfa) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", SiteName: v.Shell.SiteName, FaviconURL: v.Shell.FaviconURL,
				RSSFeed: "/rss.xml", JSONLD: v.JSONLD, Locale: v.Locale,
				PageCategory: v.PageCategory, ContentCategory: v.ContentCategory,
				BaseURL: v.BaseURL,
				EkCSS: []string{"/static/cd-abonelik.css"},
				EkJS:  []string{"/static/cd-abonelik.js"}})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap">
				if v.OdemeAdimi {
					<section class="cd-abn-odeme">
						<h1>Ödeme</h1>
						if v.Bilgi != "" {
							<p class="cd-card__spot">{ v.Bilgi }</p>
						}
						if v.Hata != "" {
							<div class="cd-abn-uyari" role="alert">{ v.Hata }</div>
						}
						<div class="cd-abn-odeme__yuva" id="iyzico-checkout">
							@templ.Raw(v.CheckoutHTML)
						</div>
						<p class="cd-abn-dipnot">
							Ödeme tamamlandığında aboneliğiniz otomatik etkinleşir.
							Sayfa kapanırsa <a href="/hesabim/abonelik">aboneliğim</a>
							sayfasından kontrol edebilirsiniz.
						</p>
					</section>
				} else {
					<header class="cd-abn-bas">
						<div>
							<h1>Abonelik Paketleri</h1>
							<p class="cd-card__spot">
								Katmanınıza göre ayrıcalıklı haberlere, analizlere ve
								reklamsız okuma deneyimine erişin.
							</p>
						</div>
						<div class="cd-abn-donem" role="group" aria-label="Fatura dönemi">
							<button type="button" class="cd-abn-donem__btn is-secili" data-cycle="monthly">
								Aylık
							</button>
							<button type="button" class="cd-abn-donem__btn" data-cycle="annual">
								Yıllık <span class="cd-abn-hediye">2 ay hediye</span>
							</button>
						</div>
					</header>

					if v.Hata != "" {
						<div class="cd-abn-uyari" role="alert">{ v.Hata }</div>
					}
					if v.Bilgi != "" {
						<div class="cd-abn-bilgi">{ v.Bilgi }</div>
					}

					if len(v.Planlar) == 0 {
						<div class="cd-bos">
							<p>Henüz tanımlı abonelik paketi yok.</p>
						</div>
					} else {
						<div class="cd-abn-izgara">
							for _, p := range v.Planlar {
								<article class={ "cd-abn-kart", templ.KV("is-mevcut", p.Mevcut) } style={ "--abn-renk:" + p.Renk }>
									if p.Mevcut {
										<span class="cd-abn-rozet">Mevcut planınız</span>
									}
									<h2 class="cd-abn-kart__ad">{ p.Ad }</h2>
									<p class="cd-abn-kart__aciklama">{ p.Aciklama }</p>
									<div class="cd-abn-fiyat">
										<span class="cd-abn-fiyat__aylik" data-monthly>
											{ p.Aylik }<small>/ay</small>
										</span>
										<span class="cd-abn-fiyat__yillik" data-annual hidden>
											{ p.Yillik }<small>/yıl</small>
										</span>
									</div>
									if p.YillikEtiket != "" {
										<span class="cd-abn-fiyat__not" data-annual hidden>{ p.YillikEtiket }</span>
									}
									if len(p.Perks) > 0 {
										<ul class="cd-abn-perks">
											for _, k := range p.Perks {
												<li>{ k }</li>
											}
										</ul>
									}
									if v.GirisYapildi {
										<button class="cd-btn cd-abn-cta" type="button"
											data-tier={ p.Slug } data-tier-name={ p.Ad }
											data-monthly={ p.Aylik } data-annual={ p.Yillik }
											disabled?={ p.Mevcut }>
											if p.Mevcut {
												Aktif plan
											} else {
												Bu paketi seç
											}
										</button>
									} else {
										<a class="cd-btn cd-abn-cta" href={ templ.SafeURL(v.GirisHref) }>
											Giriş yapıp abone ol
										</a>
									}
								</article>
							}
						</div>
					}

					@cdAbonelikSSS(v)

					if v.GirisYapildi {
						<form id="abonForm" method="post" action="/abonelik/odeme"
							class="cd-abn-modal" hidden aria-modal="true" role="dialog"
							aria-labelledby="abonFormTitle">
							<div class="cd-abn-modal__kart">
								<div class="cd-abn-modal__bas">
									<h2 id="abonFormTitle">Ödeme bilgileri</h2>
									<button type="button" class="cd-abn-modal__kapat"
										data-abon-close aria-label="Kapat">×</button>
								</div>
								<p class="cd-abn-ozet" id="abonSummary"></p>
								<input type="hidden" name="tier" id="abonTier"/>
								<input type="hidden" name="cycle" id="abonCycle" value="monthly"/>
								<label class="cd-abn-alan">
									TCKN (iyzico zorunlu tutar)
									<input name="tckn" inputmode="numeric" pattern="[0-9]{11}"
										maxlength="11" required/>
								</label>
								<label class="cd-abn-alan">
									Şehir
									<input name="city" value="İstanbul" required/>
								</label>
								<label class="cd-abn-alan">
									Adres
									<input name="address" placeholder="Fatura adresi" required/>
								</label>
								<label class="cd-abn-alan">
									İndirim kodu (varsa)
									<input name="kupon" placeholder="örn. YAZ2026" autocapitalize="characters"/>
								</label>
								<p class="cd-abn-dipnot">
									Devam ettiğinizde iyzico ödeme sayfasına yönlendirilirsiniz.
									Kart bilgisi bu sitede toplanmaz.
								</p>
								<label class="cd-abn-onay">
									<input type="checkbox" name="sozlesme_onay" value="1" required/>
									<span>
										<a href="/on-bilgilendirme-formu" target="_blank" rel="noopener">Ön Bilgilendirme Formu</a>'nu ve
										<a href="/mesafeli-satis-sozlesmesi" target="_blank" rel="noopener">Mesafeli Satış Sözleşmesi</a>'ni
										okudum, onaylıyorum.
									</span>
								</label>
								<p class="cd-abn-dipnot">
									Kişisel verilerinizin nasıl işlendiğini
									<a href="/kvkk" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a> ile
									<a href="/gizlilik-politikasi" target="_blank" rel="noopener">Gizlilik Politikası</a>'nda
									bulabilirsiniz.
								</p>
								<button class="cd-btn cd-abn-cta" type="submit">Ödemeye geç</button>
							</div>
						</form>
					}
				}
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}

// cdAbonelikSSS sık sorulan sorular. Sözleşme metinleri ayrı sayfalarda;
// burada yalnız özet ve bağlantı var.
templ cdAbonelikSSS(v CDAbonelikSayfa) {
	<section class="cd-abn-sss">
		<h2>Sık sorulan sorular</h2>
		<details>
			<summary>Kart bilgilerim sitede saklanıyor mu?</summary>
			<p>Hayır. Ödeme iyzico'nun güvenli ödeme sayfasında alınır; kart bilgisi sitemize girmez.</p>
		</details>
		<details>
			<summary>Aboneliğim ne zaman başlar?</summary>
			<p>Ödeme onaylandığı anda katmanınız etkinleşir ve hesabınızdan görüntülenebilir.</p>
		</details>
		<details>
			<summary>Yıllık planda avantaj var mı?</summary>
			<p>Yıllık ödemede 2 ay hediye: 12 ay yerine 10 aylık fiyat ödersiniz.</p>
		</details>
		<details>
			<summary>Aboneliğimi iptal edebilir miyim?</summary>
			<p>Dönem sonuna kadar erişiminiz devam eder; iptal talebi için hesabınızdan destek ile iletişime geçebilirsiniz.</p>
		</details>
		<details>
			<summary>Cayma hakkım var mı?</summary>
			<p>
				Mesafeli satış mevzuatı gereği kural olarak 14 gün içinde cayma hakkınızı
				kullanabilirsiniz. Dijital içerik ve elektronik ortamda anında ifa edilen
				hizmetlerde mevzuattaki istisnalar geçerli olabilir; hangi hâlde ne olduğu
				<a href="/mesafeli-satis-sozlesmesi">Mesafeli Satış Sözleşmesi</a> ve
				<a href="/on-bilgilendirme-formu">Ön Bilgilendirme Formu</a>'nda yazılıdır.
				İptal ve iade talepleri de bu belgelere göre değerlendirilir.
			</p>
		</details>
		<details>
			<summary>Faturamı alabilir miyim?</summary>
			<p>Ödeme sonrası e-arşiv fatura talep edebilirsiniz; fatura düzenlenmesi için hesabınızdaki e-posta ve TCKN kullanılır.</p>
		</details>
	</section>
}
