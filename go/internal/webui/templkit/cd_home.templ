package templkit

// CoinDesk ana sayfa şablonu — modül sırası spec §6 ile BİREBİR.
//
// Sapma yok: her modül aynı sırada, aynı görsel dilde. Veri yoksa modül
// basılmaz (boş kutu göstermek tasarımı bozuk gösterir) ama sıra korunur.
//
// 8. tur: hero üç kolonu CoinDesk'in GERÇEK modül listesiyle doldu —
// sol: Son Haberler · Düşünce Liderliği · tek görselli manşet;
// orta: manşet · 8 görselli akış · Basın Bültenleri slider;
// sağ: Bugünün Videoları · Öne Çıkan Araştırma · Bugünün Klipleri.

// cdRayOk modül başlığındaki ok — CoinDesk'in 16×16 SVG chevron'u
// (`M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6-6-6z`). Eski sürüm
// "→" KARAKTERİ basıyordu: metin fontundan geldiği için 13×21 kutuya
// düşüyor, dikeyde ortalanmıyor ve ekran okuyucuya "sağ ok" okutuyordu.
templ cdRayOk() {
	<svg class="cd-ray__ok" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
		viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
		<path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6-6-6z" fill="currentColor"></path>
	</svg>
}

// cdCard kapak görselli haber kartı (CoinDesk kart deseni).
//
// lead YALNIZ görünüm içindir (cd-card--lead sınıfı); görselin genişliği
// yuvadan gelir. İkisi ayrı: ölçüm gösterdi ki aynı sayfadaki "lead"
// kartlar farklı genişliklerde (hero 1094, bölüm hücresi 334) — boolean
// genişliği belirlemiyor.

// cdHeroSolRay sol ray — CoinDesk "Son Haberler" modülü (ölçüldü 290×575).
//
// Anatomi (birebir): başlık bağlantısı 14/21 w500 `padding-bottom: 16px`,
// ardından beş satır: başlık 16/24 w500 (3 satırla sınırlı) + saat 12/18
// w400 sönük. Görsel YOK — ölçümde bu modülde hiç görsel yok.
//
// ÇİZGİ YOK: sol kolonun İLK modülü. Ölçüm (CoinDesk /tr, 7 Kasım 2026):
// sol kolonun ilk öğesi "Son Haberler" `bt=0px`, altındaki Düşünce
// Liderliği `bt=1px`. Bu modül `cd-ray--cizgili` kullandığı için sayfanın
// en üstünde, sol ray genişliğinde TEK BAŞINA duran bir çizgi oluşuyordu.
templ cdHeroSolRay(items []CDStory) {
	if len(items) > 0 {
		<section class="cd-ray">
			<a class="cd-ray__bas" href="/latest-crypto-news">
				Son Haberler
				@cdRayOk()
			</a>
			<ul class="cd-ray__liste">
				for _, s := range items {
					<li class="cd-ray__satir">
						<a class="cd-ray__baslik" href={ s.Href }>{ s.Title }</a>
						if s.Time != "" {
							<time class="cd-ray__saat">{ s.Time }</time>
						}
					</li>
				}
			</ul>
		</section>
	}
}

// cdDusunceModul "Düşünce Liderliği" — sponsorlu içerik kartı.
//
// Ölçüldü (coindesk.com, 6 Kasım 2026): sol kolonda 290×306;
// başlık 14/21 w500 + 16 px ok, görsel 290×163, başlık 20/26 w500,
// sponsor satırı 12/18 w400 yeşil.
templ cdDusunceModul(d CDDusunce) {
	<section class="cd-ray cd-ray--cizgili cd-dusunce">
		<a class="cd-ray__bas" href="/sponsored-content">
			Düşünce Liderliği
			@cdRayOk()
		</a>
		<article class="cd-dusunce__kart">
			if d.Image != "" {
				<a class="cd-dusunce__gorsel" href={ d.Href } tabindex="-1" aria-hidden="true">
					<img src={ d.Image } alt="" loading="lazy" decoding="async"
						referrerpolicy="no-referrer"/>
				</a>
			}
			<a class="cd-dusunce__baslik" href={ d.Href }>{ d.Baslik }</a>
			if d.Sponsor != "" {
				<span class="cd-dusunce__sponsor">Sponsor { d.Sponsor }</span>
			}
		</article>
	</section>
}

// cdTekGorsel sol rayın altındaki tek görselli manşet.
//
// CoinDesk bu yuvada canlı blog kartı basıyor (görsel + LIVE + başlık).
// Bizde canlı blog yok; aynı geometri görselli haberle doluyor.
templ cdTekGorsel(s CDStory) {
	if s.Href != "" {
		<section class="cd-ray cd-ray--cizgili cd-tekgorsel">
			<a class="cd-tekgorsel__gorsel" href={ s.Href } tabindex="-1" aria-hidden="true">
				if cdKgOlcekli(s.Image) {
					<img src={ cdKgSrc(s.Image, YuvaHeroYan) } srcset={ cdKgSrcset(s.Image, YuvaHeroYan) }
						sizes={ cdKgSizes(YuvaHeroYan) } alt="" loading="lazy" decoding="async"
						referrerpolicy="no-referrer"/>
				} else {
					<img src={ s.Image } alt="" loading="lazy" decoding="async"
						referrerpolicy="no-referrer"/>
				}
			</a>
			<div class="cd-tekgorsel__kart">
				<a class="cd-tekgorsel__baslik" href={ s.Href }>{ s.Title }</a>
				if s.Time != "" {
					<time class="cd-ray__saat">{ s.Time }</time>
				}
			</div>
		</section>
	}
}

// cdHeroLead manşet kartı — CoinDesk ölçümü: metin ÜSTTE, görsel ALTTA.
//
// Ayrı bileşen, çünkü sıra genel karttan farklı: yan kartlarda görsel
// üstte (290×163 görsel + 290×81 metin), manşette altta (608×237 metin +
// 608×342 görsel). Tek `cdCard` içinde `lead` bayrağıyla dallandırmak
// iki farklı DOM sırası üretiyordu; burada niyet adıyla yazılı.
//
// KICKER YOK (kullanıcı isteği, 7 Kasım 2026): manşetin üstünde kategori
// etiketi ("POLİTİKA" vb.) basılmıyor. Kartlarda (cdCardBody) kicker
// KALIYOR — kaldırma yalnız hero manşete ait.
templ cdHeroLead(s CDStory) {
	<article class="cd-hero-lead">
		<div class="cd-hero-lead__metin">
			<h2 class="cd-hero-lead__baslik"><a href={ s.Href }>{ s.Title }</a></h2>
			if s.Spot != "" {
				<p class="cd-card__spot">{ s.Spot }</p>
			}
			@cdMeta(s)
		</div>
		@cdCardGorsel(s, YuvaHeroLead)
	</article>
}

// cdAkis manşetin altındaki 8 görselli haber listesi.
//
// Ölçüldü: satır 608×119; solda 152×86 görsel, sağda 20/26 w500 başlık
// (en çok 3 satır) + 12/18 saat. Satır aralarında 1 px ayırıcı.
templ cdAkis(items []CDStory) {
	if len(items) > 0 {
		<div class="cd-akis">
			for _, s := range items {
				<article class="cd-akis__satir">
					<a class="cd-akis__gorsel" href={ s.Href } tabindex="-1" aria-hidden="true">
						if cdKgOlcekli(s.Image) {
							<img src={ cdKgSrc(s.Image, YuvaAkis) } srcset={ cdKgSrcset(s.Image, YuvaAkis) }
								sizes={ cdKgSizes(YuvaAkis) } alt="" loading="lazy" fetchpriority="low"
								decoding="async" referrerpolicy="no-referrer"/>
						} else {
							<img src={ s.Image } alt="" loading="lazy" decoding="async"
								referrerpolicy="no-referrer"/>
						}
					</a>
					<div class="cd-akis__metin">
						<a class="cd-akis__baslik" href={ s.Href }>{ s.Title }</a>
						if s.Time != "" {
							<time class="cd-akis__saat">{ s.Time }</time>
						}
					</div>
				</article>
			}
		</div>
	}
}

// cdBasinSlider "Basın Bültenleri" — JS'siz slider (radio + label).
//
// CoinDesk: modül etiketi 14/21 w500, slayt başlığı 20/26 w500,
// "SPONSORED BY …" 12/18 yeşil büyük harf, altta ‹ • • • › gezinme.
// Radyo düğmeleri klavyeyle de çalışır (ok tuşları); JS gerekmez.
templ cdBasinSlider(items []CDBasin) {
	if len(items) > 0 {
		<section class="cd-basin">
			<p class="cd-basin__etiket">Basın Bültenleri</p>
			<div class="cd-basin__kutu">
				for i := range items {
					if i == 0 {
						<input class="cd-basin__durum" type="radio" name="cd-basin"
							id={ "cd-basin-" + cdSiraya(i) } checked
							aria-label={ "Basın bülteni " + cdSiraya(i) }/>
					} else {
						<input class="cd-basin__durum" type="radio" name="cd-basin"
							id={ "cd-basin-" + cdSiraya(i) }
							aria-label={ "Basın bülteni " + cdSiraya(i) }/>
					}
				}
				<div class="cd-basin__slaytlar">
					for _, b := range items {
						<article class="cd-basin__slayt">
							<a class="cd-basin__baslik" href={ b.Href }>{ b.Baslik }</a>
							if b.Sponsor != "" {
								<span class="cd-basin__sponsor">Sponsor { b.Sponsor }</span>
							}
						</article>
					}
				</div>
				<div class="cd-basin__nav">
					for i := range items {
						<label class={ "cd-basin__ok cd-basin__ok--geri cd-basin__durum-" + cdSiraya(i) }
							for={ "cd-basin-" + cdSiraya(cdBasinGeri(i, len(items))) }>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
								viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
								<path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z"></path>
							</svg>
							<span class="cd-visually-hidden">Önceki bülten</span>
						</label>
					}
					<div class="cd-basin__noktalar">
						for i := range items {
							<label class={ "cd-basin__nokta cd-basin__nokta-" + cdSiraya(i) }
								for={ "cd-basin-" + cdSiraya(i) }>
								<span class="cd-visually-hidden">{ "Bülten " + cdSiraya(i) }</span>
							</label>
						}
					</div>
					for i := range items {
						<label class={ "cd-basin__ok cd-basin__ileri cd-basin__durum-" + cdSiraya(i) }
							for={ "cd-basin-" + cdSiraya(cdBasinIleri(i, len(items))) }>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
								viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
								<path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
							</svg>
							<span class="cd-visually-hidden">Sonraki bülten</span>
						</label>
					}
				</div>
			</div>
			<div class="cd-basin__cizgi"></div>
		</section>
	}
}

// cdVideoModul "Bugünün Videoları" — kapak + başlık, JS'siz karusel.
//
// CoinDesk'te oynatıcı var; bizde video altyapısı yok. Kart kaynağa
// gider (geçici CoinDesk linki), kaynak etiketi görünür kalır.
templ cdVideoModul(items []CDVideo) {
	if len(items) > 0 {
		<section class="cd-ray cd-video">
			<h2 class="cd-ray__duz">Bugünün Videoları</h2>
			<!-- Radyo düğmeleri TEK VİDEODA DA basılır: slayt görünürlüğü
			     yalnız `#cd-video-N:checked` kuralından geliyor. Kural
			     `len(items) > 1` iken basıldığında, tek video girdisinde
			     hiçbir slayt görünmüyor ve modül 360 px yerine 94 px'e
			     çöküyordu (gerçek veriyle ölçüldü, 7 Kasım 2026). -->
			for i := range items {
				if i == 0 {
					<input class="cd-basin__durum" type="radio" name="cd-video"
						id={ "cd-video-" + cdSiraya(i) } checked
						aria-label={ "Video " + cdSiraya(i) }/>
				} else {
					<input class="cd-basin__durum" type="radio" name="cd-video"
						id={ "cd-video-" + cdSiraya(i) }
						aria-label={ "Video " + cdSiraya(i) }/>
				}
			}
			<div class="cd-video__kutu">
				<div class="cd-video__slaytlar">
					for _, v := range items {
						<article class="cd-video__slayt">
							<a class="cd-video__gorsel" href={ v.Href } tabindex="-1" aria-hidden="true">
								<img src={ v.Image } alt="" loading="lazy" decoding="async"
									referrerpolicy="no-referrer"/>
								if v.Sure != "" {
									<span class="cd-video__sure">{ v.Sure }</span>
								}
							</a>
							<div class="cd-video__metin">
								if v.Etiket != "" {
									<span class="cd-video__etiket">{ v.Etiket }</span>
								}
								<a class="cd-video__baslik" href={ v.Href }>{ v.Baslik }</a>
							</div>
						</article>
					}
				</div>
			</div>
			<div class="cd-video__alt">
				if len(items) > 1 {
					<div class="cd-video__oklar">
						for i := range items {
							<label class={ "cd-video__ok cd-video__ok--geri cd-video__durum-" + cdSiraya(i) }
								for={ "cd-video-" + cdSiraya(cdBasinGeri(i, len(items))) }>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
									viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
									<path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z"></path>
								</svg>
								<span class="cd-visually-hidden">Önceki video</span>
							</label>
						}
						for i := range items {
							<label class={ "cd-video__ok cd-video__ok--ileri cd-video__durum-" + cdSiraya(i) }
								for={ "cd-video-" + cdSiraya(cdBasinIleri(i, len(items))) }>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
									viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
									<path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
								</svg>
								<span class="cd-visually-hidden">Sonraki video</span>
							</label>
						}
					</div>
				}
				<a class="cd-btn cd-btn--ghost" href="/videos">Daha Fazlasını Keşfet</a>
			</div>
		</section>
	}
}

// cdArastirmaModul "Öne Çıkan Araştırma" — metrik kartı, JS'siz slayt.
//
// Ölçüldü (CoinDesk /tr, 7 Kasım 2026): kart 290×386; dev metrik sarı
// bantlı, altında sarı zeminli birim, açıklama 16/23 w500, ayırıcı,
// rapor adı (serif 16/22) ve 11/16 etiket çipleri.
//
// NAVİGASYON: modülün altında İKİ OK solda + "Daha Fazlasını Keşfet"
// sağda (`justify-content: space-between`). Bu yüzden modül SLAYTILI:
// tek kartla oklar işlevsiz kalırdı ve Bugünün Videoları'nın navigasyonuyla
// hizası tutmazdı (kullanıcı bildirdi).
templ cdArastirmaModul(items []CDArastirma) {
	if len(items) > 0 {
		<section class="cd-ray cd-ray--cizgili cd-arastirma">
			<h2 class="cd-ray__duz">Öne Çıkan Araştırma</h2>
			<!-- Tek kartta da radyo basılır — gerekçe cdVideoModul'de. -->
			for i := range items {
				if i == 0 {
					<input class="cd-basin__durum" type="radio" name="cd-arastirma"
						id={ "cd-arastirma-" + cdSiraya(i) } checked
						aria-label={ "Araştırma " + cdSiraya(i) }/>
				} else {
					<input class="cd-basin__durum" type="radio" name="cd-arastirma"
						id={ "cd-arastirma-" + cdSiraya(i) }
						aria-label={ "Araştırma " + cdSiraya(i) }/>
				}
			}
			<div class="cd-arastirma__slaytlar">
				for _, a := range items {
					<div class="cd-arastirma__kart">
						<div class="cd-arastirma__ust">
							if a.Metrik != "" || a.Baslik != "" {
								<div class="cd-arastirma__metrik-kap">
									<span class="cd-arastirma__metrik">
										if a.Metrik != "" {
											<span class="cd-arastirma__metrik-sayi">{ a.Metrik }</span>
										}
										if a.Baslik != "" {
											<span class="cd-arastirma__metrik-birim">{ a.Baslik }</span>
										}
									</span>
								</div>
							}
							if a.Aciklama != "" {
								<p class="cd-arastirma__aciklama">{ a.Aciklama }</p>
							}
						</div>
						if a.Rapor != "" {
							<a class="cd-arastirma__rapor" href={ a.Href }>{ a.Rapor }</a>
						}
						if len(a.Etiketler) > 0 {
							<ul class="cd-arastirma__etiketler">
								for _, e := range a.Etiketler {
									<li>{ e }</li>
								}
							</ul>
						}
					</div>
				}
			</div>
			<div class="cd-video__alt">
				if len(items) > 1 {
					<div class="cd-video__oklar">
						for i := range items {
							<label class={ "cd-video__ok cd-video__ok--geri cd-arastirma__durum-" + cdSiraya(i) }
								for={ "cd-arastirma-" + cdSiraya(cdBasinGeri(i, len(items))) }>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
									viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
									<path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z"></path>
								</svg>
								<span class="cd-visually-hidden">Önceki araştırma</span>
							</label>
						}
						for i := range items {
							<label class={ "cd-video__ok cd-video__ok--ileri cd-arastirma__durum-" + cdSiraya(i) }
								for={ "cd-arastirma-" + cdSiraya(cdBasinIleri(i, len(items))) }>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
									viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
									<path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
								</svg>
								<span class="cd-visually-hidden">Sonraki araştırma</span>
							</label>
						}
					</div>
				}
				<a class="cd-btn cd-btn--ghost" href="/research">Daha Fazlasını Keşfet</a>
			</div>
		</section>
	}
}

// cdKlipler "Bugünün Klipleri" — TEK 9:16 kart + dikey (yukarı/aşağı) slider.
//
// ÖLÇÜLDÜ (coindesk.com, 1920 px, 7 Kasım 2026):
//   • section 290×566: `gap 12` + 1 px üst çizgi + 16 px üst dolgu.
//   • başlık bağı "Today's Clips →" 107×21, 14/21 w500.
//   • kart 290×516 = 9/16, köşe 8, zemin #000.
//   • kartın SAĞ KENARINDA dikey iki ok (yukarı/aşağı), 24 px yuvarlak,
//     yarı saydam beyaz çerçeve; merkezde.
//   • başlık kartın ÜSTÜNDE beyaz overlay (siyah geçişli zemin).
//   • oynat düğmesi sol altta.
//
// ÖNCEKİ HATA: 3 klip ALT ALTA basılıyordu (modül 1621 px). CoinDesk tek
// kart gösteriyor; gezinme dikey oklarla. Slider yine JS'siz: radyo +
// label deseni (video/araştırma modülleriyle aynı).
templ cdKlipler(items []CDKlip) {
	if len(items) > 0 {
		<section class="cd-ray cd-ray--cizgili cd-klipler">
			<a class="cd-ray__bas" href="/videos">
				Bugünün Klipleri
				@cdRayOk()
			</a>
			<!-- Radyolar her durumda basılır: slayt görünürlüğü yalnız
			     `#cd-klip-N:checked` kuralından gelir. -->
			for i := range items {
				if i == 0 {
					<input class="cd-basin__durum" type="radio" name="cd-klip"
						id={ "cd-klip-" + cdSiraya(i) } checked
						aria-label={ "Klip " + cdSiraya(i) }/>
				} else {
					<input class="cd-basin__durum" type="radio" name="cd-klip"
						id={ "cd-klip-" + cdSiraya(i) }
						aria-label={ "Klip " + cdSiraya(i) }/>
				}
			}
			<div class="cd-klip__kutu">
				<div class="cd-klip__slaytlar">
					for _, k := range items {
						<a class="cd-klip" href={ k.Href }>
							if k.Image != "" {
								<img src={ k.Image } alt="" loading="lazy" decoding="async"
									referrerpolicy="no-referrer"/>
							}
							if k.Baslik != "" {
								<span class="cd-klip__ust">{ k.Baslik }</span>
							}
							<span class="cd-klip__oynat" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
									<path d="M8 5v14l11-7z"></path>
								</svg>
							</span>
						</a>
					}
				</div>
				if len(items) > 1 {
					<!-- Dikey oklar kartın sağ kenarında: yukarı = önceki,
					     aşağı = sonraki (CoinDesk dikey slider yönü). -->
					<div class="cd-klip__oklar">
						for i := range items {
							<label class={ "cd-klip__ok cd-klip__durum-" + cdSiraya(i) }
								for={ "cd-klip-" + cdSiraya(cdBasinGeri(i, len(items))) }>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
									viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
									<path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6 1.41 1.41z"></path>
								</svg>
								<span class="cd-visually-hidden">Önceki klip</span>
							</label>
						}
						for i := range items {
							<label class={ "cd-klip__ok cd-klip__durum-" + cdSiraya(i) }
								for={ "cd-klip-" + cdSiraya(cdBasinIleri(i, len(items))) }>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
									viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
									<path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"></path>
								</svg>
								<span class="cd-visually-hidden">Sonraki klip</span>
							</label>
						}
					</div>
				}
			</div>
		</section>
	}
}

// cdCard görsel kart. Manşet için cdHeroLead kullanılır.
templ cdCard(s CDStory, lead bool, yuva CDYuva) {
	if lead {
		<article class="cd-card cd-card--lead">
			@cdCardBody(s, yuva)
		</article>
	} else {
		<article class="cd-card">
			@cdCardBody(s, yuva)
		</article>
	}
}

// cdCardGorsel yalnız görseli basar (manşette metinden sonra gelir).
templ cdCardGorsel(s CDStory, yuva CDYuva) {
	if s.Image != "" {
		<a class="cd-card__media" href={ s.Href } tabindex="-1" aria-hidden="true">
			if cdKgOlcekli(s.Image) {
				<img src={ cdKgSrc(s.Image, yuva) } srcset={ cdKgSrcset(s.Image, yuva) }
					sizes={ cdKgSizes(yuva) } alt="" loading="eager" fetchpriority="high"
					decoding="async" referrerpolicy="no-referrer"/>
			} else {
				<img src={ s.Image } alt="" loading="eager" fetchpriority="high"
					decoding="async" referrerpolicy="no-referrer"/>
			}
		</a>
	}
}

templ cdCardBody(s CDStory, yuva CDYuva) {
	if s.Image != "" {
		<a class="cd-card__media" href={ s.Href } tabindex="-1" aria-hidden="true">
			<!-- İki dal: templ'in koşullu öznitelik sözdizimi sürümden
			     sürüme değişiyor (bkz. cd_shell.templ notu). Kaynak görseli
			     ölçeklenebiliyorsa srcset/sizes basılır, değilse adres
			     olduğu gibi kalır (dış adres, /media/... vb.). -->
			if cdKgOlcekli(s.Image) {
				<img src={ cdKgSrc(s.Image, yuva) } srcset={ cdKgSrcset(s.Image, yuva) }
					sizes={ cdKgSizes(yuva) } alt="" loading="lazy" decoding="async"
					referrerpolicy="no-referrer"/>
			} else {
				<img src={ s.Image } alt="" loading="lazy" decoding="async"
					referrerpolicy="no-referrer"/>
			}
		</a>
	}
	if s.Kicker != "" {
		<span class="cd-kicker">{ s.Kicker }</span>
	}
	<h3 class="cd-card__title"><a href={ s.Href }>{ s.Title }</a></h3>
	if s.Spot != "" {
		<p class="cd-card__spot">{ s.Spot }</p>
	}
	@cdMeta(s)
}

templ cdMeta(s CDStory) {
	<div class="cd-card__meta">
		if s.Time != "" {
			<span>{ s.Time }</span>
		}
		if s.Source != "" {
			if s.Time != "" {
				<span> · </span>
			}
			if s.SourceURL != "" {
				<a href={ s.SourceURL } rel="nofollow noopener" target="_blank">{ s.Source }</a>
			} else {
				<span>{ s.Source }</span>
			}
		}
	</div>
}

// cdBloklar §22 bölüm blokları — CoinDesk'in 2×2 ızgarası.
//
// ÖLÇÜLDÜ (coindesk.com/tr, 6 Kasım 2026): alt bölüm tek bir ızgara,
// 724 + 724 px, gap 16. Her hücre KENDİ `border-top` çizgisini taşıyor
// (1 px #a6a6a6) ve `padding: 20px 20px 0`. Önceki sürüm kategori başına
// tam genişlik 923/461 modül basıyordu — CoinDesk'te böyle bir düzen YOK.
templ cdBloklar(sections []CDSection) {
	if len(sections) > 0 {
		<section class="cd-bloklar">
			for _, sec := range sections {
				if sec.Lead.Href != "" {
					@cdBlokHucre(sec)
				}
			}
		</section>
	}
}

// cdBlokHucre tek bölüm hücresi: başlık bağlantısı + [görselli kart | 3 satır].
//
// Anatomi (birebir): başlık 14/21 w500 + 16 px ok (gap 4), iç ızgara
// 334+334 gap 16; solda görsel 16/9 + başlık 24/30 w500 + saat 14/21,
// sağda üç satır: başlık 18/26 w500 + saat 14/21, aralarında 1 px çizgi
// ve iki yanında 16 px boşluk.
templ cdBlokHucre(sec CDSection) {
	<section class="cd-blok">
		<a class="cd-blok__bas" href={ sec.Href }>
			{ sec.Title }
			<svg class="cd-blok__ok" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M6 3.5 10.5 8 6 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</a>
		<div class="cd-blok__ic">
			<article class="cd-blok__kart">
				if sec.Lead.Image != "" {
					<a class="cd-blok__gorsel" href={ sec.Lead.Href } tabindex="-1" aria-hidden="true">
						if cdKgOlcekli(sec.Lead.Image) {
							<img src={ cdKgSrc(sec.Lead.Image, YuvaBlokLead) } srcset={ cdKgSrcset(sec.Lead.Image, YuvaBlokLead) }
								sizes={ cdKgSizes(YuvaBlokLead) } alt="" loading="lazy" fetchpriority="low"
								decoding="async" referrerpolicy="no-referrer"/>
						} else {
							<img src={ sec.Lead.Image } alt="" loading="lazy" decoding="async"
								referrerpolicy="no-referrer"/>
						}
					</a>
				}
				<a class="cd-blok__manset" href={ sec.Lead.Href }>{ sec.Lead.Title }</a>
				if sec.Lead.Time != "" {
					<time class="cd-blok__zaman">{ sec.Lead.Time }</time>
				}
			</article>
			<div class="cd-blok__liste">
				for i, s := range sec.Rows {
					<div class="cd-blok__satir">
						if i > 0 {
							<div class="cd-blok__ayirici" aria-hidden="true"></div>
						}
						<a class="cd-blok__baslik" href={ s.Href }>{ s.Title }</a>
						if s.Time != "" {
							<div class="cd-blok__meta">
								<time>{ s.Time }</time>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</section>
}

// cdIkili §20 + §21: Görüş (25%) ve En Çok Okunan (75%) YAN YANA.
//
// CoinDesk ana sayfasında bu iki modül ayrı tam genişlik bloklar değil;
// tek satırın iki paneli (ölçüldü: 366 + 1074, gap 24). Her panelin
// `border-top` çizgisi kendi genişliğinde kalıyor — bu yüzden sarmalayıcı
// değil paneller çizgi taşıyor.
// cdIkili §20 + §21: Görüş (25%) ve En Çok Okunan (75%) YAN YANA.
//
// CoinDesk ana sayfasında bu iki modül ayrı tam genişlik bloklar değil;
// tek satırın iki paneli (ölçüldü: 366 + 1074, gap 24). Her panelin
// `border-top` çizgisi kendi genişliğinde kalıyor — bu yüzden sarmalayıcı
// değil paneller çizgi taşıyor.
//
// SARMAYICI `cd-mod--cizgisiz` OLMAK ZORUNDA: ölçüm (CoinDesk /tr,
// 7 Kasım 2026) bu satırda İKİ çizgi gösterdi, her biri kendi panelinin
// genişliğinde (Görüş 366 px, En Çok Okunan 1074 px, aralarında 24 px
// boşluk). Panellerin kendi 1 px çizgisine ek olarak `.cd-mod` sarmalayıcısı
// TAM GENİŞLİKTE (1464) üçüncü bir çizgi basıyordu; Görüş'ün üstünde tek
// parça uzun bir çizgi görünüyordu.
templ cdIkili(yorum []CDUzman, enCok []CDStory) {
	if len(yorum) > 0 || len(enCok) > 0 {
		<section class="cd-mod cd-mod--cizgisiz">
			<div class="cd-ikili">
				if len(yorum) > 0 {
					<div class="cd-ikili__sol">
						@cdOpinion(yorum)
					</div>
				}
				if len(enCok) > 0 {
					<div class="cd-ikili__sag">
						@cdMostRead(enCok)
					</div>
				}
			</div>
		</section>
	}
}

// cdMostRead §21 — manşet 5fr + iki sütun küçük kart 7fr (ölçüldü).
//
// ÖLÇÜM (CoinDesk /tr, 7 Kasım 2026): sol manşet GÖRSELLİ (428×240) ve
// spot'lu (16/24, 4 satır kırpma); sağdaki yedi küçük kart GÖRSELSİZ ve
// SPOTSUZ — yalnız başlık 20/26 w500 + saat 14/21, kart içi aralık 8 px.
// Önceki sürüm küçük kartlarda da görsel + spot basıyordu; modül 1191 px
// çıkıyordu, CoinDesk'te 561 px.
templ cdMostRead(items []CDStory) {
	if len(items) > 0 {
		<section class="cd-panel">
			<h2>En Çok Okunan</h2>
			<div class="cd-most">
				<div class="cd-most__kart">
					@cdCard(items[0], false, YuvaEnCokOkunan)
				</div>
				if len(items) > 1 {
					<ul class="cd-most__liste">
						for _, s := range items[1:] {
							<li class="cd-most__oge">
								<a class="cd-most__baslik" href={ s.Href }>{ s.Title }</a>
								if s.Time != "" {
									<time class="cd-most__saat">{ s.Time }</time>
								}
							</li>
						}
					</ul>
				}
			</div>
		</section>
	}
}

// cdOpinion §20 — uzman profili: ad 12/18, makale başlığı 18/26, avatar 48.
//
// CoinDesk'te satırda yalnız ad + başlık görünür; unvan profil
// sayfasında kalır. Avatar yoksa satır basılmaz (repo katmanı süzer).
templ cdOpinion(items []CDUzman) {
	if len(items) > 0 {
		<section class="cd-panel">
			<h2>Görüş</h2>
			<div class="cd-opinion">
				for i, u := range items {
					if i == 0 {
						<div class="cd-opinion__satir">
							@cdUzmanMetin(u)
							@cdUzmanAvatar(u)
						</div>
					} else {
						<div class="cd-opinion__satir cd-opinion__satir--cizgili">
							@cdUzmanMetin(u)
							@cdUzmanAvatar(u)
						</div>
					}
				}
			</div>
		</section>
	}
}

templ cdUzmanMetin(u CDUzman) {
	<div class="cd-opinion__metin">
		if u.Ad != "" {
			<span class="cd-opinion__yazar">{ u.Ad }</span>
		}
		<a class="cd-opinion__baslik" href={ u.Href }>{ u.Makale }</a>
	</div>
}

templ cdUzmanAvatar(u CDUzman) {
	if u.Avatar != "" {
		<img class="cd-opinion__avatar" src={ u.Avatar } alt="" width="48" height="48"
			loading="lazy" decoding="async" referrerpolicy="no-referrer"/>
	}
}

templ CDHome(v CDHomeView) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", Image: v.Lead.Image, Hreflang: v.Hreflang,
				SiteName: v.Shell.SiteName, RSSFeed: "/rss.xml", JSONLD: v.JSONLD,
				Locale: v.Locale, PageCategory: v.PageCategory, BaseURL: v.BaseURL,
				ContentCategory: v.ContentCategory,
				LCPGorsel: cdLCPOnYukle(v.Lead)})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap cd-main">
				<!-- §8 manşet bloğu — CoinDesk hero'su ÜÇ kolon (spec §7A):
				     290 sol ray · 608 merkez · 290 sağ ray, kolon arası 80.
				     Sol: Son Haberler · Düşünce Liderliği · tek görselli manşet.
				     Orta: manşet · 8 görselli akış · Basın Bültenleri slider.
				     Sağ: Bugünün Videoları · Öne Çıkan Araştırma · Bugünün
				     Klipleri (1284 px altında tamamen gizli).
				     Hero ÇİZGİSİZ: CoinDesk'te ana içeriğin ilk modülü
				     `border-top: 0`, `padding: 32px 0` (ölçüldü). -->
				if v.Lead.Href != "" {
					<section class="cd-mod cd-mod--cizgisiz">
						<div class="cd-hero">
							<aside class="cd-hero__sol">
								@cdCanliModul(v.Canli)
								@cdHeroSolRay(v.RailLeft)
								if v.Dusunce != nil {
									@cdDusunceModul(*v.Dusunce)
								}
								if v.TekGorsel.Href != "" {
									@cdTekGorsel(v.TekGorsel)
								}
							</aside>
							<div class="cd-hero__orta">
								@cdHeroLead(v.Lead)
								@cdAkis(v.Akis)
								@cdBasinSlider(v.Basin)
							</div>
							<aside class="cd-hero__sag">
								@cdVideoModul(v.Videolar)
								@cdArastirmaModul(v.Arastirma)
								@cdKlipler(v.Klipler)
							</aside>
						</div>
					</section>
				}

				<!-- PİYASA NABZI: gerçek CryptoQuant verisi. Boşsa basılmaz. -->
				@cdNabizModul(v.NabizFiyat, v.Nabiz,
					"Kaynak: CryptoQuant · BTC · Binance akışları · günlük veri · 10 dakika önbellek")

				<!-- §20+§21 Görüş (25%) + En Çok Okunan (75%) yan yana -->
				@cdIkili(v.Opinion, v.MostRead)

				<!-- §22 bölüm blokları — tek 2×2 ızgara -->
				@cdBloklar(v.Sections)
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}

// cdNewsletter §7: e-posta kayıt modülü.
//
// CoinDesk düzeni: bölüm başlığı + tek satır açıklama + e-posta alanı +
// kayıt düğmesi + küçük koşul metni. Form, mevcut POST /bulten ucuna
// gönderilir (çift onay akışı hazır); JS gerekmez — çalışan HTML formu.
templ cdNewsletter() {
	<section class="cd-mod">
		<div class="cd-news">
			<div>
				<h2>Günlük bülten</h2>
				<p class="cd-card__spot">Günün en önemli kripto haberleri, her sabah e-postanızda. Ücretsiz.</p>
			</div>
			<form class="cd-news__form" method="post" action="/bulten">
				<label class="cd-visually-hidden" for="cd-news-email">E-posta adresiniz</label>
				<input class="cd-news__input" id="cd-news-email" type="email" name="email"
					required placeholder="ornek@eposta.com" autocomplete="email"/>
				<button class="cd-btn" type="submit">Abone ol</button>
			</form>
		</div>
		<p class="cd-news__not">
			Kayıt sonrası onay e-postası gönderilir. Adresiniz yalnız bülten için kullanılır;
			<a href="/gizlilik-politikasi">gizlilik politikası</a>.
		</p>
	</section>
}

// cdPriceTable §14/§15: sıra, sembol, fiyat, değişim.
templ cdPriceTable(baslik string, rows []CDPriceRow) {
	if len(rows) > 0 {
	<section class="cd-mod">
		<!-- Başlık boşsa `cdSectionHead` HİÇ çağrılmaz: coin sayfası kendi
		     başlığını basıyor; boş başlıkla ikinci bir "Tümü →" satırı
		     çıkıyordu (ölçüldü, 8 Kasım 2026). -->
		if baslik != "" {
			@cdSectionHead(baslik, "/price")
		}
		<table class="cd-table">
			<thead>
				<tr>
					<th>#</th>
					<th>Varlık</th>
					<th class="num">Fiyat</th>
					<th class="num">24s</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td>{ r.Rank }</td>
						<td>
							<a href={ r.Href }>
								<strong>{ r.Sym }</strong>
								<span class="cd-card__meta"> { r.Name }</span>
							</a>
						</td>
						<td class="num">{ r.Price }</td>
						<td class="num">
							if r.Up {
								<span class="cd-up">{ r.Change }</span>
							} else {
								<span class="cd-down">{ r.Change }</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
	}
}
