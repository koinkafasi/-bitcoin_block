package templkit

// CoinDesk ana sayfa şablonu — modül sırası spec §6 ile BİREBİR.
//
// Sapma yok: her modül aynı sırada, aynı görsel dilde. Veri yoksa modül
// basılmaz (boş kutu göstermek tasarımı bozuk gösterir) ama sıra korunur.

// cdCard kapak görselli haber kartı (CoinDesk kart deseni).
//
// lead YALNIZ görünüm içindir (cd-card--lead sınıfı); görselin genişliği
// yuvadan gelir. İkisi ayrı: ölçüm gösterdi ki aynı sayfadaki "lead"
// kartlar farklı genişliklerde (hero 1094, bölüm hücresi 334) — boolean
// genişliği belirlemiyor.

// cdHeroSolRay sol ray — CoinDesk "Son Haberler" modülü (ölçüldü 290×575).
//
// Anatomi (birebir): `border-top: 1px solid border-strong` + `padding-top: 16px`,
// başlık bağlantısı 14/21 w500 `padding-bottom: 16px`, ardından beş satır:
// başlık 16/24 w500 (3 satırla sınırlı) + saat 12/18 w400 sönük.
// Görsel YOK — ölçümde bu modülde hiç görsel yok.
templ cdHeroSolRay(items []CDStory) {
	if len(items) > 0 {
		<aside class="cd-hero__sol">
			<section class="cd-ray">
				<a class="cd-ray__bas" href="/latest-crypto-news">
					Son Haberler
					<span class="cd-ray__ok" aria-hidden="true">→</span>
				</a>
				<ul class="cd-ray__liste">
					for _, s := range items {
						<li class="cd-ray__satir">
							<a class="cd-ray__baslik" href={ s.Href }>{ s.Title }</a>
							if s.Time != "" {
								<time class="cd-ray__saat">{ s.Time }</time>
							}
						</li>
					}
				</ul>
			</section>
		</aside>
	}
}

// cdHeroSagRay sağ ray — CoinDesk'te üç modül yığılır (video · araştırma ·
// klipler). Bizde o içerik türleri yok; aynı yapıyı gerçek bölüm
// verisiyle dolduruyoruz: modül başına bir kart (görsel 16/9 + başlık
// 20/26 w500 + meta 12/18). 1284 px altında tamamen gizli (ölçüldü).
templ cdHeroSagRay(mods []CDRailModul) {
	if len(mods) > 0 {
		<aside class="cd-hero__sag">
			for _, m := range mods {
				<section class="cd-ray cd-ray--cizgili">
					<a class="cd-ray__bas" href={ m.Href }>
						{ m.Title }
						<span class="cd-ray__ok" aria-hidden="true">→</span>
					</a>
					@cdCard(m.Story, false, YuvaHeroYan)
				</section>
			}
		</aside>
	}
}

// cdHeroLead manşet kartı — CoinDesk ölçümü: metin ÜSTTE, görsel ALTTA.
//
// Ayrı bileşen, çünkü sıra genel karttan farklı: yan kartlarda görsel
// üstte (290×163 görsel + 290×81 metin), manşette altta (608×237 metin +
// 608×342 görsel). Tek `cdCard` içinde `lead` bayrağıyla dallandırmak
// iki farklı DOM sırası üretiyordu; burada niyet adıyla yazılı.
templ cdHeroLead(s CDStory) {
	<article class="cd-hero-lead">
		<div class="cd-hero-lead__metin">
			if s.Kicker != "" {
				<span class="cd-kicker">{ s.Kicker }</span>
			}
			<h2 class="cd-hero-lead__baslik"><a href={ s.Href }>{ s.Title }</a></h2>
			if s.Spot != "" {
				<p class="cd-card__spot">{ s.Spot }</p>
			}
			@cdMeta(s)
		</div>
		@cdCardGorsel(s, YuvaHeroLead)
	</article>
}

// cdCard görsel kart. Manşet için cdHeroLead kullanılır.
templ cdCard(s CDStory, lead bool, yuva CDYuva) {
	if lead {
		<article class="cd-card cd-card--lead">
			@cdCardBody(s, yuva)
		</article>
	} else {
		<article class="cd-card">
			@cdCardBody(s, yuva)
		</article>
	}
}

// cdCardGorsel yalnız görseli basar (manşette metinden sonra gelir).
templ cdCardGorsel(s CDStory, yuva CDYuva) {
	if s.Image != "" {
		<a class="cd-card__media" href={ s.Href } tabindex="-1" aria-hidden="true">
			if cdKgOlcekli(s.Image) {
				<img src={ cdKgSrc(s.Image, yuva) } srcset={ cdKgSrcset(s.Image, yuva) }
					sizes={ cdKgSizes(yuva) } alt="" loading="eager" fetchpriority="high"
					decoding="async" referrerpolicy="no-referrer"/>
			} else {
				<img src={ s.Image } alt="" loading="eager" fetchpriority="high"
					decoding="async" referrerpolicy="no-referrer"/>
			}
		</a>
	}
}

templ cdCardBody(s CDStory, yuva CDYuva) {
	if s.Image != "" {
		<a class="cd-card__media" href={ s.Href } tabindex="-1" aria-hidden="true">
			<!-- İki dal: templ'in koşullu öznitelik sözdizimi sürümden
			     sürüme değişiyor (bkz. cd_shell.templ notu). Kaynak görseli
			     ölçeklenebiliyorsa srcset/sizes basılır, değilse adres
			     olduğu gibi kalır (dış adres, /media/... vb.). -->
			if cdKgOlcekli(s.Image) {
				<img src={ cdKgSrc(s.Image, yuva) } srcset={ cdKgSrcset(s.Image, yuva) }
					sizes={ cdKgSizes(yuva) } alt="" loading="lazy" decoding="async"
					referrerpolicy="no-referrer"/>
			} else {
				<img src={ s.Image } alt="" loading="lazy" decoding="async"
					referrerpolicy="no-referrer"/>
			}
		</a>
	}
	if s.Kicker != "" {
		<span class="cd-kicker">{ s.Kicker }</span>
	}
	<h3 class="cd-card__title"><a href={ s.Href }>{ s.Title }</a></h3>
	if s.Spot != "" {
		<p class="cd-card__spot">{ s.Spot }</p>
	}
	@cdMeta(s)
}

templ cdMeta(s CDStory) {
	<div class="cd-card__meta">
		if s.Time != "" {
			<span>{ s.Time }</span>
		}
		if s.Source != "" {
			if s.Time != "" {
				<span> · </span>
			}
			if s.SourceURL != "" {
				<a href={ s.SourceURL } rel="nofollow noopener" target="_blank">{ s.Source }</a>
			} else {
				<span>{ s.Source }</span>
			}
		}
	</div>
}

// cdLatestRow §5 "Latest News": saat damgası solda, başlık sağda, görsel yok.
templ cdLatestRow(s CDStory) {
	<div class="cd-list__item">
		<span class="cd-list__time">{ s.Time }</span>
		<div class="cd-list__main">
			<a class="cd-list__title" href={ s.Href }>{ s.Title }</a>
			if s.Source != "" {
				<span class="cd-card__meta"> · { s.Source }</span>
			}
		</div>
	</div>
}

// cdBloklar §22 bölüm blokları — CoinDesk'in 2×2 ızgarası.
//
// ÖLÇÜLDÜ (coindesk.com/tr, 6 Kasım 2026): alt bölüm tek bir ızgara,
// 724 + 724 px, gap 16. Her hücre KENDİ `border-top` çizgisini taşıyor
// (1 px #a6a6a6) ve `padding: 20px 20px 0`. Önceki sürüm kategori başına
// tam genişlik 923/461 modül basıyordu — CoinDesk'te böyle bir düzen YOK.
templ cdBloklar(sections []CDSection) {
	if len(sections) > 0 {
		<section class="cd-bloklar">
			for _, sec := range sections {
				if sec.Lead.Href != "" {
					@cdBlokHucre(sec)
				}
			}
		</section>
	}
}

// cdBlokHucre tek bölüm hücresi: başlık bağlantısı + [görselli kart | 3 satır].
//
// Anatomi (birebir): başlık 14/21 w500 + 16 px ok (gap 4), iç ızgara
// 334+334 gap 16; solda görsel 16/9 + başlık 24/30 w500 + saat 14/21,
// sağda üç satır: başlık 18/26 w500 + saat 14/21, aralarında 1 px çizgi
// ve iki yanında 16 px boşluk.
templ cdBlokHucre(sec CDSection) {
	<section class="cd-blok">
		<a class="cd-blok__bas" href={ sec.Href }>
			{ sec.Title }
			<svg class="cd-blok__ok" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M6 3.5 10.5 8 6 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</a>
		<div class="cd-blok__ic">
			<article class="cd-blok__kart">
				if sec.Lead.Image != "" {
					<a class="cd-blok__gorsel" href={ sec.Lead.Href } tabindex="-1" aria-hidden="true">
						if cdKgOlcekli(sec.Lead.Image) {
							<img src={ cdKgSrc(sec.Lead.Image, YuvaBlokLead) } srcset={ cdKgSrcset(sec.Lead.Image, YuvaBlokLead) }
								sizes={ cdKgSizes(YuvaBlokLead) } alt="" loading="lazy" decoding="async"
								referrerpolicy="no-referrer"/>
						} else {
							<img src={ sec.Lead.Image } alt="" loading="lazy" decoding="async"
								referrerpolicy="no-referrer"/>
						}
					</a>
				}
				<a class="cd-blok__manset" href={ sec.Lead.Href }>{ sec.Lead.Title }</a>
				if sec.Lead.Time != "" {
					<time class="cd-blok__zaman">{ sec.Lead.Time }</time>
				}
			</article>
			<div class="cd-blok__liste">
				for i, s := range sec.Rows {
					<div class="cd-blok__satir">
						if i > 0 {
							<div class="cd-blok__ayirici" aria-hidden="true"></div>
						}
						<a class="cd-blok__baslik" href={ s.Href }>{ s.Title }</a>
						if s.Time != "" {
							<div class="cd-blok__meta">
								<time>{ s.Time }</time>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</section>
}

// cdIkili §20 + §21: Görüş (25%) ve En Çok Okunan (75%) YAN YANA.
//
// CoinDesk ana sayfasında bu iki modül ayrı tam genişlik bloklar değil;
// tek satırın iki paneli (ölçüldü: 366 + 1074, gap 24). Her panelin
// `border-top` çizgisi kendi genişliğinde kalıyor — bu yüzden sarmalayıcı
// değil paneller çizgi taşıyor.
templ cdIkili(yorum, enCok []CDStory) {
	if len(yorum) > 0 || len(enCok) > 0 {
		<section class="cd-mod">
			<div class="cd-ikili">
				if len(yorum) > 0 {
					<div class="cd-ikili__sol">
						@cdOpinion(yorum)
					</div>
				}
				if len(enCok) > 0 {
					<div class="cd-ikili__sag">
						@cdMostRead(enCok)
					</div>
				}
			</div>
		</section>
	}
}

// cdMostRead §21 — manşet 5fr + iki sütun küçük kart 7fr (ölçüldü).
templ cdMostRead(items []CDStory) {
	if len(items) > 0 {
		<section class="cd-panel">
			<h2>En Çok Okunan</h2>
			<div class="cd-most">
				<div class="cd-most__kart">
					@cdCard(items[0], false, YuvaEnCokOkunan)
				</div>
				if len(items) > 1 {
					<ul class="cd-most__liste">
						for _, s := range items[1:] {
							<li>
								@cdCard(s, false, YuvaEnCokOkunan)
							</li>
						}
					</ul>
				}
			</div>
		</section>
	}
}

// cdOpinion §20 — yazar avatarlı satırlar (ölçüldü: 12/18 yazar, 18/26 başlık).
templ cdOpinion(items []CDStory) {
	if len(items) > 0 {
		<section class="cd-panel">
			<h2>Görüş</h2>
			<div class="cd-opinion">
				for i, s := range items {
					if i == 0 {
						<div class="cd-opinion__satir">
							@cdOpinionMetin(s)
							@cdOpinionAvatar(s)
						</div>
					} else {
						<div class="cd-opinion__satir cd-opinion__satir--cizgili">
							@cdOpinionMetin(s)
							@cdOpinionAvatar(s)
						</div>
					}
				}
			</div>
		</section>
	}
}

templ cdOpinionMetin(s CDStory) {
	<div class="cd-opinion__metin">
		if s.Source != "" {
			<span class="cd-opinion__yazar">{ s.Source }</span>
		}
		<a class="cd-opinion__baslik" href={ s.Href }>{ s.Title }</a>
	</div>
}

templ cdOpinionAvatar(s CDStory) {
	if s.Image != "" {
		if cdKgOlcekli(s.Image) {
			<img class="cd-opinion__avatar" src={ cdKgSrc(s.Image, YuvaAvatar) }
				alt="" loading="lazy" referrerpolicy="no-referrer"/>
		} else {
			<img class="cd-opinion__avatar" src={ s.Image } alt="" loading="lazy"
				referrerpolicy="no-referrer"/>
		}
	}
}

templ CDHome(v CDHomeView) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", Image: v.Lead.Image, Hreflang: v.Hreflang,
				SiteName: v.Shell.SiteName, RSSFeed: "/rss.xml", JSONLD: v.JSONLD})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap cd-main">
				<!-- §8 manşet bloğu — CoinDesk hero'su ÜÇ kolon (spec §7A):
				     290 sol ray · 608 merkez · 290 sağ ray, kolon arası 80.
				     Sol ray: "Son Haberler" (başlık + saat, görselsiz).
				     Sağ ray: bölüm modülleri (video/araştırma/klipler
				     bizde yok — uydurma basmıyoruz).
				     Hero ÇİZGİSİZ: CoinDesk'te ana içeriğin ilk modülü
				     `border-top: 0`, `padding: 32px 0` (ölçüldü). Önünde
				     promo bandı da YOK — o şerit bizde uydurmaydı. -->
				if v.Lead.Href != "" {
					<section class="cd-mod cd-mod--cizgisiz">
						<div class="cd-hero">
							@cdHeroSolRay(v.RailLeft)
							<div class="cd-hero__orta">
								@cdHeroLead(v.Lead)
							</div>
							@cdHeroSagRay(v.RailRight)
						</div>
					</section>
				}

				<!-- §5 Latest News: saat damgalı düz liste -->
				if len(v.Latest) > 0 {
					<section class="cd-mod">
						@cdSectionHead("Son Haberler", "/latest-crypto-news")
						<div class="cd-list">
							for _, s := range v.Latest {
								@cdLatestRow(s)
							}
						</div>
					</section>
				}

				<!-- §7 bülten formu ana sayfada YOK: CoinDesk TR ana
				     sayfasında hiç form bulunmuyor (6 Kasım 2026 ölçümü;
				     yalnız footer'da "Newsletters" bağlantıları var).
				     `cdNewsletter` bileşeni /bulten sayfasında kalıyor —
				     orada form gerçekten var. -->

				<!-- §13 reklam — TAM GENİŞLİK bant (spec §2.1, §7.3).
				     İç kapsayıcı YOK: kenardan kenara, padding 32 px 0.
				     Gövde kapsanmış bandı bununla kesiliyor; modül ritmi
				     bu yüzden "kapsanmış → tam → kapsanmış" alternasyonu
				     oluşturuyor. -->
				<section class="cd-tam">
					@cdAd("Reklam")
				</section>

				<!-- §14 prices -->
				@cdPriceTable("Kripto Fiyatları", v.Prices)

				<!-- §20+§21 Görüş (25%) + En Çok Okunan (75%) yan yana -->
				@cdIkili(v.Opinion, v.MostRead)

				<!-- §22 bölüm blokları — tek 2×2 ızgara -->
				@cdBloklar(v.Sections)
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}

// cdNewsletter §7: e-posta kayıt modülü.
//
// CoinDesk düzeni: bölüm başlığı + tek satır açıklama + e-posta alanı +
// kayıt düğmesi + küçük koşul metni. Form, mevcut POST /bulten ucuna
// gönderilir (çift onay akışı hazır); JS gerekmez — çalışan HTML formu.
templ cdNewsletter() {
	<section class="cd-mod">
		<div class="cd-news">
			<div>
				<h2>Günlük bülten</h2>
				<p class="cd-card__spot">Günün en önemli kripto haberleri, her sabah e-postanızda. Ücretsiz.</p>
			</div>
			<form class="cd-news__form" method="post" action="/bulten">
				<label class="cd-visually-hidden" for="cd-news-email">E-posta adresiniz</label>
				<input class="cd-news__input" id="cd-news-email" type="email" name="email"
					required placeholder="ornek@eposta.com" autocomplete="email"/>
				<button class="cd-btn" type="submit">Abone ol</button>
			</form>
		</div>
		<p class="cd-news__not">
			Kayıt sonrası onay e-postası gönderilir. Adresiniz yalnız bülten için kullanılır;
			<a href="/gizlilik-politikasi">gizlilik politikası</a>.
		</p>
	</section>
}

// cdPriceTable §14/§15: sıra, sembol, fiyat, değişim.
templ cdPriceTable(baslik string, rows []CDPriceRow) {
	if len(rows) > 0 {
	<section class="cd-mod">
		@cdSectionHead(baslik, "/price")
		<table class="cd-table">
			<thead>
				<tr>
					<th>#</th>
					<th>Varlık</th>
					<th class="num">Fiyat</th>
					<th class="num">24s</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range rows {
					<tr>
						<td>{ cdSiraya(r.Rank) }</td>
						<td>
							<a href={ r.Href }>
								<strong>{ r.Sym }</strong>
								<span class="cd-card__meta"> { r.Name }</span>
							</a>
						</td>
						<td class="num">{ r.Price }</td>
						<td class="num">
							if r.Up {
								<span class="cd-up">{ r.Change }</span>
							} else {
								<span class="cd-down">{ r.Change }</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
	}
}
