package templkit

// CoinDesk fiyat sayfası (§14).

// CDPricePage /price sayfasının verisidir.
type CDPricePage struct {
	Shell     CDShell
	Title     string
	Desc      string
	Canonical string
	Rows      []CDPriceRow
	// Piyasa Nabzı: gerçek zincir-üstü veri (boşsa basılmaz).
	NabizFiyat *CDGrafikKart
	Nabiz      []CDGrafikKart
	JSONLD    string
	BaseURL   string
	// CoinDesk SEO sınıflandırması (bkz. templkit.CDHead).
	PageCategory    string
	ContentCategory string
	Locale          string
}

templ CDPricePageView(v CDPricePage) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", SiteName: v.Shell.SiteName, RSSFeed: "/rss.xml",
				JSONLD: v.JSONLD, Locale: v.Locale, PageCategory: v.PageCategory,
				ContentCategory: v.ContentCategory, BaseURL: v.BaseURL})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap">
				<header class="cd-section-title">
					<h1>Kripto Fiyatları</h1>
					<p class="cd-card__spot">{ v.Desc }</p>
				</header>
				@cdNabizModul(v.NabizFiyat, v.Nabiz,
					"Kaynak: CryptoQuant · BTC · Binance akışları · günlük veri · 10 dakika önbellek")
				<section class="cd-mod">
					@cdPriceTable("Piyasa değerine göre", v.Rows)
				</section>
				if len(v.Rows) == 0 {
					<p class="cd-card__spot">Fiyat verisi şu an alınamıyor; birkaç dakika sonra yeniden deneyin.</p>
				}
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}
