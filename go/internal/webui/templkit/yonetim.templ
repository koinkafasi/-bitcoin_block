// Yönetim panelleri (templ): Marka Merkezi, Konu Kümeleri, AdSense.
// html/template karşılıklarının birebir taşınması; HTMX hedefleri korunur.
package templkit

// ---- Marka Merkezi ----

// MarkaView marka/logo sayfası görünümü.
type MarkaView struct {
	FlashKind   string
	FlashText   string
	Mode        string
	Text        string
	Tagline     string
	LogoURL     string
	FaviconURL  string
	OGURL       string
	SiteBaslik  string
	Slogan      string
	PanelLogo   string
}

// MarkaPanel site kimliği + logo + panel markası (HTMX hedefi: #marka-panel).
templ MarkaPanel(v MarkaView) {
	<div id="marka-panel">
		if v.FlashText != "" {
			<div class={ "flash", v.FlashKind }>{ v.FlashText }</div>
		}
		@Yukleniyor("marka-yukleniyor", "Kaydediliyor…")
		<form
			method="post"
			action="/admin/marka/kaydet"
			enctype="multipart/form-data"
			class="card card-pad"
			style="max-width:760px"
			hx-post="/admin/marka/kaydet"
			hx-encoding="multipart/form-data"
			hx-target="#marka-panel"
			hx-swap="outerHTML"
			hx-indicator="#marka-yukleniyor"
		>
			<h2 style="margin-top:0;font-size:1.1rem"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-palette"></use></svg> Marka Merkezi</h2>
			<p class="hint" style="margin-top:0">Site kimliği, logo ve paylaşım görselleri tek yerde yönetilir
				(eski "Ayarlar → Site Başlığı/Slogan" buraya taşındı).</p>
			<div class="field">
				<label for="f_site_baslik">Site Başlığı</label>
				<input id="f_site_baslik" class="input" name="site_baslik" value={ v.SiteBaslik } placeholder="theblock"/>
				<p class="hint">Tarayıcı sekmesi ve SEO başlığı için kullanılır.</p>
			</div>
			<div class="field">
				<label for="f_slogan">Slogan</label>
				<input id="f_slogan" class="input" name="slogan" value={ v.Slogan } placeholder="Güncel Haber Portalı"/>
			</div>
			<div class="field">
				<label>Logo Türü</label>
				<div class="input-row">
					<label class="tag" style="cursor:pointer"><input type="radio" name="mode" value="text" if v.Mode != "image" { checked }/> Metin Logo</label>
					<label class="tag" style="cursor:pointer"><input type="radio" name="mode" value="image" if v.Mode == "image" { checked }/> Görsel Logo</label>
				</div>
				<p class="hint">Görsel logo yüklenmezse otomatik olarak metin logoya düşülür (resim yokken yazı logo).
					<b>SVG desteklenir</b> — vektör logo tek dosyada her ekranda net görünür.
					Güvenlik için yüklenen SVG beyaz liste ile temizlenir: script, dış bağlantı ve
					olay işleyicileri atılır.</p>
			</div>
			<div class="field">
				<label for="f_text">Metin Logo</label>
				<input id="f_text" class="input" name="text" value={ v.Text } placeholder="theblock"/>
				<p class="hint">Boş bırakılırsa <b>theblock</b> (vurgulu) kullanılır.</p>
			</div>
			<div class="field">
				<label for="f_tagline">Slogan (logo altı yazı)</label>
				<input id="f_tagline" class="input" name="tagline" value={ v.Tagline } placeholder="Slogan"/>
				<p class="hint">Header ve footer'da logonun altında görünür.</p>
			</div>
			<hr style="margin:14px 0;border:0;border-top:1px dashed var(--border)"/>
			<div class="input-row" style="align-items:flex-start;gap:20px;flex-wrap:wrap">
				<div class="field" style="min-width:220px">
					<label>Logo Görseli (header + footer)</label>
					if v.LogoURL != "" {
						<img src={ templ.SafeURL(v.LogoURL) } alt="logo" style="max-height:44px;background:#18181b;border-radius:6px;padding:6px;display:block;margin-bottom:6px"/>
					}
					<input class="input" type="file" name="logo" accept="image/jpeg,image/png,image/webp,image/svg+xml,.svg" aria-label="Logo görseli"/>
					if v.LogoURL != "" {
						<label class="tag" style="cursor:pointer;margin-top:6px"><input type="checkbox" name="remove_logo"/> Mevcut görseli kaldır</label>
					}
				</div>
				<div class="field" style="min-width:180px">
					<label>Favicon / uygulama ikonu</label>
					if v.FaviconURL != "" {
						<img src={ templ.SafeURL(v.FaviconURL) } alt="favicon" style="width:40px;height:40px;object-fit:contain;background:#fff;border-radius:6px;padding:4px;display:block;margin-bottom:6px"/>
					}
					<input class="input" type="file" name="favicon" accept="image/jpeg,image/png,image/webp,image/svg+xml,.svg" aria-label="Favicon / uygulama ikonu"/>
					if v.FaviconURL != "" {
						<label class="tag" style="cursor:pointer;margin-top:6px"><input type="checkbox" name="remove_favicon"/> Kaldır</label>
					}
				</div>
				<div class="field" style="min-width:200px">
					<label>OG görseli (paylaşım)</label>
					if v.OGURL != "" {
						<img src={ templ.SafeURL(v.OGURL) } alt="og" style="max-height:70px;background:#18181b;border-radius:6px;padding:4px;display:block;margin-bottom:6px"/>
					}
					<input class="input" type="file" name="og" accept="image/jpeg,image/png,image/webp,image/svg+xml,.svg" aria-label="OG paylaşım görseli"/>
					if v.OGURL != "" {
						<label class="tag" style="cursor:pointer;margin-top:6px"><input type="checkbox" name="remove_og"/> Kaldır</label>
					}
				</div>
			</div>
			<button class="btn" type="submit" style="margin-top:12px">Kaydet</button>
			<p class="hint" style="margin-top:8px">İpucu: görsel yüklediğinizde logo modu otomatik olarak
				<b>Görsel Logo</b>'ya geçer. Değişiklik site tarafında ~1 dakika içinde görünür (önbellek) —
				hemen görmek için sayfayı yenileyin (Ctrl+F5).</p>
		</form>
		<div class="card card-pad" style="max-width:760px;margin-top:14px">
			<h2 style="margin-top:0;font-size:1.1rem">Panel Markası (yönetim arayüzü)</h2>
			<p class="hint" style="margin-top:0">Bu bölüm yalnızca <b>yönetim panelinin</b> görünümünü etkiler;
				okuyucuların gördüğü site logosu yukarıdaki bölümdür.</p>
			<form method="post" action="/admin/gorunum" enctype="multipart/form-data"
				style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap">
				<div class="field">
					<label for="f_logo">Panel logosu</label>
					if v.PanelLogo != "" {
						<img src={ templ.SafeURL(v.PanelLogo) } alt="panel logosu" style="max-height:36px;display:block;margin-bottom:4px"/>
					}
					<input id="f_logo" class="input" type="file" name="logo" accept="image/*" aria-label="Logo görseli"/>
				</div>
				<div class="field">
					<label for="f_icon">Panel simgesi</label>
					<input id="f_icon" class="input" type="file" name="icon" accept="image/*"/>
				</div>
				<button class="btn small" type="submit">Panel Markasını Kaydet</button>
				<a class="btn ghost small" href="/admin/gorunum"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-palette"></use></svg> Renk &amp; Font Ayarları</a>
			</form>
		</div>
	</div>
}

// ---- Konu Kümeleri ----

// KumeRow küme listesi satırı.
type KumeRow struct {
	ID    string
	Name  string
	Count int
}

// KumeItem küme içerik satırı.
type KumeItem struct {
	ID     string
	Title  string
	Status string
}

// KumeUyari içerik çakışması uyarısı.
type KumeUyari struct {
	A, B        string
	TitleA      string
	TitleB      string
	Overlap     string
}

// KumelerView konu kümeleri paneli.
type KumelerView struct {
	FlashKind   string
	FlashText   string
	Clusters    []KumeRow
	HasActive   bool
	ActiveID    string
	ActiveName  string
	ActiveIntent string
	Warnings    []KumeUyari
	Pool        []KumeItem
	Items       []KumeItem
}

// KumelerPanel konu kümesi yönetimi (HTMX hedefi: #kumeler-panel).
templ KumelerPanel(v KumelerView) {
	<div id="kumeler-panel">
		if v.FlashText != "" {
			<div class={ "flash", v.FlashKind }>{ v.FlashText }</div>
		}
		@Yukleniyor("kumeler-yukleniyor", "İşleniyor…")
		<div class="grid-2" style="grid-template-columns:300px 1fr;align-items:start">
			<div class="gap">
				<form
					method="post"
					action="/admin/kumeler/ekle"
					class="card card-pad"
					hx-post="/admin/kumeler/ekle"
					hx-target="#kumeler-panel"
					hx-swap="outerHTML"
					hx-indicator="#kumeler-yukleniyor"
					hx-on::after-request="if (event.detail.successful) this.reset();"
				>
					<h2 style="margin:0 0 8px;font-size:1.05rem">Yeni Küme</h2>
					<div class="field">
						<label for="f_name">Ad</label>
						<input id="f_name" class="input" name="name" required/>
					</div>
					<div class="field">
						<label for="f_intent">Ni yet</label>
						<select id="f_intent" class="input" name="intent">
							<option value="bilgi">Bilgi</option>
							<option value="ticari">Ticari</option>
							<option value="nav">Navigasyon</option>
						</select>
					</div>
					<button class="btn" type="submit">＋ Ekle</button>
				</form>
				<div class="card card-pad">
					if len(v.Clusters) == 0 {
						<p class="muted small">Henüz küme yok.</p>
					}
					for _, c := range v.Clusters {
						<div style="display:flex;gap:6px;align-items:center;padding:6px 0;border-bottom:1px dashed var(--border)">
							<a
								href={ templ.SafeURL("/admin/kumeler?kus=" + c.ID) }
								hx-get={ "/admin/kumeler?kus=" + c.ID }
								hx-target="#kumeler-panel"
								hx-swap="outerHTML"
								hx-indicator="#kumeler-yukleniyor"
								style="flex:1"
							>{ c.Name } <span class="badge">{ itoaT(c.Count) }</span></a>
							<a
								class="btn danger small"
								href="#"
								data-confirm={ "/admin/kumeler/" + c.ID + "/sil" }
								hx-post={ "/admin/kumeler/" + c.ID + "/sil" }
								hx-target="#kumeler-panel"
								hx-swap="outerHTML"
								hx-confirm="Bu küme silinsin mi?"
								hx-indicator="#kumeler-yukleniyor"
							><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-x"></use></svg></a>
						</div>
					}
				</div>
			</div>
			<div class="gap">
				if v.HasActive {
					<div class="card card-pad">
						<h2 style="margin:0;font-size:1.1rem">Küme: { v.ActiveName }
							<span class="badge" style="background:var(--surface-2);color:var(--text-2)">{ v.ActiveIntent }</span></h2>
						<form method="post" action={ templ.SafeURL("/admin/kumeler/" + v.ActiveID + "/icerik/-1") } style="display:none" id="kume-ekle-fake"></form>
						if len(v.Warnings) > 0 {
							<div class="flash error" style="margin-top:8px">
								<strong><svg class="ti ti-metin" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-alert-triangle"></use></svg> İçerik çakışması (cannibalization):</strong>
								for _, w := range v.Warnings {
									<div style="padding:3px 0"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-player-play"></use></svg> <a href={ templ.SafeURL("/admin/icerikler/" + w.A) }>{ w.TitleA }</a> ↔ <a href={ templ.SafeURL("/admin/icerikler/" + w.B) }>{ w.TitleB }</a> <span class="small muted">({ w.Overlap } ortak kelime)</span></div>
								}
							</div>
						}
						<div style="display:flex;gap:8px;margin:12px 0">
							<select class="input" id="kume-pool" style="flex:1" aria-label="Kümeye eklenecek içerik">
								if len(v.Pool) == 0 {
									<option>— eklenecek içerik yok —</option>
								}
								for _, p := range v.Pool {
									<option value={ p.ID }>{ p.Title } (id={ p.ID })</option>
								}
							</select>
							<button class="btn small" id="kume-ekle" data-kus={ v.ActiveID }>＋ Ekle</button>
						</div>
						<table class="table">
							<thead>
								<tr><th>İçerik</th><th>Durum</th><th><span class="muted small">—</span></th></tr>
							</thead>
							<tbody>
								if len(v.Items) == 0 {
									@TabloBos(3, "file-text", "Kümede içerik yok", "Bu kümeye bağlı içerik bulunmuyor.", "", "")
								}
								for _, it := range v.Items {
									<tr>
										<td><a href={ templ.SafeURL("/admin/icerikler/" + it.ID) }>{ it.Title }</a></td>
										<td><span class={ "status-pill", "st-" + it.Status }>{ it.Status }</span></td>
										<td>
											<a
												class="btn ghost small"
												href="#"
												data-toggle={ "/admin/kumeler/" + v.ActiveID + "/icerik/" + it.ID + "?islem=cikar" }
												hx-post={ "/admin/kumeler/" + v.ActiveID + "/icerik/" + it.ID + "?islem=cikar" }
												hx-target="#kumeler-panel"
												hx-swap="outerHTML"
												hx-indicator="#kumeler-yukleniyor"
											>çıkar</a>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					<p class="muted">Küme seç.</p>
				}
			</div>
		</div>
	</div>
}

// ---- AdSense ----

// AdsenseView AdSense/GA bağlantı paneli.
type AdsenseView struct {
	FlashKind   string
	FlashText   string
	Connected   bool
	AccountName string
	TokenExpiry string
	SonSenkron  string
	ClientID    string
	GAProperty  string
	RedirectURI string
}

// AdSensePanel AdSense/GA yönetimi (HTMX hedefi: #adsense-panel).
templ AdSensePanel(v AdsenseView) {
	<div id="adsense-panel">
		if v.FlashText != "" {
			<div class={ "flash", v.FlashKind }>{ v.FlashText }</div>
		}
		@Yukleniyor("adsense-yukleniyor", "İşleniyor…")
		<div class="card card-pad" style="display:flex;gap:16px;flex-wrap:wrap;align-items:center">
			<div>
				<div class="small muted">Durum</div>
				<div class="big">
					if v.Connected {
						<span style="color:var(--ok)"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-circle-dot"></use></svg> Bağlı</span>
					} else {
						<span class="muted"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-circle-dot"></use></svg> Bağlı değil</span>
					}
				</div>
			</div>
			if v.AccountName != "" {
				<div><div class="small muted">AdSense Hesabı</div><div class="big">{ v.AccountName }</div></div>
			}
			if v.TokenExpiry != "" {
				<div><div class="small muted">Token geçerlilik</div><div class="big">{ v.TokenExpiry }</div></div>
			}
			if v.SonSenkron != "" {
				<div><div class="small muted">Son senkron</div><div class="big">{ v.SonSenkron }</div></div>
			}
			<div style="margin-left:auto;display:flex;gap:6px;flex-wrap:wrap">
				<a class="btn small" href="/admin/adsense/baglan"><svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-link"></use></svg> Bağlan (Google)</a>
				<form method="post" action="/admin/adsense/senkron"
					hx-post="/admin/adsense/senkron" hx-target="#adsense-panel" hx-swap="outerHTML" hx-indicator="#adsense-yukleniyor">
					<button class="btn small" type="submit" if !v.Connected { disabled }>⟳ Senkronize Et</button>
				</form>
				<form method="post" action="/admin/adsense/kes"
					hx-post="/admin/adsense/kes" hx-target="#adsense-panel" hx-swap="outerHTML"
					hx-confirm="Bağlantı kaldırılsın mı?" hx-indicator="#adsense-yukleniyor">
					<button class="btn small danger" type="submit" if !v.Connected { disabled }>Bağlantıyı Kes</button>
				</form>
			</div>
		</div>
		<h2 style="font-size:1.05rem;margin-top:20px">OAuth İstemci Bilgileri (Google Cloud Console)</h2>
		<form method="post" action="/admin/adsense/ayar" class="card card-pad"
			hx-post="/admin/adsense/ayar" hx-target="#adsense-panel" hx-swap="outerHTML" hx-indicator="#adsense-yukleniyor">
			<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:6px">
				<input class="input" name="client_id" value={ v.ClientID } placeholder="OAuth İstemci Kimliği" aria-label="OAuth İstemci Kimliği"/>
				<input class="input" type="password" name="client_secret" placeholder="OAuth İstemci Sırrı (boş = değişmez)" aria-label="OAuth İstemci Sırrı (boş = değişmez)"/>
				<input class="input" name="ga_property" value={ v.GAProperty } placeholder="GA4 mülk kimliği (örn. 123456789) — properties/ öneki de kabul edilir" aria-label="GA4 Property ID"/>
			</div>
			<p class="hint" style="margin:.6em 0">Yetkili yönlendirme URI'si (Google Cloud Console'a ekleyin):<br/><code>{ v.RedirectURI }</code></p>
			<p class="hint" style="margin:.4em 0">Kapsam: <code>https://www.googleapis.com/auth/adsense.readonly</code> (salt-okunur).</p>
			<button class="btn" type="submit">Kaydet</button>
		</form>
		<p class="hint" style="margin-top:14px">
			Bağlantı kurulmadan gelir verileri <b>kural tabanlı tahmin</b> (RPM × gösterim) olarak gösterilir ve "demo" rozeti taşır.
			OAuth tamamlanınca AdSense'ten gerçek hesap doğrulanır; sonraki adım gerçek RPM/gelir çekimidir.
			Gelir özeti: <a href="/admin/raporlar">/admin/raporlar</a>.
		</p>
	</div>
}