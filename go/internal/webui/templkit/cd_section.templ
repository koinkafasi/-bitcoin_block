package templkit

// CoinDesk bölüm sayfası (§8).
//
// Yapı: H1 bölüm adı + tek satır açıklama → öne çıkan (1 büyük görselli) →
// kart ızgarası → sağ ray yok (Faz 1 sade; sayfalama altta).
// JS yok.

templ CDSectionPageView(v CDSectionPage) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", Image: v.Lead.Image, SiteName: v.Shell.SiteName,
				RSSFeed: "/rss.xml", NoIndex: v.Page > 1, JSONLD: v.JSONLD})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap cd-wrap--bolum cd-main">
				<header class="cd-section-title">
					<h1>{ v.Section }</h1>
					<!-- CoinDesk bölüm sayfasında H1 altı AÇIKLAMA YOK
					     (ölçüm, spec §10.3 — eski spec "tek satır açıklama"
					     diyordu, yanlış). Metin yine <meta description>'da
					     ve kart spotlarında duruyor; görünür tekrar
					     hiyerarşiyi bozuyordu. -->
				</header>

				if v.Lead.Href != "" {
					<section class="cd-mod">
						<div class="cd-hero">
							@cdCard(v.Lead, true, YuvaHeroLead)
							<div class="cd-hero__side">
								for _, s := range v.Side {
									@cdCard(s, false, YuvaHeroYan)
								}
							</div>
						</div>
					</section>
				}

				if len(v.Stories) > 0 {
					<section class="cd-mod">
						@cdSectionHead("Son Haberler", "")
						<div class="cd-grid cd-grid--3">
							for _, s := range v.Stories {
								@cdCard(s, false, YuvaKart)
							}
						</div>
					</section>
				} else {
					<p class="cd-card__spot">Bu bölümde henüz haber yok.</p>
				}

				@cdMostRead(v.MostRead)

				<!-- Sayfalama: CoinDesk "More stories" DÜĞMESİ kullanıyor,
				     sonsuz kaydırma değil (spec §10.3). "Önceki" bağlantısı
				     erişilebilirlik için yanında kalır (klavye/geri dönüş):
				     yalnız ileri düğme, 2. sayfada geri dönüşü imkânsız kılar. -->
				<nav class="cd-daha" aria-label="Sayfalama">
					if v.PrevHref != "" {
						<a class="cd-daha__geri" href={ v.PrevHref } rel="prev">← Önceki</a>
					}
					if v.NextHref != "" {
						<a class="cd-daha__btn" href={ v.NextHref } rel="next">Daha fazla haber</a>
					}
				</nav>
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}
