package templkit

// CoinDesk bölüm (kategori) sayfası — §8.
//
// YAPI CoinDesk'ten BİREBİR ÖLÇÜLDÜ (8 Kasım 2026, 1440×1000, gerçek Chrome):
//
//	H1 kutusu : h1 36/44 w700, `border-b strong`, mb 24
//	12 kolon  : gap 16
//	  sol 9   : lead YATAY (metin %31 / görsel %67) + altında border-t
//	            alt ızgara 4 kolon × 239 px (görsel 16:9 üstte, h3 20/26 w500)
//	  sağ 3   : GÖRSELSİZ ray, 6 kalem, h2 16/24 w500 + saat 14/22
//	"More From X" : 1032 px ORTALANMIŞ, border-t strong, 14/21 w500
//	haber satırı  : metin 681 + görsel 327×185, h2 24/30 w500, aralarda hr
//	sayfalama     : düğme ortalanmış
//
// NEDEN YENİDEN YAZILDI: önceki sürüm ana sayfanın `.cd-kat-one` ızgarasını
// (6+3+3) kullanıyordu — lead 681 px çıkıyordu ve "More From" listesi
// 1029×749 px dikey kartlarla basılıyordu. CoinDesk'te ikisi de yok
// (ölçüldü: lead 1029×419 yatay, satırlar 1032×185).

templ CDSectionPageView(v CDSectionPage) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", Image: v.Lead.Image, SiteName: v.Shell.SiteName, FaviconURL: v.Shell.FaviconURL,
				RSSFeed: "/rss.xml", NoIndex: v.Page > 1, JSONLD: v.JSONLD,
				Locale: v.Locale, PageCategory: v.PageCategory, BaseURL: v.BaseURL,
				ContentCategory: v.ContentCategory})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap cd-wrap--bolum cd-main">
				<header class="cd-section-title">
					<h1>{ v.Section }</h1>
				</header>

								// PİYASA NABZI (yalnız /markets): gerçek CryptoQuant verisi.
				// Kaynak yoksa blok hiç basılmaz.
				@cdNabizModul(v.NabizFiyat, v.Nabiz,
					"Kaynak: CryptoQuant · BTC · Binance akışları · günlük veri · 10 dakika önbellek")

				<div class="cd-kat-izgara">
					<div class="cd-kat-sol">
						if v.Lead.Href != "" {
							@cdKatLead(v.Lead)
						}
						if len(v.Alt) > 0 {
							<div class="cd-kat-alt">
								for _, s := range v.Alt {
									@cdKatAltKart(s)
								}
							</div>
						}
					</div>
					if len(v.Ray) > 0 {
						<aside class="cd-kat-ray" aria-label="Öne çıkanlar">
							for _, s := range v.Ray {
								@cdKatRayKalem(s)
							}
						</aside>
					}
				</div>

								// Sayfalama: CoinDesk "More stories" DÜĞMESİ. JS varsa
				// cd-daha.js parçayı aynı sayfaya ekler (sayfa geçişi
				// yok); JS yoksa normal ?sayfa=N bağlantısı çalışır.
				// Nav, satırlarla AYNI konteynerde: JS satırları
				// nav'dan ÖNCE ekler (1032px ortalanmış alan korunur).
				if len(v.Stories) > 0 || v.PrevHref != "" || v.NextHref != "" {
					<div class="cd-kat-genis">
						if v.MoreBaslik != "" && len(v.Stories) > 0 {
							<p class="cd-kat-more">{ v.MoreBaslik }</p>
						}
						for i, s := range v.Stories {
							if i > 0 {
								<hr class="cd-kat-satir__cizgi"/>
							}
							@cdKatSatir(s)
						}
						if v.PrevHref != "" || v.NextHref != "" {
							<nav class="cd-daha" aria-label="Sayfalama">
								if v.PrevHref != "" {
									<a class="cd-daha__geri" href={ v.PrevHref } rel="prev">← Önceki</a>
								}
								if v.NextHref != "" {
									<a class="cd-daha__btn" href={ v.NextHref } rel="next">Daha fazla haber</a>
								}
							</nav>
						}
					</div>
				} else if v.Lead.Href == "" {
					<p class="cd-card__spot">Bu bölümde henüz haber yok.</p>
				}

				if v.NextHref != "" {
					<script src={ "/static/cd-daha.js?v=" + cdVarlik() } defer></script>
				}
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}

// cdKatLead öne çıkan YATAY kart: solda metin (%31), sağda görsel (%67).
templ cdKatLead(s CDStory) {
	<article class="cd-kat-lead">
		<div class="cd-kat-lead__metin">
			<h2><a href={ s.Href }>{ s.Title }</a></h2>
			if s.Spot != "" {
				<p class="cd-kat-lead__spot">{ s.Spot }</p>
			}
			@cdMetaSatir(s)
		</div>
		if s.Image != "" {
			<a class={ cdGriSinif("cd-kat-lead__gorsel", s.Gri) } href={ s.Href } tabindex="-1" aria-hidden="true">
				@cdGorselImg(s.Image, YuvaKatLeadYatay, true)
			</a>
		} else {
			// Görselsiz haber: ilk harfli tipografik kapak. RSS'ten
			// gelen içeriklerin bir kısmı görselsiz; kart boş
			// kalınca liste düzeni bozuluyordu.
			<a class="cd-kat-lead__gorsel" href={ s.Href } tabindex="-1" aria-hidden="true">
				@cdKapakYok(s)
			</a>
		}
	</article>
		// Lead'in altındaki ayırıcı (CoinDesk: border-t mt-6 mb-2).
	<hr class="cd-kat-lead__cizgi"/>
}

// cdKatAltKart alt 4'lü ızgaranın kartı: görsel ÜSTTE, h3 ALTTA.
templ cdKatAltKart(s CDStory) {
	<article class="cd-kat-alt__kart">
		if s.Image != "" {
			<a class={ cdGriSinif("cd-kat-alt__gorsel", s.Gri) } href={ s.Href } tabindex="-1" aria-hidden="true">
				@cdGorselImg(s.Image, YuvaKatAlt, false)
			</a>
		} else {
			// Görselsiz haber: ilk harfli tipografik kapak. RSS'ten
			// gelen içeriklerin bir kısmı görselsiz; kart boş
			// kalınca liste düzeni bozuluyordu.
			<a class="cd-kat-alt__gorsel" href={ s.Href } tabindex="-1" aria-hidden="true">
				@cdKapakYok(s)
			</a>
		}
		<h3><a href={ s.Href }>{ s.Title }</a></h3>
		if s.Time != "" {
			<span class="cd-kat-alt__saat">{ s.Time }</span>
		}
	</article>
}

// cdKatRayKalem sağ ray kalemi: GÖRSELSİZ, h2 16/24 w500 + saat.
templ cdKatRayKalem(s CDStory) {
	<div class="cd-kat-ray__kalem">
		<h2><a href={ s.Href }>{ s.Title }</a></h2>
		if s.Time != "" {
			<span class="cd-kat-ray__saat">{ s.Time }</span>
		}
	</div>
}

// cdKatSatir "More From" listesinin satırı: metin 681 + görsel 327×185.
templ cdKatSatir(s CDStory) {
	<article class="cd-kat-satir">
		<div class="cd-kat-satir__metin">
			<h2><a href={ s.Href }>{ s.Title }</a></h2>
			if s.Spot != "" {
				<p class="cd-kat-satir__spot">{ s.Spot }</p>
			}
			@cdMetaSatir(s)
		</div>
		if s.Image != "" {
			<a class={ cdGriSinif("cd-kat-satir__gorsel", s.Gri) } href={ s.Href } tabindex="-1" aria-hidden="true">
				@cdGorselImg(s.Image, YuvaKatSatir, false)
			</a>
		} else {
			// Görselsiz haber: ilk harfli tipografik kapak. RSS'ten
			// gelen içeriklerin bir kısmı görselsiz; kart boş
			// kalınca liste düzeni bozuluyordu.
			<a class="cd-kat-satir__gorsel" href={ s.Href } tabindex="-1" aria-hidden="true">
				@cdKapakYok(s)
			</a>
		}
	</article>
}

// cdMetaSatir tek satırlık yazar/saat bilgisi (CoinDesk 14/22, alt çizgi).
templ cdMetaSatir(s CDStory) {
	if s.Time != "" || s.Source != "" {
		<p class="cd-kat-lead__meta">
			if s.Source != "" {
				<span>Yazar: </span>
				if s.SourceURL != "" {
					<a href={ s.SourceURL } rel="nofollow noopener" target="_blank">{ s.Source }</a>
				} else {
					<span>{ s.Source }</span>
				}
			}
			if s.Time != "" {
				if s.Source != "" {
					<span> · </span>
				}
				<time>{ s.Time }</time>
			}
		</p>
	}
}

// cdGorselImg srcset/sizes üreten tek görsel yardımcısı.
//
// NEDEN: kategori/etiket görselleri farklı yuvalarda (686/239/327/692 px)
// kullanılıyor; her şablon kendi <img> etiketini yazarsa srcset kuralları
// birinde bozulur. Tek yerden üretiliyor.
templ cdGorselImg(url string, yuva CDYuva, oncelikli bool) {
	if cdKgOlcekli(url) {
		if oncelikli {
			<img src={ cdKgSrc(url, yuva) } srcset={ cdKgSrcset(url, yuva) }
				sizes={ cdKgSizes(yuva) } alt="" loading="eager" fetchpriority="high"
				decoding="async" referrerpolicy="no-referrer"/>
		} else {
			<img src={ cdKgSrc(url, yuva) } srcset={ cdKgSrcset(url, yuva) }
				sizes={ cdKgSizes(yuva) } alt="" loading="lazy" decoding="async"
				referrerpolicy="no-referrer"/>
		}
	} else {
		if oncelikli {
			<img src={ url } alt="" loading="eager" fetchpriority="high"
				decoding="async" referrerpolicy="no-referrer"/>
		} else {
			<img src={ url } alt="" loading="lazy" decoding="async"
				referrerpolicy="no-referrer"/>
		}
	}
}

// CDBolumParca "Daha fazla haber" PARÇASI: yalnız satırlar + yeni nav.
//
// NEDEN: `?sayfa=N` tam sayfa geçişi yerine cd-daha.js bu parçayı çeker
// ve listenin sonuna ekler (CoinDesk davranışı: URL değişmez, sayfa
// yenilenmez). Parça DİZİSİZ (head/footer/modül yok) — `?parca=1`.
//
// Her satırdan ÖNCE ayırıcı basılır (tam sayfada i>0 kuralı var): parça
// mevcut listenin sonuna eklendiğinde ilk yeni satırın da üstünde çizgi
// olmalı. Nav parçanın içinde: JS yeni href'lerle yeniler.
templ CDBolumParca(stories []CDStory, prevHref, nextHref string) {
	for _, s := range stories {
		<hr class="cd-kat-satir__cizgi"/>
		@cdKatSatir(s)
	}
	if prevHref != "" || nextHref != "" {
		<nav class="cd-daha" aria-label="Sayfalama">
			if prevHref != "" {
				<a class="cd-daha__geri" href={ prevHref } rel="prev">← Önceki</a>
			}
			if nextHref != "" {
				<a class="cd-daha__btn" href={ nextHref } rel="next">Daha fazla haber</a>
			}
		</nav>
	}
}
