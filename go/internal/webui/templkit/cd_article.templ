package templkit

// CoinDesk makale sayfası (§7, §10.2) — ölçülen sıra:
//
//	kicker (16/32) → H1 (36/44 w500) → deck (16/24) → "Yazan" + yazar →
//	tarih bloğu (Güncellendi · Yayınlandı) → eylem pilleri →
//	kapak (16/9) → ÖZET KUTUSU → gövde (22/30) → kaynak atfı → etiketler →
//	yazar kutusu → ilgili → önceki/sonraki.
//
// JS yok: özet kutusu ve paylaş menüsü `<details>` ile açılıyor. Gövde
// sunucuda üretilmiş güvenilir HTML'dir (blok motoru).

templ CDArticle(v CDArticleView) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "article", Image: v.Image, ImageAlt: v.ImageAlt,
				SiteName: v.Shell.SiteName, FaviconURL: v.Shell.FaviconURL, Locale: v.Locale,
				PageCategory: v.PageCategory, ContentCategory: v.ContentCategory,
				Metas: v.Metas, JSONLD: v.JSONLD,
				BreadcrumbJSONLD: v.BreadcrumbJSONLD, FAQJSONLD: v.FAQJSONLD, BaseURL: v.BaseURL,
				// Tepki çubuğunu açan betik; `defer` ile basılır.
				EkJS: []string{"/static/cd-tepki.js"},
				Hreflang: v.Hreflang})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap cd-main cd-main--makale">
				<article class="cd-article">
					<span class="cd-kicker">{ v.Kicker }</span>
					<h1>{ v.Headline }</h1>
					if v.Spot != "" {
						<p class="cd-article__spot">{ v.Spot }</p>
					}
					<div class="cd-article__meta">
						<span>{ v.Dil.Yazan }</span>
						if v.AuthorURL != "" {
							<a class="cd-yazar-bag" href={ v.AuthorURL }>{ v.Author }</a>
						} else {
							<span>{ v.Author }</span>
						}
					</div>

										// Tarih bloğu: Güncellendi + Yayınlandı.
					// "Güncellendi" YALNIZ gerçekten sonradan düzenlendiyse
					// basılır; her içerikte `updated_at` yayından birkaç
					// dakika sonra olduğu için eşik 1 saat (ölçüldü:
					// 126/126 içerik "güncellenmiş" görünüyordu).
					if v.PublishedAt != "" {
						<div class="cd-article__tarih">
							if v.UpdatedAt != "" {
								<span>{ v.Dil.Guncellendi } <time datetime={ v.UpdatedISO }>{ v.UpdatedAt }</time></span>
								<span>{ v.Dil.Yayinlandi } <time datetime={ v.PublishedISO }>{ v.PublishedAt }</time></span>
							} else {
								<span>{ v.Dil.Yayinlandi } <time datetime={ v.PublishedISO }>{ v.PublishedAt }</time></span>
							}
						</div>
					}

										// ÇEVİRİ ETİKETİ — CoinDesk §10.2: tarih bloğunun ALTINDA
					// (y=510), eylem şeridinin ÜSTÜNDE; 160×25, 14/21.
					// YALNIZ çeviri kayıtlarında (translation_of dolu)
					// basılır; orijinal içerikte etiket YOKTUR.
					// Etiket ORİJİNAL makaleye bağlanır: okuyucu çevirinin
					// kaynağını tek tıkla görebilmeli.
					if v.CeviriEtiketi != "" {
						if v.CeviriHref != "" {
							<a class="cd-ceviri" href={ v.CeviriHref } aria-label={ v.Dil.CeviriIpucu }>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none"
									stroke="currentColor" stroke-width="1.6" aria-hidden="true"
									focusable="false"><path d="M4 5h9M8.5 3v2c0 4-2 7-5 8"></path>
									<path d="M6 11c1.5 2.5 3.5 4 6 5"></path>
									<path d="M13 21l4-10 4 10M14.5 17.5h5"></path></svg>
								{ v.CeviriEtiketi }
							</a>
						} else {
							<span class="cd-ceviri">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none"
									stroke="currentColor" stroke-width="1.6" aria-hidden="true"
									focusable="false"><path d="M4 5h9M8.5 3v2c0 4-2 7-5 8"></path>
									<path d="M6 11c1.5 2.5 3.5 4 6 5"></path>
									<path d="M13 21l4-10 4 10M14.5 17.5h5"></path></svg>
								{ v.CeviriEtiketi }
							</span>
						}
					}

										// Eylem şeridi: üç pill (spec §10.2.3), hepsi 32 px.
					<div class="cd-aksiyon">
						<span class="cd-pill">
							<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
								focusable="false"><circle cx="8" cy="8" r="6" fill="none"
								stroke="currentColor" stroke-width="1.5"/><path d="M8 4.5V8l2.5 1.5"
								stroke="currentColor" stroke-width="1.5" fill="none"
								stroke-linecap="round"/></svg>
							{ cdOkumaMetni(v.ReadMinutes) }
						</span>
						<details class="cd-paylas">
							<summary class="cd-pill cd-pill--duz">Paylaş</summary>
							<div class="cd-paylas__liste">
								<a href={ templ.SafeURL(v.ShareX) } rel="nofollow noopener" target="_blank">X'te paylaş</a>
								<a href={ templ.SafeURL(v.ShareWhatsApp) } rel="nofollow noopener" target="_blank">WhatsApp'ta paylaş</a>
								<a href={ templ.SafeURL(v.ShareLinkedIn) } rel="nofollow noopener" target="_blank">LinkedIn'de paylaş</a>
							</div>
						</details>
												// "Preferred on Google" — CoinDesk makale sayfasındaki
						// hap düğme (ölçüm 7 Kasım 2026: 319×32, radius 9999,
						// 1 px #d9d9d9, pad 4×12, satıra SAĞA yaslı).
						// Yalnız ≥1024 px'te görünür (CoinDesk `hidden
						// lg:inline-flex`): dar ekranda satır taşıyordu.
						<a class="cd-pill cd-google"
							href="https://www.google.com/preferences/source?q=bitcosar.com"
							rel="noopener" target="_blank"
							aria-label="Google'da bizi tercih edin">
							// Düğmenin başındaki işaret SİTENİN KENDİ markası.
							// Öncelik: panelden yüklenen simge → yazı görseli →
							// gömülü marka işareti. Hiçbiri yoksa düğme logosuz
							// kalmaz; metin tek başına da anlamlı.
							if v.Shell.LogoSimgeURL != "" {
								<img class="cd-google__logo cd-google__logo--simge"
									src={ v.Shell.LogoSimgeURL } alt=""
									aria-hidden="true" decoding="async"/>
							} else if v.Shell.LogoURL != "" {
								<img class="cd-google__logo" src={ v.Shell.LogoURL }
									alt="" aria-hidden="true" decoding="async"/>
							} else {
								<span class="cd-google__simge" aria-hidden="true">
									@cdBasSimge()
								</span>
							}
							<span class="cd-google__metin">'ı Google'da tercih edilen yap</span>
						</a>
					</div>

					if v.Image != "" {
						<figure class="cd-article__cover">
							if cdKgOlcekli(v.Image) {
								<img src={ cdKgSrc(v.Image, YuvaMakaleKapak) }
									srcset={ cdKgSrcset(v.Image, YuvaMakaleKapak) }
									sizes={ cdKgSizes(YuvaMakaleKapak) } alt={ v.ImageAlt }
									referrerpolicy="no-referrer" loading="eager"
									fetchpriority="high"/>
							} else {
								<img src={ v.Image } alt={ v.ImageAlt } referrerpolicy="no-referrer"
									loading="eager" fetchpriority="high"/>
							}
							if v.ImageCredit != "" {
								<figcaption>{ v.ImageCredit }</figcaption>
							}
						</figure>
					}

										// Özet kutusu — CoinDesk deseni (ölçüldü, 8 Kasım 2026).
					// Kaynak HTML: gradient sarmalayıcı (7 px, 2 px dolgu)
					// → beyaz iç kutu (5 px, pad 20/20/12) → başlık satırı
					// (sparkle ikon + "Summary" w500 solda, "Show" + chevron
					// sağda, mb 16) → önizleme (TEK satır, `truncate`).
					// YAPI KRİTİK: `<summary>` HTML'de `<details>`in
					// DOĞRUDAN çocuğu olmak zorunda. Eski sürüm onu
					// `<div class="cd-ozet__ic">` içine koyuyordu;
					// tarayıcı geçersiz summary'yi yok sayıp yerine
					// "Details" yazıyordu (ekran görüntüsünde görüldü).
					if v.Summary != "" {
						<details class="cd-ozet">
							<summary class="cd-ozet__ic">
								<span class="cd-ozet__ust">
									<span class="cd-ozet__etiket">
										<svg class="cd-ozet__ikon" width="16" height="16" viewBox="0 0 15 15"
											fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
											<path d="M14.6995 3.69629L14.6057 3.70215C12.8348 3.80889 11.4173 5.22624 11.3108 6.99707L11.3049 7.09082H11.1038L11.0979 6.99707C10.9912 5.22626 9.57349 3.80896 7.80298 3.70215L7.70923 3.69629V3.49512L7.80298 3.48926C9.57373 3.38216 10.9911 1.96507 11.0979 0.194336L11.1038 0.100586H11.3049L11.3108 0.194336C11.4176 1.96511 12.8349 3.38224 14.6057 3.48926L14.6995 3.49512V3.69629Z" fill="currentColor" stroke="currentColor" stroke-width="0.2"></path>
											<path d="M0 14.8005V13.4706H7.80945V14.8005H0ZM0 11.4758V10.146H12.2235V11.4758H0ZM0 8.15116V6.82129H7.80945V8.15116H0Z" fill="currentColor"></path>
										</svg>
										<span>Özet</span>
									</span>
									<span class="cd-ozet__degistir">
										<span class="cd-ozet__ac">Göster</span>
										<span class="cd-ozet__kapat">Gizle</span>
										<svg class="cd-ozet__ok" width="16" height="16" viewBox="0 0 24 24"
											fill="currentColor" aria-hidden="true" focusable="false">
											<path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"></path>
										</svg>
									</span>
								</span>
								<span class="cd-ozet__onizleme">{ v.SummaryIlkSatir }</span>
							</summary>
							<div class="cd-ozet__govde">
								<ul>
									for _, m := range v.SummaryMaddeler {
										<li>{ m }</li>
									}
								</ul>
							</div>
						</details>
					}

					<div class="cd-article__body">
						@templ.Raw(v.BodyHTML)
					</div>

					// ABONELİK KİLİDİ: gövde yukarıda kesildi, devamı burada
					// isteniyor. Kutu gövdenin hemen ardında duruyor ki
					// kesilen metinle arasında kopukluk olmasın.
					if v.Kilitli {
						<aside class="cd-kilit" aria-labelledby="cd-kilit-bas">
							<span class="cd-kilit__rozet">Abonelere özel</span>
							<h2 class="cd-kilit__baslik" id="cd-kilit-bas">Yazının devamı abonelere açık</h2>
							if v.KilitKatman != "" {
								<p class="cd-kilit__metin">
									Bu içeriği okumak için <strong>{ v.KilitKatman }</strong> ve üzeri bir aboneliğiniz olması gerekiyor.
								</p>
							} else {
								<p class="cd-kilit__metin">Bu içeriği okumak için aboneliğiniz olması gerekiyor.</p>
							}
							<div class="cd-kilit__eylem">
								<a class="cd-kilit__btn cd-kilit__btn--birincil" href="/abonelik">Abonelik seçeneklerine bak</a>
								<a class="cd-kilit__btn" href="/giris?redirect=abonelik">Zaten aboneyim, giriş yap</a>
							</div>
						</aside>
					}

										// Kaynak atfı: toplayıcı sitede ZORUNLU ve görünür
					if v.SourceName != "" {
						<div class="cd-source">
							<strong>Kaynak:</strong>
							if v.SourceURL != "" {
								<a href={ v.SourceURL } rel="nofollow noopener" target="_blank">{ v.SourceName }</a>
							} else {
								<span>{ v.SourceName }</span>
							}
							<span> — bu içerik özet ve atıf ile sunulur; tam metin kaynağındadır.</span>
						</div>
					}

										// TEPKİ ÇUBUĞU: tek tıkla geri bildirim. Üyelik
					// istemez; JS kapalıysa `hidden` kalır ve çalışmayan
					// düğme gösterilmez. Yorum bölümünden önce gelen
					// düşük sürtünmeli adım.
					if v.ContentID != "" {
						<div class="cd-tepki" data-tepki={ v.ContentID } hidden>
							<span class="cd-tepki__soru">Bu haber işine yaradı mı?</span>
							<span class="cd-tepki__dugmeler">
								<button type="button" class="cd-tepki__dugme" data-yon="fazla" aria-pressed="false">
									Evet, işime yaradı
								</button>
								<button type="button" class="cd-tepki__dugme" data-yon="az" aria-pressed="false">
									Pek değil
								</button>
							</span>
							<span class="cd-tepki__tesekkur" data-tepki-tesekkur hidden>
								Teşekkürler — bu geri bildirim önerilerimizi düzeltiyor.
							</span>
						</div>
					}

					if len(v.Tags) > 0 {
						<div class="cd-tags">
							for _, t := range v.Tags {
								<a class="cd-tag" href={ "/tag/" + t.Slug }>{ t.Ad }</a>
							}
						</div>
					}

										// Yazar kutusu + editör politikası (E-E-A-T sinyali).
					// CoinDesk'te makale altında "Disclosure" kutusu var;
					// toplayıcı sitede karşılığı KAYNAK + ŞEFFAFLIK kutusu.
					<div class="cd-yazar">
						<strong>{ v.Author }</strong>
						<p>
							Bu içerik, kaynağında yayımlanan haberin özetidir; tam metin
							kaynağa aittir ve yukarıda bağlantısı verilmiştir. Düzeltme
							talepleri için <a href="/iletisim">iletişim</a>.
						</p>
					</div>
				</article>

				if len(v.Related) > 0 {
					<section class="cd-mod">
						@cdSectionHead("İlgili Haberler", v.SectionHref)
						<div class="cd-grid cd-grid--3">
							for _, s := range v.Related {
								@cdCard(s, false, YuvaKart)
							}
						</div>
					</section>
				}

								// Sayfalama YALNIZ iki uçtan biri varsa basılır: boş `<nav>`
				// kendi dış boşluğunu (32 px üst / 8 px alt) yine yazıyor
				// ve makale sonunda 40 px ölü alan bırakıyordu (mobilde
				// ölçüldü: nav 358×0, margin 32 0 8).
				if v.PrevHref != "" || v.NextHref != "" {
					<nav class="cd-pager" aria-label="Haber gezinmesi">
						if v.PrevHref != "" {
							<a class="cd-btn cd-btn--ghost" href={ v.PrevHref }>← { v.PrevTitle }</a>
						}
						if v.NextHref != "" {
							<a class="cd-btn cd-btn--ghost" href={ v.NextHref }>{ v.NextTitle } →</a>
						}
					</nav>
				}
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}


