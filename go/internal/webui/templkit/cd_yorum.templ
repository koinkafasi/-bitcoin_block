package templkit

// Makale yorum bölümü.
//
// JS YOK: form düz POST ile /yorum/{id}'ye gidiyor, beğeni de kendi
// formuyla. Yorum okumak ve yazmak için betik beklemek gerekmiyor.
//
// SIFIR YORUMDA sayı yazılmaz; doğrudan davet basılır.

templ cdYorumBolumu(v CDYorumBolumu, dil string) {
	if v.Acik {
		<section class="cd-yorum" id="yorumlar" aria-labelledby="cd-yorum-bas">
			<div class="cd-yorum__bas">
				<h2 class="cd-yorum__baslik" id="cd-yorum-bas">
					if v.Sayi > 0 {
						<span class="cd-vurgu">{ cdYorumBaslik(v.Sayi) }</span>
					} else {
						<span class="cd-vurgu">Yorumlar</span>
					}
				</h2>
			</div>

			if v.UyeGirisli {
				<form class="cd-yorum__form" method="post" action={ "/yorum/" + v.ContentID }>
					<label class="cd-yorum__etiket" for="cd-yorum-metin">
						{ cdYorumFormBasligi(v.UyeAdi) }
					</label>
					<textarea class="cd-yorum__alan" id="cd-yorum-metin" name="metin" rows="3"
						required maxlength="2000"
						placeholder={ cdT(dil, "Bu yazı hakkında ne düşünüyorsun?") }></textarea>
					<!-- Bot tuzağı: insan doldurmaz, bot doldurur. -->
					<input class="cd-yorum__tuzak" type="text" name="web" tabindex="-1" autocomplete="off" aria-hidden="true"/>
					<div class="cd-yorum__eylem">
						<span class="cd-yorum__not">{ cdT(dil, "Yorumlar yayımlanmadan önce okunur.") }</span>
						<button class="cd-yorum__gonder" type="submit">{ cdT(dil, "Gönder") }</button>
					</div>
				</form>
			} else {
				<div class="cd-yorum__davet">
					<p class="cd-yorum__davet-metin">
						if v.Sayi > 0 {
							Tartışmaya katılmak için giriş yap.
						} else {
							İlk yorumu sen yaz.
						}
					</p>
					<div class="cd-yorum__davet-eylem">
						<a class="cd-yorum__btn cd-yorum__btn--birincil" href="/giris?redirect=yorum">{ cdT(dil, "Giriş yap") }</a>
						<a class="cd-yorum__btn" href="/kayit">{ cdT(dil, "Üye ol") }</a>
					</div>
				</div>
			}

			if len(v.Yorumlar) > 0 {
				<ol class="cd-yorum__liste">
					for _, y := range v.Yorumlar {
						<li class="cd-yorum__oge">
							@cdYorumKarti(y, v.UyeGirisli, dil)
							if len(y.Yanitlar) > 0 {
								<ol class="cd-yorum__yanitlar">
									for _, c := range y.Yanitlar {
										<li class="cd-yorum__oge cd-yorum__oge--yanit">
											@cdYorumKarti(c, v.UyeGirisli, dil)
										</li>
									}
								</ol>
							}
						</li>
					}
				</ol>
			}
		</section>
	}
}

templ cdYorumKarti(y CDYorum, uyeGirisli bool, dil string) {
	<article class="cd-yorum__kart">
		<div class="cd-yorum__kimlik">
			<span class="cd-yorum__harf" aria-hidden="true">{ y.BasHarf }</span>
			<span class="cd-yorum__ad">{ y.Ad }</span>
			<time class="cd-yorum__zaman">{ y.Zaman }</time>
		</div>
		<p class="cd-yorum__metin">{ y.Metin }</p>
		if uyeGirisli {
			<form class="cd-yorum__begeni" method="post" action={ "/yorum/" + y.ID + "/begen" }>
				<button class="cd-yorum__begeni-btn" type="submit" aria-label={ cdT(dil, "Bu yoruma katılıyorum") }>
					Katılıyorum
					if y.Begeni > 0 {
						<span class="cd-yorum__sayi">{ cdSayi(y.Begeni) }</span>
					}
				</button>
			</form>
		} else {
			if y.Begeni > 0 {
				<span class="cd-yorum__begeni-salt">{ cdBegeniMetni(y.Begeni) }</span>
			}
		}
	</article>
}
