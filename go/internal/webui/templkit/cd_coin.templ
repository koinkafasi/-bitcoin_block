package templkit

// Tek varlık fiyat sayfası (/price/{coin}).

// CDCoinPage /price/{coin} verisi.
type CDCoinPage struct {
	Shell     CDShell
	Title     string
	Desc      string
	Canonical string
	Sym       string
	Name      string
	Rank      int
	Price     string
	Change    string
	Up        bool
	Others    []CDPriceRow
	// Grafik + zincir-üstü metrikler (CryptoQuant, gerçek veri).
	// Veri yoksa nil/boş kalır ve modüller hiç basılmaz.
	Grafik *CDGrafikKart
	Zincir []CDGrafikKart
	JSONLD    string
	BaseURL   string
	// CoinDesk SEO sınıflandırması (bkz. templkit.CDHead).
	PageCategory    string
	ContentCategory string
	Locale          string
}

templ CDCoinPageView(v CDCoinPage) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", SiteName: v.Shell.SiteName, RSSFeed: "/rss.xml",
				JSONLD: v.JSONLD, Locale: v.Locale, PageCategory: v.PageCategory,
				ContentCategory: v.ContentCategory, BaseURL: v.BaseURL})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap">
				<nav class="cd-crumbs" aria-label="Konum">
					<a href="/">Ana sayfa</a>
					<span>/</span>
					<a href="/price">Fiyatlar</a>
				</nav>
				<header class="cd-coin-head">
					<h1>{ v.Name } <span class="cd-coin-sym">{ v.Sym }</span></h1>
					<!-- data-cg-coin*: canlı akış bu sayfanın fiyatını da
					     tazeler (cd-canli.js); varlık sembolüyle eşleşir. -->
					<div class="cd-coin-price">
						<strong data-cg-coin-fiyat={ v.Sym }>{ v.Price }</strong>
						if v.Up {
							<span class="cd-up" data-cg-coin-degisim>{ v.Change }</span>
						} else {
							<span class="cd-down">{ v.Change }</span>
						}
						<span class="cd-card__meta">· 24s · piyasa sırası #{ v.Rank }</span>
					</div>
				</header>

				<!-- FİYAT GRAFİĞİ: yalnız gerçek OHLCV varsa (CryptoQuant).
				     Veri yoksa modül hiç basılmaz — uydurma çizgi yok. -->
				if v.Grafik != nil {
					<section class="cd-mod">
						@cdSectionHead("Fiyat grafiği", "")
						@cdGrafikKartPanel(*v.Grafik)
					</section>
				}
				if len(v.Zincir) > 0 {
					<section class="cd-mod">
						@cdSectionHead("Zincir üstü metrikler", "")
						<div class="cd-grafik-izgara">
							for _, k := range v.Zincir {
								@cdGrafikKartPanel(k)
							}
						</div>
						<p class="cd-grafik-kaynak">Kaynak: CryptoQuant · borsa akışları Binance ·
							günlük veri · 10 dakika önbellek</p>
					</section>
				}

				<section class="cd-mod">
					@cdSectionHead("Diğer varlıklar", "/price")
					@cdPriceTable("", v.Others)
				</section>
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}
