package templkit

// Mega menünün bağlandığı ek sayfalar (CoinDesk §4):
//   /videos  /podcasts  /newsletters  /sponsored-content
//
// NEDEN TEK DOSYA: bu dördü aynı yapıyı paylaşır (kabuk + başlık + kart
// listesi/boş durum). Ayrı dosyalara bölmek aynı kodu dörde çıkarırdı.
//
// BOŞ DURUM DÜRÜST: içerik yoksa "henüz yayınlanmadı" yazar. Uydurma
// kart göstermek, menüye 404 koymakla aynı hatadır.

// CDListePage basit liste sayfası verisi (video, podcast, sponsorlu).
type CDListePage struct {
	Shell     CDShell
	Title     string
	Desc      string
	Canonical string
	Baslik    string
	Aciklama  string
	Stories   []CDStory
	// BosMetin içerik yokken gösterilecek dürüst açıklama.
	BosMetin string
	// JSONLD Go tarafında üretilmiş yapısal veri.
	JSONLD string
	// CoinDesk SEO sınıflandırması (bkz. templkit.CDHead).
	PageCategory    string
	ContentCategory string
	Locale          string
	// BaseURL og:image mutlaklaştırması için kök adres.
	BaseURL string
}

templ CDListePageView(v CDListePage) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", SiteName: v.Shell.SiteName, FaviconURL: v.Shell.FaviconURL, RSSFeed: "/rss.xml",
				JSONLD: v.JSONLD, Locale: v.Locale, PageCategory: v.PageCategory, BaseURL: v.BaseURL,
				ContentCategory: v.ContentCategory})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap">
				<header class="cd-section-title">
					<h1>{ v.Baslik }</h1>
					<p class="cd-card__spot">{ v.Aciklama }</p>
				</header>
				if len(v.Stories) > 0 {
					<section class="cd-mod">
						<div class="cd-grid cd-grid--3">
							for _, s := range v.Stories {
								@cdCard(s, false, YuvaKart)
							}
						</div>
					</section>
				} else {
					<div class="cd-bos">
						<p>{ v.BosMetin }</p>
					</div>
				}
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}

// CDNewsletterPage bülten sayfası: liste + kayıt formu.
type CDNewsletterPage struct {
	Shell     CDShell
	Title     string
	Desc      string
	Canonical string
	JSONLD    string
	// CoinDesk SEO sınıflandırması (bkz. templkit.CDHead).
	PageCategory    string
	ContentCategory string
	Locale          string
	// BaseURL og:image mutlaklaştırması için kök adres.
	BaseURL string
}

templ CDNewsletterPageView(v CDNewsletterPage) {
	<!doctype html>
	<html lang="tr">
		<head>
			@cdHead(CDHead{Title: v.Title, Desc: v.Desc, Canonical: v.Canonical,
				OGType: "website", SiteName: v.Shell.SiteName, FaviconURL: v.Shell.FaviconURL, RSSFeed: "/rss.xml",
				JSONLD: v.JSONLD, Locale: v.Locale, PageCategory: v.PageCategory, BaseURL: v.BaseURL,
				ContentCategory: v.ContentCategory})
		</head>
		<body class="cd">
			@cdTopbar(v.Shell)
			@cdTicker(v.Shell)
			<main class="cd-wrap">
				<header class="cd-section-title">
					<h1>Bültenler</h1>
					<p class="cd-card__spot">Günün kripto haberleri ve piyasa özeti, her sabah e-postanızda.</p>
				</header>
				@cdNewsletter()
				<section class="cd-mod">
					@cdSectionHead("Bülten arşivi", "/ping")
					<p class="cd-card__spot">
						Gönderilen bültenlerin arşivi <a href="/ping">günlük özet arşivinde</a>.
					</p>
				</section>
			</main>
			@cdFooter(v.Shell)
		</body>
	</html>
}
