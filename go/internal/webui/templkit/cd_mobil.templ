package templkit

// Mobil gezinme — CoinDesk'in JS'siz (no-JS) hamburger menüsü.
//
// ÖLÇÜM (coindesk.com, 390×844, iPhone UA, JavaScript KAPALI — 9 Kasım
// 2026): CoinDesk JS açıkken kayan panelli bir menü, JS kapalıyken
// `<details name="cd-nav-section">` akordiyonu basıyor. Bizim ilkemiz
// JS'siz çalışmak olduğu için **CoinDesk'in kendi no-JS menüsü** birebir
// alındı:
//
//   panel        : header'ın altından (top 56), tam genişlik, beyaz,
//                  gölge, max-h calc(100vh - 56px), dikey kaydırma
//   iç dolgu     : 16 px (alt 192 px — CoinDesk pb-48)
//   satır        : 64 px; başlık 14/32 w700, x=32
//   chevron      : 24×24, sağda 40 px kutuda, DÖNMEZ (ölçüldü)
//   alt bağlantı : 14/32 w400, dolgu 16 0 16 24 → 64 px satır
//   ayraç        : tam genişlik 1 px `--cd-border`
//   alt blok     : Dil · Tema · Kaydol/Oturum Aç (32 px aralık)
//
// Masaüstünde gizli, mobilde görünür. Masaüstü mega menü aynen kalır.

templ cdMobilNav(s CDShell) {
	<details class="cd-mobil" data-mobil-menu>
		<summary class="cd-mobil__dugme" aria-label="Menü">
			<!-- CoinDesk hamburger yolu (20×20 mobil, 24×24 md). -->
			<svg class="cd-mobil__ikon" viewBox="0 0 24 24" width="20" height="20"
				aria-hidden="true" focusable="false" fill="none">
				<path d="M3.5 17.6345V16.1347H20.5V17.6345H3.5ZM3.5 12.75V11.25H20.5V12.75H3.5ZM3.5 7.86523V6.36548H20.5V7.86523H3.5Z" fill="currentColor"/>
			</svg>
		</summary>
		<nav class="cd-mobil__panel" aria-label="Menü">
			<div class="cd-mobil__ic">
				<ul class="cd-mobil__liste">
					for _, g := range cdMobilAnaGruplar(s) {
						@cdMobilGrup(s, g)
					}
				</ul>
				if len(cdMobilMedyaGruplar(s)) > 0 {
					<div class="cd-mobil__ayrac" aria-hidden="true"></div>
					<ul class="cd-mobil__liste">
						for _, g := range cdMobilMedyaGruplar(s) {
							@cdMobilGrup(s, g)
						}
					</ul>
				}
				<div class="cd-mobil__ayrac" aria-hidden="true"></div>
				<div class="cd-mobil__alt-blok">
					<!-- DİL — CoinDesk "Language" satırı: 14/21 w500 etiket,
					     sağda hap (12/16 büyük harf, 1 px çerçeve, 9999
					     köşe). Tek dilde hap tıklanmaz (ölü menü yok);
					     çok dilde TÜM SATIR açılır (CoinDesk deseni). -->
					if len(s.Diller) > 1 {
						<details class="cd-mobil__dil">
							<summary class="cd-mobil__dil-ozet">
								<span class="cd-mobil__etiket">Dil</span>
								<span class="cd-mobil__dil-hap">
									for _, d := range s.Diller {
										if d.Aktif {
											<span>{ d.Kod }</span>
										}
									}
									<svg class="cd-mobil__dil-ok" viewBox="0 0 24 24" width="16" height="16"
										aria-hidden="true" focusable="false" fill="currentColor">
										<path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
									</svg>
								</span>
							</summary>
							<ul class="cd-mobil__dil-liste">
								for _, d := range s.Diller {
									<li>
										<a href={ templ.SafeURL(d.Href) }>
											{ d.Ad }
											<span class="cd-mobil__dil-kod">{ d.Kod }</span>
										</a>
									</li>
								}
							</ul>
						</details>
					} else {
						<div class="cd-mobil__dil">
							<span class="cd-mobil__etiket">Dil</span>
							for _, d := range s.Diller {
								<span class="cd-mobil__dil-hap cd-mobil__dil-hap--tek">{ d.Kod }</span>
							}
						</div>
					}
					<!-- TEMA — CoinDesk "Theme" satırı: sağda iki seçenekli
					     segment (zemin surface-subtle, seçili olan beyaz +
					     gölge). data-tema-deger csp-delegated.js'te işlenir;
					     JS yoksa düğmeler yalnız görünür, tema sistemi
					     yine prefers-color-scheme ile çalışır. -->
					<div class="cd-mobil__tema">
						<span class="cd-mobil__etiket" id="cd-mobil-tema">Tema</span>
						<div class="cd-mobil__tema-sec" role="radiogroup" aria-labelledby="cd-mobil-tema">
							<button class="cd-mobil__tema-dugme" type="button" role="radio"
								data-tema-deger="light" aria-checked="false" aria-label="Açık mod">
								<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
									focusable="false" fill="none" stroke="currentColor" stroke-width="2"
									stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="5"></circle>
									<line x1="12" y1="1" x2="12" y2="3"></line>
									<line x1="12" y1="21" x2="12" y2="23"></line>
									<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
									<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
									<line x1="1" y1="12" x2="3" y2="12"></line>
									<line x1="21" y1="12" x2="23" y2="12"></line>
									<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
									<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
								</svg>
							</button>
							<button class="cd-mobil__tema-dugme" type="button" role="radio"
								data-tema-deger="dark" aria-checked="false" aria-label="Koyu mod">
								<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
									focusable="false" fill="none" stroke="currentColor" stroke-width="2"
									stroke-linecap="round" stroke-linejoin="round">
									<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
								</svg>
							</button>
						</div>
					</div>
					<!-- OTURUM — CoinDesk sırası: önce çerçeveli kayıt düğmesi,
					     sonra marka sarısı oturum düğmesi; ikisi de tam
					     genişlik 48 px. (Etiket metinleri yoruma YAZILMAZ:
					     templ yorumları HTML çıktısına düşüyor ve oturum
					     kapısı testleri çıplak metin arıyor.) -->
					<div class="cd-mobil__oturum">
						if s.LoggedIn {
							<a class="cd-mobil__btn cd-mobil__btn--birincil" href={ s.UserHref }>Hesabım</a>
							<form class="cd-mobil__cikis" method="post" action="/cikis">
								<button class="cd-mobil__btn" type="submit">Çıkış</button>
							</form>
						} else {
							if s.SignupHref != "" {
								<a class="cd-mobil__btn" href={ s.SignupHref }>Kaydol</a>
							}
							if s.LoginHref != "" {
								<a class="cd-mobil__btn cd-mobil__btn--birincil" href={ s.LoginHref }>Oturum Aç</a>
							}
						}
					</div>
				</div>
			</div>
		</nav>
	</details>
}

// cdMobilGrup tek menü grubunu CoinDesk akordiyon satırı olarak basar.
//
// Sütunlar TEK listeye düzleştirilir (CoinDesk mobil menüsü de böyle):
// "baslik" tipi satırlar alt liste başlığı olur, bağlantılar 64 px satır.
templ cdMobilGrup(s CDShell, g CDMenuGroup) {
	if len(g.Columns) == 0 {
		<li class="cd-mobil__li">
			<a class="cd-mobil__duz" href={ templ.SafeURL(s.LangBase + g.Href) }>{ g.Label }</a>
		</li>
	} else {
		<li class="cd-mobil__li">
			<details name="cd-nav-section" class="cd-mobil__grup">
				<summary class="cd-mobil__grup-baslik">
					<span class="cd-mobil__grup-metin">
						<span class="cd-mobil__grup-ad">{ g.Label }</span>
					</span>
					<span class="cd-mobil__ok-kutu" aria-hidden="true">
						<svg class="cd-mobil__ok" viewBox="0 0 24 24" width="24" height="24"
							fill="none" focusable="false">
							<path d="M14.2924 12L9.69238 7.40001L10.4001 6.69226L15.7079 12L10.4001 17.3078L9.69238 16.6L14.2924 12Z" fill="currentColor"/>
						</svg>
					</span>
				</summary>
				<ul class="cd-mobil__alt">
					for _, sut := range g.Columns {
						for _, it := range sut.Items {
							if it.Kind == "baslik" {
								<li class="cd-mobil__alt-baslik">{ it.Label }</li>
							} else {
								<li class="cd-mobil__alt-li">
									<a href={ templ.SafeURL(s.LangBase + it.Href) }>{ it.Label }</a>
								</li>
							}
						}
					}
				</ul>
			</details>
		</li>
	}
}
