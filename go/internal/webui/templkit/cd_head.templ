package templkit

// CoinDesk sayfa başı (head) — TEK kaynak.
//
// Her sayfa bunu kullanır: <title>, meta description, canonical, hreflang,
// Open Graph, tema rengi, preconnect ve Organization/WebSite JSON-LD.
// Tekrar eden head bloğu, bir sayfada düzeltmenin diğerlerinde unutulması
// demekti (theblock'ta yaşandı).
//
// 7 Kasım 2026 — CoinDesk kaynak koduyla birebir hizalandı. Referans
// ölçümü: coindesk.com/ (ana sayfa), /policy (bölüm), /policy/2026/11/06/…
// (makale), /tag/tokenization (etiket), /author/krisztian-sandor (yazar),
// /price/bitcoin (varlık). O sayfalarda basılan meta/link seti burada.
//
// CoinDesk'ten BİLEREK alınmayanlar (uydurma veri olurdu):
//   - `fb:app_id`        → Facebook uygulama kimliğimiz yok
//   - `twitter:site`     → X hesabımız yok
//   - `apple-itunes-app` → mobil uygulamamız yok
//   - origin-trial meta'ları → reklam ağı denemeleri, bizde yok
//   - 15 dilli hreflang  → çevirisi OLMAYAN dil listelenmez (Google
//     "aynı içerik" cezası); CDHead.Hreflang yalnız gerçek çevirileri taşır.

// cdHead sayfa başı verisi.
type CDHead struct {
	Title     string
	Desc      string
	Canonical string
	// OGType "website" | "article".
	OGType string
	// Image sosyal paylaşım görseli (mutlak URL, boş olabilir).
	Image string
	// ImageAlt og:image:alt / twitter:image:alt (CoinDesk makalede basıyor).
	ImageAlt string
	// Hreflang gerçek çeviriler: dil kodu → mutlak URL. Boşsa YALNIZ
	// x-default basılır. Kural: çevirisi olmayan dil listelenmez
	// (Google "aynı içerik" cezası).
	Hreflang map[string]string
	// SiteName Organization adı.
	SiteName string
	// RSSFeed besleme adresi (göreli).
	RSSFeed string
	// NoIndex arama/sayfalama gibi dizine girmemesi gereken sayfalar.
	NoIndex bool
	// JSONLD Go tarafında üretilmiş yapısal veri bloğu (script etiketiyle
	// birlikte). templ script içeriğini ham saydığı için burada taşınır.
	JSONLD string
	// BreadcrumbJSONLD ikinci yapısal veri bloğu (BreadcrumbList). CoinDesk
	// makalede tek blok basıyor; Google iki ayrı bloğu da kabul ediyor ve
	// kırıntı yolu SERP'te yolu gösteriyor.
	BreadcrumbJSONLD string
	// FAQJSONLD üçüncü blok: gövdeden çıkarılmış FAQPage.
	FAQJSONLD string
	// LCPGorsel varsa <link rel="preload" as="image"> basılır.
	//
	// NEDEN: Lighthouse mobil profilinde LCP fazı TTFB + "load delay" +
	// "render delay" olarak ölçüldü (7 Kasım 2026): 450 + 942 + 1346 ms.
	// Load delay'in nedeni, manşet görselinin DOM'un ORTASINDA keşfedilmesi
	// ve o sırada 9 alt-katlama görselinin isteğe girmesi. Preload, tarayıcı
	// preload scanner'ının aynı srcset/sizes'ı CSS'ten ÖNCE görmesini sağlar.
	LCPGorsel *CDPreload
	// PageCategory CoinDesk `page_category` değeri: homepage,
	// section_landing_page, article_page, tag_page, author_page, price_page.
	PageCategory string
	// ContentCategory CoinDesk `content_category` değeri: homepage, policy,
	// tag, author, price …
	ContentCategory string
	// Locale içerik dili (`content_language`). Boşsa "tr".
	Locale string
	// Metas sayfaya özel ek <meta name content> satırları. CoinDesk makale
	// sayfasında Arc/Parse.ly analitik setini basıyor; aynı anahtarlar
	// buradan geçiyor (bkz. cdMakaleMetas).
	Metas []CDMeta
	// BaseURL göreli görsel yolunu og:image için mutlaklaştırır.
	BaseURL string
	// FaviconURL panelden yüklenen favicon (/media/... ya da /static/...).
	//
	// NEDEN GEREKLİ (kullanıcı bildirimi, 11 Kasım 2026: "favicon svg
	// yükledim ama browserda göstermedi"): aşağıdaki <link rel="icon">
	// satırları SABİT yazılıydı; yüklenen dosya hiçbir yerde kullanılmıyordu.
	// Doluysa yüklenen kullanılır, boşsa gömülü simgelere düşülür.
	FaviconURL string
	// EkCSS sayfaya özel ek stil dosyaları (/static/... yolu).
	//
	// NEDEN: cd.css 200 KB bütçeye tabi (cd_tasarim_test.go). Ana sayfa
	// giriş hero'sunun ~9 KB'ı oraya eklenirse bütçe aşılırdı; hero
	// yalnız ana sayfada basıldığı için stil de yalnız orada yükleniyor.
	EkCSS []string
	// EkJS sayfaya özel ek betikler (/static/... yolu, defer ile).
	//
	// CSP `script-src 'self'`: yalnız kendi origin'imizden. Ana sayfa
	// hero'sunun canlı yoklaması bu yolla yükleniyor.
	EkJS []string
}

// CDMeta tek bir `<meta name="…" content="…">` satırı.
type CDMeta struct {
	Name    string
	Content string
}

// CDPreload önceden yüklenecek görsel (srcset/sizes ile birebir aynı).
type CDPreload struct {
	Src    string
	Srcset string
	Sizes  string
}

// templ func: haritayı sıralı basmak için sabit dil sırası.
var cdDilSirasi = []string{"tr", "en", "de", "es", "ru", "fr", "ar"}

templ cdHead(h CDHead) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ h.Title }</title>
	<meta name="description" content={ h.Desc }/>
		// CoinDesk robot yönergesi: zengin önizleme izinleri AÇIK
	// (max-image-preview:large). Eksikken Google Haber kartları küçük
	// görselle çıkıyordu. noindex sayfalarında bunun yerine robots
	// satırı basılır — ikisi birlikte çelişkili sinyal olurdu.
	if h.NoIndex {
		<meta name="robots" content="noindex,follow"/>
	} else {
		<meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"/>
	}
		// CoinDesk'in sayfa sınıflandırma seti (ölçüldü: tüm şablonlarda
	// var). Reklam/analitik hedeflemesinin yanında `page_url` kanonik
	// adresin ikinci beyanıdır.
	<meta name="page_url" content={ h.Canonical }/>
	<meta name="media_type" content="html"/>
	if h.PageCategory != "" {
		<meta name="page_category" content={ h.PageCategory }/>
	}
	if h.ContentCategory != "" {
		<meta name="content_category" content={ h.ContentCategory }/>
	}
	<meta name="content_language" content={ cdDil(h.Locale) }/>
	<link rel="canonical" href={ h.Canonical }/>
		// LCP görselini MÜMKÜN OLAN EN ERKEN anda başlat. `imagesrcset` ve
	// `imagesizes`, <img> ile BİREBİR aynı olmalı; farklı olursa tarayıcı
	// iki ayrı aday sayar ve aynı görsel iki kez indirilir.
	if h.LCPGorsel != nil && h.LCPGorsel.Src != "" {
		if h.LCPGorsel.Srcset != "" {
			<link rel="preload" as="image" href={ h.LCPGorsel.Src }
				imagesrcset={ h.LCPGorsel.Srcset } imagesizes={ h.LCPGorsel.Sizes } fetchpriority="high"/>
		} else {
			<link rel="preload" as="image" href={ h.LCPGorsel.Src } fetchpriority="high"/>
		}
	}
	<meta name="theme-color" content="#f3f1e9" media="(prefers-color-scheme: light)"/>
	<meta name="theme-color" content="#0a0b0e" media="(prefers-color-scheme: dark)"/>

		// hreflang: yalnız GERÇEK çeviriler + x-default
	for _, dil := range cdDilSirasi {
		if url, ok := h.Hreflang[dil]; ok && url != "" {
			<link rel="alternate" hreflang={ dil } href={ url }/>
		}
	}
	// x-default: dil eşleşmesi kurulamayan ziyaretçinin gideceği sürüm.
	// Tüm dil sürümlerinde AYNI adresi göstermeli — sitenin ana dili
	// Türkçe olduğu için TR sürümü. Eskiden her sayfa kendi kanonik
	// adresini basıyordu: İngilizce sayfa x-default'u kendisi diye
	// bildiriyor, Türkçe sayfa da kendisi diyordu (çelişki).
	<link rel="alternate" hreflang="x-default" href={ cdXDefault(h) }/>

	<meta property="og:site_name" content={ h.SiteName }/>
	<meta property="og:locale" content={ cdOGDil(h.Locale) }/>
	if h.OGType == "article" {
		<meta property="og:type" content="article"/>
	} else {
		<meta property="og:type" content="website"/>
	}
	<meta property="og:title" content={ h.Title }/>
	<meta property="og:description" content={ h.Desc }/>
	<meta property="og:url" content={ h.Canonical }/>
	if h.Image != "" {
		<meta property="og:image" content={ cdMutlak(h.Image, h.BaseURL) }/>
				// Ölçü etiketleri: Facebook/X görseli kırpmadan önce boyutu
		// bilir; eksikse kart düzeni sıçrar (CoinDesk 1200×675 basıyor).
		<meta property="og:image:width" content="1200"/>
		<meta property="og:image:height" content="675"/>
		if h.ImageAlt != "" {
			<meta property="og:image:alt" content={ h.ImageAlt }/>
		}
	}
	<meta name="twitter:card" content="summary_large_image"/>
	<meta name="twitter:title" content={ h.Title }/>
	<meta name="twitter:description" content={ h.Desc }/>
	if h.Image != "" {
		<meta name="twitter:image" content={ cdMutlak(h.Image, h.BaseURL) }/>
		if h.ImageAlt != "" {
			<meta name="twitter:image:alt" content={ h.ImageAlt }/>
		}
		<meta name="twitter:image:width" content="1200"/>
		<meta name="twitter:image:height" content="675"/>
	}

		// Sayfaya özel makine-okur alanlar (CoinDesk Arc/Parse.ly seti)
	for _, m := range h.Metas {
		if m.Name != "" && m.Content != "" {
			<meta name={ m.Name } content={ m.Content }/>
		}
	}

		// Görsel CDN'lerine erken bağlantı: LCP'yi ~50-100 ms iyileştirir
	<link rel="preconnect" href="https://cdn.sanity.io" crossorigin="anonymous"/>
	<link rel="preconnect" href="https://assets.coingecko.com" crossorigin="anonymous"/>

		// İkonlar. favicon.ico birçok tarayıcı ve bot tarafından KÖKTEN
	// istenir; bağlantı verilmezse her sayfa yüklemesinde 404 üretir
	// (ölçüldü, 6 Kasım 2026: tek 404 kaynağı buydu). SVG + PNG birlikte
	// veriliyor: SVG modern tarayıcıda keskin, PNG eski/bot yolunda.
	if h.FaviconURL != "" {
				// YÜKLENEN FAVICON. `sizes="any"` SVG'ye özgü: tarayıcıya
		// "her ölçekte geçerli" der. PNG yolunu da bırakıyoruz çünkü
		// bazı bot/eski tarayıcılar SVG favicon'u yok sayar ve o
		// durumda gömülü PNG devreye girer (404 üretmez).
		<link rel="icon" href={ h.FaviconURL } sizes="any"/>
		<link rel="icon" href="/static/icon-192.png" sizes="192x192" type="image/png"/>
		<link rel="apple-touch-icon" href={ h.FaviconURL }/>
	} else {
		<link rel="icon" href="/static/icon-192.png" sizes="192x192" type="image/png"/>
		<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
		<link rel="icon" href="/static/icon-512.png" sizes="512x512" type="image/png"/>
		<link rel="apple-touch-icon" href="/static/icon-192.png"/>
	}
	<link rel="manifest" href="/manifest.webmanifest"/>
		// WebSub hub: yayın bildirimi (CoinDesk de `rel="hub"` basıyor).
	// Google/Bing beslemeyi bu uçtan anında öğrenir.
	if h.RSSFeed != "" {
		<link rel="alternate" type="application/rss+xml" title={ h.SiteName + " RSS" } href={ h.RSSFeed }/>
		<link rel="self" type="application/rss+xml" href={ h.RSSFeed }/>
	}
	<link rel="hub" href="https://pubsubhubbub.appspot.com/"/>

	<link rel="stylesheet" href={ "/static/cd.css?v=" + cdVarlik() }/>
		// Mega menü: cd.css'in üstüne biner, kendi jetonunu tanımlamaz.
	<link rel="stylesheet" href={ "/static/cd-menu.css?v=" + cdVarlik() }/>
	for _, ek := range h.EkCSS {
		<link rel="stylesheet" href={ ek + "?v=" + cdVarlik() }/>
	}
		// CSP uyumlu delege dinleyiciler (data-* öznitelikleri)
	<script src={ "/static/csp-delegated.js?v=" + cdVarlik() } defer></script>
	for _, ek := range h.EkJS {
		<script src={ ek + "?v=" + cdVarlik() } defer></script>
	}
		// CANLI PİYASA (11 Kasım 2026): üst şerit HER sayfada olduğu için
	// betik de her sayfada. Akış yalnız sayfada canlı yüzey varsa açılır
	// (cd-canli.js ilk satırda kendini kontrol eder).
	<script src={ "/static/cd-canli.js?v=" + cdVarlik() } defer></script>
		// CANLI PİYASA (11 Kasım 2026): üst şerit HER sayfada olduğu için
	// betik de her sayfada. Akış yalnız sayfada canlı yüzey varsa açılır
	// (cd-canli.js ilk satırda kendini kontrol eder).
	<script src={ "/static/cd-canli.js?v=" + cdVarlik() } defer></script>
		// Tema başlangıcı — BLOKLAYICI ve head'de olmalı: gövde boyanmadan
	// önce html sınıfı yazılmazsa koyu tema seçen kullanıcı bir kare
	// beyaz görür (FOUC). CSP satır içi betiğe izin veriyor çünkü
	// buildCSP her satır içi bloğun sha256'sını başlığa ekliyor;
	// 'unsafe-inline' gerekmiyor.
	// DİKKAT: bu yorumda bilerek "script" etiketi YAZILMIYOR. CSP
	// tarayıcısı yorum içindeki etiket metnini atlıyor (htmlYorumAtla)
	// ama yorumu temiz tutmak ikinci savunma katmanı.
	<script>
		(function () {
			try {
				var t = localStorage.getItem('tema');
				var koyu = t === 'dark' || (t !== 'light' &&
					window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.className = koyu ? 'dark' : 'light';
				document.documentElement.classList.add('cd-js');
			} catch (e) {
				/* localStorage kapalı (gizli mod): medya sorgusu devralır. */
			}
		})();
	</script>
		// Organization + WebSite: templ script içini ham saydığı için Go'da üretilir
	@templ.Raw(h.JSONLD)
	if h.BreadcrumbJSONLD != "" {
		@templ.Raw(h.BreadcrumbJSONLD)
	}
	if h.FAQJSONLD != "" {
		@templ.Raw(h.FAQJSONLD)
	}
}

// cdDil içerik dilini normalize eder.
func cdDil(locale string) string {
	if locale == "" {
		return "tr"
	}
	return locale
}

// cdOGDil Open Graph locale biçimi (dil_BÖLGE).
func cdOGDil(locale string) string {
	switch cdDil(locale) {
	case "tr":
		return "tr_TR"
	case "en":
		return "en_US"
	case "de":
		return "de_DE"
	case "es":
		return "es_ES"
	case "ru":
		return "ru_RU"
	case "fr":
		return "fr_FR"
	case "ar":
		return "ar_AR"
	}
	return cdDil(locale)
}
