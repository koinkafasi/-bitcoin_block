package templkit

// CoinDesk sayfa başı (head) — TEK kaynak.
//
// Her sayfa bunu kullanır: <title>, meta description, canonical, hreflang,
// Open Graph, tema rengi, preconnect ve Organization/WebSite JSON-LD.
// Tekrar eden head bloğu, bir sayfada düzeltmenin diğerlerinde unutulması
// demekti (theblock'ta yaşandı).

// cdHead sayfa başı verisi.
type CDHead struct {
	Title     string
	Desc      string
	Canonical string
	// OGType "website" | "article".
	OGType string
	// Image sosyal paylaşım görseli (mutlak URL, boş olabilir).
	Image string
	// Hreflang gerçek çeviriler: dil kodu → mutlak URL. Boşsa YALNIZ
	// x-default basılır. Kural: çevirisi olmayan dil listelenmez
	// (Google "aynı içerik" cezası).
	Hreflang map[string]string
	// SiteName Organization adı.
	SiteName string
	// RSSFeed besleme adresi (göreli).
	RSSFeed string
	// NoIndex arama/sayfalama gibi dizine girmemesi gereken sayfalar.
	NoIndex bool
	// JSONLD Go tarafında üretilmiş yapısal veri bloğu (script etiketiyle
	// birlikte). templ script içeriğini ham saydığı için burada taşınır.
	JSONLD string
	// LCPGorsel varsa <link rel="preload" as="image"> basılır.
	//
	// NEDEN: Lighthouse mobil profilinde LCP fazı TTFB + "load delay" +
	// "render delay" olarak ölçüldü (7 Kasım 2026): 450 + 942 + 1346 ms.
	// Load delay'in nedeni, manşet görselinin DOM'un ORTASINDA keşfedilmesi
	// ve o sırada 9 alt-katlama görselinin isteğe girmesi. Preload, tarayıcı
	// preload scanner'ının aynı srcset/sizes'ı CSS'ten ÖNCE görmesini sağlar.
	LCPGorsel *CDPreload
}

// CDPreload önceden yüklenecek görsel (srcset/sizes ile birebir aynı).
type CDPreload struct {
	Src    string
	Srcset string
	Sizes  string
}

// templ func: haritayı sıralı basmak için sabit dil sırası.
var cdDilSirasi = []string{"tr", "en", "de", "es", "ru", "fr", "ar"}

templ cdHead(h CDHead) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ h.Title }</title>
	<meta name="description" content={ h.Desc }/>
	<link rel="canonical" href={ h.Canonical }/>
	<!-- LCP görselini MÜMKÜN OLAN EN ERKEN anda başlat. `imagesrcset` ve
	     `imagesizes`, <img> ile BİREBİR aynı olmalı; farklı olursa tarayıcı
	     iki ayrı aday sayar ve aynı görsel iki kez indirilir. -->
	if h.LCPGorsel != nil && h.LCPGorsel.Src != "" {
		if h.LCPGorsel.Srcset != "" {
			<link rel="preload" as="image" href={ h.LCPGorsel.Src }
				imagesrcset={ h.LCPGorsel.Srcset } imagesizes={ h.LCPGorsel.Sizes } fetchpriority="high"/>
		} else {
			<link rel="preload" as="image" href={ h.LCPGorsel.Src } fetchpriority="high"/>
		}
	}
	if h.NoIndex {
		<meta name="robots" content="noindex,follow"/>
	}
	<meta name="theme-color" content="#ffffff"/>

	<!-- hreflang: yalnız GERÇEK çeviriler + x-default -->
	for _, dil := range cdDilSirasi {
		if url, ok := h.Hreflang[dil]; ok && url != "" {
			<link rel="alternate" hreflang={ dil } href={ url }/>
		}
	}
	<link rel="alternate" hreflang="x-default" href={ h.Canonical }/>

	<meta property="og:site_name" content={ h.SiteName }/>
	if h.OGType == "article" {
		<meta property="og:type" content="article"/>
	} else {
		<meta property="og:type" content="website"/>
	}
	<meta property="og:title" content={ h.Title }/>
	<meta property="og:description" content={ h.Desc }/>
	<meta property="og:url" content={ h.Canonical }/>
	if h.Image != "" {
		<meta property="og:image" content={ h.Image }/>
	}
	<meta name="twitter:card" content="summary_large_image"/>

	<!-- Görsel CDN'lerine erken bağlantı: LCP'yi ~50-100 ms iyileştirir -->
	<link rel="preconnect" href="https://cdn.sanity.io" crossorigin="anonymous"/>
	<link rel="preconnect" href="https://assets.coingecko.com" crossorigin="anonymous"/>

	<!-- İkonlar. favicon.ico birçok tarayıcı ve bot tarafından KÖKTEN
	     istenir; bağlantı verilmezse her sayfa yüklemesinde 404 üretir
	     (ölçüldü, 6 Kasım 2026: tek 404 kaynağı buydu). SVG + PNG birlikte
	     veriliyor: SVG modern tarayıcıda keskin, PNG eski/bot yolunda. -->
	<link rel="icon" href="/static/icon-192.png" sizes="192x192" type="image/png"/>
	<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
	<link rel="apple-touch-icon" href="/static/icon-192.png"/>
	<link rel="manifest" href="/manifest.webmanifest"/>

	<link rel="stylesheet" href={ "/static/cd.css?v=" + cdVarlik() }/>
	<!-- Mega menü: cd.css'in üstüne biner, kendi jetonunu tanımlamaz. -->
	<link rel="stylesheet" href={ "/static/cd-menu.css?v=" + cdVarlik() }/>
	if h.RSSFeed != "" {
		<link rel="alternate" type="application/rss+xml" title={ h.SiteName + " RSS" } href={ h.RSSFeed }/>
	}
	<!-- CSP uyumlu delege dinleyiciler (data-* öznitelikleri) -->
	<script src={ "/static/csp-delegated.js?v=" + cdVarlik() } defer></script>
	<!-- Tema başlangıcı — BLOKLAYICI ve head'de olmalı: gövde boyanmadan
	     önce html sınıfı yazılmazsa koyu tema seçen kullanıcı bir kare
	     beyaz görür (FOUC). CSP satır içi betiğe izin veriyor çünkü
	     buildCSP her satır içi bloğun sha256'sını başlığa ekliyor;
	     'unsafe-inline' gerekmiyor.
	     DİKKAT: bu yorumda bilerek "script" etiketi YAZILMIYOR. CSP
	     tarayıcısı yorum içindeki etiket metnini atlıyor (htmlYorumAtla)
	     ama yorumu temiz tutmak ikinci savunma katmanı. -->
	<script>
		(function () {
			try {
				var t = localStorage.getItem('tema');
				var koyu = t === 'dark' || (t !== 'light' &&
					window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.className = koyu ? 'dark' : 'light';
				document.documentElement.classList.add('cd-js');
			} catch (e) {
				/* localStorage kapalı (gizli mod): medya sorgusu devralır. */
			}
		})();
	</script>
	<!-- Organization + WebSite: templ script içini ham saydığı için Go'da üretilir -->
	@templ.Raw(h.JSONLD)
}
