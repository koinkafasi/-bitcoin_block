// Package templkit — birleşik gelen kutusu (Faz 167).
//
// NEDEN: iletişim mesajları, içerik geri bildirimi ve yorumlar üç ayrı
// ekrandaydı; "bugün ne geldi?" sorusu üç yere bakmayı gerektiriyordu.
// Bu görünüm SALT OKUMADIR: her öğe kendi ekranına yönlendirir, böylece
// yetki ve iş kuralları tek yerde (kaynağın kendi sayfasında) kalır.
package templkit

import "time"

// GelenSatir tek bir gelen öğe.
type GelenSatir struct {
	Tur    string
	TurAd  string
	Ikon   string
	Baslik string
	Ozet   string
	Kimden string
	Durum  string
	Href   string
	Zaman  string
	Yeni   bool
}

// GelenKutuView gelen kutusu ekranı.
type GelenKutuView struct {
	Satirlar   []GelenSatir
	YeniMesaj  int
	YeniBildir int
	YeniYorum  int
	Suzgec     string
}

// GelenKutuPanel gelen kutusu gövdesi.
templ GelenKutuPanel(v GelenKutuView) {
	<div class="gelen">
		<div class="gelen-ozet">
			<a class={ "gelen-kart", templ.KV("on", v.Suzgec == "" || v.Suzgec == "hepsi") } href="/admin/gelen-kutusu">
				<span class="gelen-kart__sayi">{ itoaT(v.YeniMesaj + v.YeniBildir + v.YeniYorum) }</span>
				<span class="gelen-kart__ad">Bekleyen toplam</span>
			</a>
			<a class={ "gelen-kart", templ.KV("on", v.Suzgec == "iletisim") } href="/admin/gelen-kutusu?tur=iletisim">
				<svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-mail"></use></svg>
				<span class="gelen-kart__sayi">{ itoaT(v.YeniMesaj) }</span>
				<span class="gelen-kart__ad">İletişim</span>
			</a>
			<a class={ "gelen-kart", templ.KV("on", v.Suzgec == "bildirim") } href="/admin/gelen-kutusu?tur=bildirim">
				<svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-message-dots"></use></svg>
				<span class="gelen-kart__sayi">{ itoaT(v.YeniBildir) }</span>
				<span class="gelen-kart__ad">Geri bildirim</span>
			</a>
			<a class={ "gelen-kart", templ.KV("on", v.Suzgec == "yorum") } href="/admin/gelen-kutusu?tur=yorum">
				<svg class="ti" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-message-circle"></use></svg>
				<span class="gelen-kart__sayi">{ itoaT(v.YeniYorum) }</span>
				<span class="gelen-kart__ad">Yorum</span>
			</a>
		</div>

		if len(v.Satirlar) == 0 {
			@BosDurum("inbox", "Gelen kutusu boş", "Yeni iletişim mesajı, geri bildirim ya da yorum geldiğinde burada görünür.", "", "")
		} else {
			<div class="gelen-liste">
				for _, s := range v.Satirlar {
					<a class="gelen-oge" href={ templ.SafeURL(s.Href) }>
						<span class="gelen-oge__ikon" aria-hidden="true">
							<svg class="ti"><use href={ "/static/vendor/tabler-icons.svg?v=b89545a6#ti-" + s.Ikon }></use></svg>
						</span>
						<span class="gelen-oge__govde">
							<span class="gelen-oge__ust">
								<span class="gelen-oge__baslik">{ s.Baslik }</span>
								if s.Yeni {
									<span class="badge gelen-oge__yeni">yeni</span>
								}
								<span class="gelen-oge__zaman">{ s.Zaman }</span>
							</span>
							<span class="gelen-oge__ozet">{ s.Ozet }</span>
							<span class="gelen-oge__alt">
								<span class="badge">{ s.TurAd }</span>
								<span>{ s.Kimden }</span>
							</span>
						</span>
						<svg class="ti gelen-oge__ok" aria-hidden="true"><use href="/static/vendor/tabler-icons.svg?v=b89545a6#ti-arrow-up-right"></use></svg>
					</a>
				}
			</div>
		}
	</div>
}

// gelenZaman testlerde biçim doğrulaması için kullanılmıyor; zaman
// biçimlendirmesi handler tarafında yapılıyor (saat dilimi tek yerden).
var _ = time.Time{}
