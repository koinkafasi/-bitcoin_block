package templkit

// CoinDesk kabuğu — templ karşılığı.
//
// Yalnız YAPI ve SINIF adları burada; ölçüler cd.css'te (docs/COINDESK-SPEC.md
// §2). Böylece tasarım ayarı tek dosyada kalır, şablon okunur olur.
//
// NOT: templ dosyasına `import "strconv"` gibi yardımcılar konmaz; Go
// yardımcıları cd_shell.go'da (aynı paket). Şablon içinde yalnız alan
// erişimi ve iki dallı if kullanılır — templ'in koşullu öznitelik sözdizimi
// sürümden sürüme değişiyor, dallar her sürümde çalışır.

// cdLogoMark site logosu — GÖRSEL (marka dosyası).
//
// ÖNCE metin olarak çiziliyordu ("BitCoŞaR." + sarı nokta). Kullanıcı
// marka logosunu verdi (965×211, sarı "BİTCOŞAR" + beyaz "paranın
// geleceği" alt yazısı) ve logonun yerine konmasını istedi.
//
// ÖLÇEKLENEBİLİRLİK: üç kademe `srcset` (1x/2x/3x) + sabit `width`/`height`
// → CLS YOK. Görsel, üst çubuğun KENDİ zeminine (koyu #0a0b0e) göre
// hazırlandı: sarı harfler + beyaz alt yazı, şeffaf zemin.
//
// `alt` site adını taşır (ekran okuyucu ve bağlantı metni); dekoratif
// sayılmaz çünkü ana sayfaya giden tek marka bağlantısıdır.
// İKİ VARYANT: markanın alt yazısı ("paranın geleceği") kaynakta BEYAZ.
// Açık temada beyaz zemin üzerinde görünmez olurdu; bu yüzden açık tema
// için alt yazısı koyu renge çevrilmiş ayrı bir dosya kümesi var. İkisi
// de aynı ölçü/oran; hangisinin görüneceğini TEMA belirliyor (CSS).
// `alt` yalnız birinde dolu olur — ekran okuyucu logoyu iki kez okumasın
// diye ikinci görsel `alt=""` + `aria-hidden`.
templ cdLogoMark(sh CDShell) {
	<a class="cd-logo" href="/" aria-label={ sh.SiteName + " ana sayfa" }>
		if sh.LogoURL != "" {
			<!-- PANELDEN YÜKLENEN LOGO (11 Kasım 2026).
			     Önceden burada SABİT bir PNG vardı ve admin panelden
			     yüklenen logo hiçbir yerde görünmüyordu.

			     Koyu/açık ayrımı: yüklenen tek dosya her iki temada da
			     kullanılır (kullanıcı ne yüklediyse o). Ayrı bir "açık
			     tema" dosyası yüklenirse LogoAcikURL dolar ve CSS onu
			     gösterir.

			     width/height GERÇEK ölçüden gelir (CLS). Bilinmiyorsa
			     146×32'ye düşülür — eski logonun ölçüsü. -->
			<img class="cd-logo__img cd-logo__img--koyu cd-logo__img--yuklenen"
				src={ sh.LogoURL }
				width={ cdLogoOlcu(sh.LogoGenislik, 146) }
				height={ cdLogoOlcu(sh.LogoYukseklik, 32) }
				alt={ sh.SiteName } decoding="async"/>
			if sh.LogoAcikURL != "" {
				<img class="cd-logo__img cd-logo__img--acik" src={ sh.LogoAcikURL }
					width={ cdLogoOlcu(sh.LogoGenislik, 146) }
					height={ cdLogoOlcu(sh.LogoYukseklik, 32) }
					alt="" aria-hidden="true" decoding="async"/>
			}
			if cdDolu(sh.Tagline) {
				<span class="cd-logo__slogan">{ cdKirp(sh.Tagline) }</span>
			}
		} else {
			<img class="cd-logo__img cd-logo__img--koyu" src="/static/img/logo-bitcosar-2x.png"
				srcset="/static/img/logo-bitcosar-1x.png 1x, /static/img/logo-bitcosar-2x.png 2x, /static/img/logo-bitcosar-3x.png 3x"
				width="146" height="32" alt={ sh.SiteName } decoding="async"/>
			<img class="cd-logo__img cd-logo__img--acik" src="/static/img/logo-bitcosar-acik-2x.png"
				srcset="/static/img/logo-bitcosar-acik-1x.png 1x, /static/img/logo-bitcosar-acik-2x.png 2x, /static/img/logo-bitcosar-acik-3x.png 3x"
				width="146" height="32" alt="" aria-hidden="true" decoding="async"/>
		}
	</a>
}

// cdTicker fiyat şeridi. JS'siz de okunur: sekmeler <a>, içerik sunucudan.
//
// 8. tur (kullanıcı isteği): "Markets Live" düğme değil METİN etiket;
// yanında canlı noktası. Sekmeler "Kripto" / "Hisse" — tıklanınca aynı
// sayfa `?serit=` ile sunucudan yeni veriyle döner (derin bağlanabilir).
//
// Kaydırma durumu: sayfa başında öğe İKİ SATIR (sembol üstte, fiyat
// altta) ve değişim gizli — sade görünüm. `html.cd-kaydi` (csp-delegated.js
// scroll eşiğinde ekler) ile öğe TEK SATIRA geçer ve değişim görünür.
templ cdTicker(s CDShell) {
	<div class="cd-ticker" role="region" aria-label="Piyasa şeridi">
		<div class="cd-wrap">
			<div class="cd-ticker__inner">
				<!-- Mobilde "Canlı Piyasalar" etiketi sekmelerin ÜSTÜNE
				     çıkar (CoinDesk mobil ölçümü: sol küme 122×59,
				     etiket 10/15 + 8 px + sekmeler 36). Masaüstünde
				     ikisi yan yana kalır. -->
				<div class="cd-ticker__sol">
					<span class="cd-ticker__canli">
						<span class="cd-ticker__nokta" aria-hidden="true"></span>
						Canlı Piyasalar
					</span>
					<div class="cd-ticker__tabs" role="tablist">
						if s.TickerTab == "stocks" {
							<a class="cd-ticker__tab" role="tab" aria-selected="false" href="?serit=markets">Kripto</a>
							<a class="cd-ticker__tab" role="tab" aria-selected="true" href="?serit=stocks">Hisse Senetleri</a>
						} else {
							<a class="cd-ticker__tab" role="tab" aria-selected="true" href="?serit=markets">Kripto</a>
							<a class="cd-ticker__tab" role="tab" aria-selected="false" href="?serit=stocks">Hisse Senetleri</a>
						}
					</div>
				</div>
				<!-- data-cg-sym: canlı akış (/canli/piyasa, SSE) bu kalemi
				     sembolle bulup fiyatını DEĞİŞTİĞİ ANDA tazeler
				     (cd-canli.js). Yorum döngünün DIŞINDA: içeride her
				     kalem için tekrarlanıp HTML'i şişiriyordu. -->
				<!-- data-cg-sym: canlı akış (/canli/piyasa, SSE) bu kalemi
				     sembolle bulup fiyatını DEĞİŞTİĞİ ANDA tazeler
				     (cd-canli.js). Yorum döngünün DIŞINDA: içeride her
				     kalem için tekrarlanıp HTML'i şişiriyordu. -->
				for i, it := range s.Ticker {
					if i > 0 {
						<!-- Kalemler arası dikey ayırıcı — CoinDesk'te
						     1×32 px `role="separator"` (ölçüldü). -->
						<div class="cd-ticker__ayirici" role="separator"
							aria-orientation="vertical"></div>
					}
					<!-- HREF: kripto kalemleri /price/{slug}'a, BIST kalemleri
					     /markets'e gider. `Href` boşsa bağlantı kurulmaz
					     (ölü "/price/BIST" adresi basılmaz). -->
					if it.Href != "" {
						<a class="cd-ticker__item" data-cg-sym={ it.Sym } href={ templ.SafeURL(it.Href) }>
							<span class="cd-ticker__sym">{ it.Sym }</span>
							<span class="cd-ticker__alt">
								<span class="cd-ticker__px">{ it.Price }</span>
								if it.Up {
									<span class="cd-up">{ it.Change }</span>
								} else {
									<span class="cd-down">{ it.Change }</span>
								}
							</span>
						</a>
					} else {
						<span class="cd-ticker__item" data-cg-sym={ it.Sym }>
							<span class="cd-ticker__sym">{ it.Sym }</span>
							<span class="cd-ticker__alt">
								<span class="cd-ticker__px">{ it.Price }</span>
								if it.Up {
									<span class="cd-up">{ it.Change }</span>
								} else {
									<span class="cd-down">{ it.Change }</span>
								}
							</span>
						</span>
					}
				}
			</div>
		</div>
	</div>
}

// cdTopbar üst gezinme. Mega menü Faz 2'de; burada birincil bağlantılar.
templ cdTopbar(s CDShell) {
	<header class="cd-topbar">
		<div class="cd-wrap">
			<div class="cd-topbar__inner">
				<!-- MOBİL SOL KÜME — CoinDesk ölçümü (9 Kasım 2026):
				     hamburger 32×32 x=16, arama 36×32 x=48. Masaüstünde
				     gizli; mobilde mega nav ve aksiyon şeridi yerine
				     bunlar görünür (CoinDesk mobil başlığı). -->
				<div class="cd-topbar__sol">
					@cdMobilNav(s)
					<a class="cd-mobil-arama" href={ s.SearchHref } data-arama-ac
						aria-label="Aramayı aç" aria-expanded="false" aria-controls="cd-arama">
						<svg class="cd-mobil-arama__ikon" viewBox="0 0 24 24" width="24" height="24"
							fill="none" stroke="currentColor" stroke-width="1.5"
							stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
							focusable="false">
							<path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
						</svg>
					</a>
				</div>
				@cdLogoMark(s)
				@cdMegaNav(s)
				<div class="cd-topbar__actions">
					<!-- ARAMA — CoinDesk'te bağlantı değil, HAP biçimli düğme:
					     200×40, zemin surface-subtle, köşe 9999, 16 px büyüteç +
					     "Ara" + sağda "/" ipucu (24×24 daire, 1 px çerçeve).
					     Tıklayınca sayfa değişmez, ARAMA PANELİ açılır (ölçüm
					     7 Kasım 2026, coindesk.com). -->
					<!-- Bağlantı olarak yazıldı: JS kapalıysa /arama sayfasına
					     gider (ilerlemeli geliştirme); JS varsa csp-delegated.js
					     varsayılanı iptal edip paneli açar. -->
					<a class="cd-arama-ac" href={ s.SearchHref } data-arama-ac
						aria-label="Aramayı aç" aria-expanded="false" aria-controls="cd-arama">
						<svg class="cd-arama-ac__ikon" viewBox="0 0 24 24" width="16" height="16"
							fill="none" stroke="currentColor" stroke-width="1.5"
							stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
							focusable="false">
							<path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
						</svg>
						<span class="cd-arama-ac__metin">Ara</span>
						<span class="cd-arama-ac__ipucu" aria-hidden="true">/</span>
					</a>
					<!-- Tema anahtarı. Varsayılan GİZLİ (`display:none`); init
					     betiği `html.cd-js` ekleyince görünür. JS yoksa ölü
					     düğme göstermiyoruz. Tercih localStorage'da.
					     Simge SVG: projede templ dosyalarında emoji YASAK
					     (emoji_test.go, TestTumTemplDosyalariEmojisiz). -->
					<button class="cd-tema" type="button" data-tema
						aria-label="Karanlık moda geç" aria-pressed="false">
						<!-- İKİ İKON DA DOM'DA: açık temada AY, koyu temada GÜNEŞ.
						     Görünürlüğü tema sınıfı belirliyor (CSS) — JS ile ikon
						     değiştirmek FOUC ve eksik-durum riski taşıyordu.
						     İkonlar CoinDesk'in kendi yolları (ölçüm 7 Kasım 2026). -->
						<svg class="cd-tema__ikon cd-tema__ay" viewBox="0 0 24 24" width="20" height="20"
							aria-hidden="true" focusable="false" fill="none"
							stroke="currentColor" stroke-width="2" stroke-linecap="round"
							stroke-linejoin="round">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
						</svg>
						<svg class="cd-tema__ikon cd-tema__gunes" viewBox="0 0 24 24" width="20" height="20"
							aria-hidden="true" focusable="false" fill="none"
							stroke="currentColor" stroke-width="2" stroke-linecap="round"
							stroke-linejoin="round">
							<circle cx="12" cy="12" r="5"></circle>
							<line x1="12" y1="1" x2="12" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="23"></line>
							<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
							<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
							<line x1="1" y1="12" x2="3" y2="12"></line>
							<line x1="21" y1="12" x2="23" y2="12"></line>
							<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
							<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
						</svg>
					</button>
					if len(s.Diller) > 1 {
						<!-- Dil seçici: satır içi olay YOK (CSP 'unsafe-inline'
						     kapatıldı). data-git ile csp-delegated.js yönlendirir. -->
						<label class="cd-lang">
							<span class="cd-visually-hidden">Dil</span>
							<select class="cd-lang__sec" data-git aria-label="Dil">
								for _, d := range s.Diller {
									if d.Aktif {
										<option value={ d.Href } selected>{ d.Kod }</option>
									} else {
										<option value={ d.Href }>{ d.Kod }</option>
									}
								}
							</select>
						</label>
					} else {
						/* Tek dil: seçici yerine ETİKET. CoinDesk'te de aynı
						   kutu (75×40, küre ikonu + kod) ama tıklanmıyor. */
						for _, d := range s.Diller {
							<span class="cd-lang__tek" aria-label="Dil">
								<svg class="cd-lang__ikon" viewBox="0 0 24 24" fill="none"
									stroke="currentColor" stroke-width="1.6" aria-hidden="true"
									focusable="false">
									<circle cx="12" cy="12" r="9"></circle>
									<path d="M3 12h18"></path>
									<path d="M12 3c2.5 2.6 3.9 5.7 3.9 9s-1.4 6.4-3.9 9c-2.5-2.6-3.9-5.7-3.9-9S9.5 5.6 12 3z"></path>
								</svg>
								{ d.Kod }
							</span>
						}
					}
					<!-- Dil ile oturum kümesi arasındaki DİKEY AYIRICI — CoinDesk
					     ölçümü (7 Kasım 2026): 1×40 px, `#d9d9d9`, `role="separator"`.
					     İki yanında 8 px boşluk var (kapsayıcı gap'i). -->
					if len(s.Diller) > 0 && (s.LoginHref != "" || s.LoggedIn) {
						<div class="cd-topbar__ayirici" role="separator"
							aria-orientation="vertical"></div>
					}
					<!-- OTURUM DALI (kullanıcı isteği, 8 Kasım 2026: "giriş
					     yapmışken neden hâlâ oturum aç ve kaydol gösteriyor"):
					     oturum YOKKEN iki bağlantı (CoinDesk ölçümü 104×40 +
					     77×40); oturum VARKEN ikisi de kalkar, yerine kullanıcı
					     simgesi + hesap menüsü gelir. Menü <details> — JS'siz
					     açılır, klavye/dokunmatik çalışır (CSP 'unsafe-inline'
					     yok; mobil menüyle aynı desen). -->
					if s.LoggedIn {
						@cdHesapMenu(s)
					} else {
						if s.LoginHref != "" {
							<a class="cd-btn cd-btn--ghost" href={ s.LoginHref }>Oturum Aç</a>
						}
						if s.SignupHref != "" {
							<a class="cd-btn cd-btn--kayit" href={ s.SignupHref }>Kaydol</a>
						}
					}
				</div>
				<!-- MOBİL SAĞ — CoinDesk'te "Sign In": 40 px yükseklik,
				     0 16 dolgu, 16/24 w400, radius 4. Oturum açıkken
				     aynı yerde avatar bağlantısı durur. -->
				if s.LoggedIn {
					<a class="cd-mobil-hesap" href={ s.UserHref } aria-label="Hesabım">
						<span class="cd-hesap-ac__avatar" aria-hidden="true">{ s.UserInitial }</span>
					</a>
				} else {
					if s.LoginHref != "" {
						<a class="cd-mobil-giris" href={ s.LoginHref }>Oturum Aç</a>
					}
				}
			</div>
		</div>
	</header>
	@cdAramaPanel(s)
}

// cdHesapMenu üst çubuk hesap menüsü — OTURUM AÇIKKEN.
//
// NEDEN: kullanıcı bildirimi (8 Kasım 2026) — giriş yapılmışken üst çubuk
// yine "Oturum Aç" + "Kaydol" gösteriyordu. CoinDesk'in girişli üst çubuğu
// Auth0 duvarının arkasında ölçülemiyor (bkz. cd_hesap.go notu); geometri
// UYDURULMADI — sitenin ölçülmüş aksiyon kademeleri kullanıldı: 40 px
// yükseklik, radius 4, 14/21 w500, yüzey/çizgi jetonları.
//
// JS YOK: açılış <details>'in kendi davranışı (mobil menüyle aynı desen,
// bkz. cd_mobil.templ). csp-delegated.js yalnız DIŞARI tıklama ve Escape
// ile kapatmayı ekler; JS olmasa da menü açılır-kapanır.
//
// ÇIKIŞ GET DEĞİL: bağlantı ile oturum kapatan sayfa var (forced-logout
// CSRF — cikis_test.go); form POST /cikis'e gider, aynı Origin ara katmanı
// tarafından onaylanır.
templ cdHesapMenu(s CDShell) {
	<details class="cd-hesap-ac" data-hesap>
		<summary class="cd-hesap-ac__dugme" aria-label={ s.UserName + " — hesap menüsü" }>
			<span class="cd-hesap-ac__avatar" aria-hidden="true">{ s.UserInitial }</span>
			if s.UserUnread > 0 {
				<span class="cd-hesap-ac__rozet" aria-hidden="true">{ cdBildirimSayi(s.UserUnread) }</span>
			}
		</summary>
		<div class="cd-hesap-ac__panel">
			<p class="cd-hesap-ac__ad">{ s.UserName }</p>
			<a class="cd-hesap-ac__satir" href={ s.UserHref }>Hesabım</a>
			<a class="cd-hesap-ac__satir" href={ s.UserHref + "/kaydedilenler" }>Kaydedilenler</a>
			<a class="cd-hesap-ac__satir" href={ s.UserHref + "/bildirimler" }>
				Bildirimler
				if s.UserUnread > 0 {
					<span class="cd-hesap-ac__sayi">{ cdBildirimSayi(s.UserUnread) }</span>
				}
			</a>
			<form class="cd-hesap-ac__cikis" method="post" action="/cikis">
				<button class="cd-hesap-ac__satir" type="submit">Çıkış</button>
			</form>
		</div>
	</details>
}

// cdAramaPanel arama paneli — CoinDesk'in komut paleti deseni.
//
// ÖLÇÜLDÜ (coindesk.com, 7 Kasım 2026): panel 560 px genişlik, üstten
// 64 px, köşe 16 px, 1 px çerçeve, `shadow-lg`; başlık 64 px (24 px
// büyüteç + 16/24 girdi + 32×32 kapat), altında 1 px çizgi; çipler 28 px
// yükseklik, 9999 px köşe, 6/8 dolgu, 12/16 metin; gövde kaydırılır.
//
// JS'SİZ DE ÇALIŞIR: panel `hidden` gelir; form doğrudan
// `action` ile /arama?q=... adresine gider. Açma/kapama ve çip süzgeci
// csp-delegated.js'te (CSP 'unsafe-inline' yok).
//
// VERİ UYDURULMAZ: gövde yalnız GERÇEK veriyi basar — şeritten gelen
// fiyatlar ve gezinmedeki bölüm bağlantıları. Veri yoksa grup basılmaz.
templ cdAramaPanel(s CDShell) {
	<div class="cd-arama" id="cd-arama" hidden>
		<div class="cd-arama__perde" data-arama-kapat></div>
		<section class="cd-arama__panel" role="dialog" aria-modal="true"
			aria-label="Arama">
			<form class="cd-arama__form" action={ s.SearchHref } method="get"
				role="search">
				<div class="cd-arama__ust">
					<svg class="cd-arama__buyutec" viewBox="0 0 24 24" width="24" height="24"
						fill="none" stroke="currentColor" stroke-width="1.5"
						stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
						focusable="false">
						<path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
					</svg>
					<input class="cd-arama__girdi" type="search" name="q"
						placeholder="Haber, fiyat veya kategori ara" autocomplete="off"
						aria-label="Arama metni"/>
					<button class="cd-arama__kapat" type="button" data-arama-kapat
						aria-label="Aramayı kapat">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="none"
							stroke="currentColor" stroke-width="2" stroke-linecap="round"
							stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M6 6l12 12M18 6L6 18"/>
						</svg>
					</button>
				</div>
				<div class="cd-arama__cipler" role="group" aria-label="Arama türü">
					<button class="cd-arama__cip cd-arama__cip--aktif" type="button"
						data-arama-cip="hepsi" aria-pressed="true">Tümü</button>
					if len(s.Ticker) > 0 {
						<button class="cd-arama__cip" type="button"
							data-arama-cip="piyasalar" aria-pressed="false">Piyasalar</button>
					}
					if len(s.Nav) > 0 {
						<button class="cd-arama__cip" type="button"
							data-arama-cip="bolumler" aria-pressed="false">Bölümler</button>
					}
				</div>
				<div class="cd-arama__govde">
					if len(s.Ticker) > 0 {
						<div class="cd-arama__grup" data-arama-grup="piyasalar">
							<h2 class="cd-arama__baslik">Piyasalar</h2>
							for _, it := range s.Ticker {
								<a class="cd-arama__satir" href={ "/price/" + it.Slug }>
									<span class="cd-arama__simge">{ it.Sym }</span>
									<span class="cd-arama__fiyat">{ it.Price }</span>
									if it.Up {
										<span class="cd-arama__degisim cd-up">{ it.Change }</span>
									} else {
										<span class="cd-arama__degisim cd-down">{ it.Change }</span>
									}
								</a>
							}
						</div>
					}
					if len(s.Nav) > 0 {
						<div class="cd-arama__grup" data-arama-grup="bolumler">
							<h2 class="cd-arama__baslik">Bölümler</h2>
							for _, l := range s.Nav {
								<a class="cd-arama__bolum" href={ l.Href }>{ l.Label }</a>
							}
						</div>
					}
				</div>
			</form>
		</section>
	</div>
}

// cdFooter alt bilgi — ölçülen dört bant (spec §7.4).
//
// Sıra: logo → 5 bağlantı sütunu → yasal bağlantılar → feragat + telif.
// İç genişlik 1280 px: gövdenin 1512'sinden DAR (üçüncü kademe).
templ cdFooter(s CDShell) {
	<footer class="cd-footer">
		<div class="cd-footer__ic">
			<a class="cd-footer__logo" href="/">{ s.SiteName }<span>.</span></a>

			<!-- DÖRT sütun; her sütunda 2-3 bölüm ÜST ÜSTE (CoinDesk ölçümü).
			     Sütun başına tek bölüm basan eski yapı alt bilgiyi yarıya
			     indiriyordu (497 px vs 942). -->
			<div class="cd-footer__cols">
				for _, sut := range cdFooterSutunlari(s) {
					<div class="cd-footer__sutun">
						for _, bol := range sut {
							<div class="cd-footer__bolum">
								<h3>{ bol.Title }</h3>
								<ul>
									for _, l := range bol.Links {
										<li>
											<a href={ l[1] }>{ l[0] }</a>
										</li>
									}
								</ul>
							</div>
						}
					</div>
				}
			</div>

			<hr/>

			<!-- Yasal bağlantılar solda, sosyal ikonlar SAĞDA (ölçüldü:
			     CoinDesk /tr alt bilgisi; 10/16 link, 16-24 px ikon, gap 16). -->
			<div class="cd-footer__yasal">
				<div class="cd-footer__yasal-sol">
					<a href="/gizlilik-politikasi">Gizlilik</a>
					<a href="/kullanim-kosullari">Kullanım Koşulları</a>
					<a href="/cerez-politikasi">Çerez Politikası</a>
					<a href="/reklam-politikasi">Reklam Politikası</a>
					<a href="/iletisim">İletişim</a>
					<a href="/rss.xml">RSS</a>
				</div>
				<div class="cd-footer__sosyal">
					<a href="https://x.com/bitcosar" rel="noopener nofollow" aria-label="X">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M18.9 2H22l-7.1 8.1L23 22h-6.6l-5.2-6.8L5.2 22H2l7.6-8.7L1.6 2h6.8l4.7 6.2L18.9 2zm-1.1 18h1.8L6.3 3.8H4.4L17.8 20z"/>
						</svg>
					</a>
					<a href="https://facebook.com/bitcosar" rel="noopener nofollow" aria-label="Facebook">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.3-1.5 1.6-1.5h1.7V4.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.4V14h2.7v8h3.4z"/>
						</svg>
					</a>
					<a href="https://linkedin.com/company/bitcosar" rel="noopener nofollow" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M6.9 8.6v11.5H3.2V8.6h3.7zM5 3.2a2.1 2.1 0 110 4.3 2.1 2.1 0 010-4.3zM20.8 20.1h-3.7v-6.2c0-1.5-.5-2.5-1.8-2.5-1 0-1.6.7-1.9 1.4-.1.2-.1.6-.1.9v6.4H9.6s.1-10.4 0-11.5h3.7v1.6c.5-.8 1.4-1.9 3.4-1.9 2.5 0 4.1 1.6 4.1 5.1v6.7z"/>
						</svg>
					</a>
					<a href="/rss.xml" aria-label="RSS">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
							<circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none"/>
							<path d="M4 11a9 9 0 019 9M4 5a15 15 0 0115 15"/>
						</svg>
					</a>
					<a href="https://instagram.com/bitcosar" rel="noopener nofollow" aria-label="Instagram">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true" focusable="false">
							<rect x="3" y="3" width="18" height="18" rx="5"/>
							<circle cx="12" cy="12" r="4"/>
							<circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>
						</svg>
					</a>
					<a href="https://youtube.com/@bitcosar" rel="noopener nofollow" aria-label="YouTube">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M21.6 7.2a2.5 2.5 0 00-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 00-1.8 1.8A26 26 0 002 12a26 26 0 00.4 4.8 2.5 2.5 0 001.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 001.8-1.8A26 26 0 0022 12a26 26 0 00-.4-4.8zM10 15.2V8.8l5.5 3.2L10 15.2z"/>
						</svg>
					</a>
					<a href="https://t.me/bitcosar" rel="noopener nofollow" aria-label="Telegram">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M21.9 4.3L18.8 19c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.4 12.4 1.5 10.9c-1.1-.3-1.1-1.1.2-1.6l19-7.3c.9-.3 1.7.2 1.2 2.3z"/>
						</svg>
					</a>
				</div>
			</div>

			<hr/>

			<div class="cd-footer__alt">
				<span>© 2026 bitcosar — Tüm hakları saklıdır.</span>
				<span>Kaynaklar atıf ile gösterilir; tam metin yayınlanmaz.</span>
			</div>
		</div>
	</footer>
}

// cdSectionHead bölüm başlığı + "tümü" bağlantısı.
templ cdSectionHead(title, href string) {
	<div class="cd-section-head">
		<h2>{ title }</h2>
		if href != "" {
			<a href={ href }>Tümü →</a>
		}
	</div>
}

// cdAd reklam yuvası. Yükseklik ayrılmış: reklam gelmese de düzen kaymaz (CLS).
templ cdAd(etiket string) {
	<div class="cd-ad" role="complementary" aria-label="Reklam">
		{ etiket }
	</div>
}
