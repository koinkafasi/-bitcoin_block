package templkit

// CoinDesk kabuğu — templ karşılığı.
//
// Yalnız YAPI ve SINIF adları burada; ölçüler cd.css'te (docs/COINDESK-SPEC.md
// §2). Böylece tasarım ayarı tek dosyada kalır, şablon okunur olur.
//
// NOT: templ dosyasına `import "strconv"` gibi yardımcılar konmaz; Go
// yardımcıları cd_shell.go'da (aynı paket). Şablon içinde yalnız alan
// erişimi ve iki dallı if kullanılır — templ'in koşullu öznitelik sözdizimi
// sürümden sürüme değişiyor, dallar her sürümde çalışır.

// cdLogoMark "bitcosar" logosu: son nokta mavi (CoinDesk vurgu rengi).
templ cdLogoMark(siteName string) {
	<a class="cd-logo" href="/">
		{ siteName }<span>.</span>
	</a>
}

// cdTicker fiyat şeridi. JS'siz de okunur: sekmeler <a>, içerik sunucudan.
//
// 8. tur (kullanıcı isteği): "Markets Live" düğme değil METİN etiket;
// yanında canlı noktası. Sekmeler "Kripto" / "Hisse" — tıklanınca aynı
// sayfa `?serit=` ile sunucudan yeni veriyle döner (derin bağlanabilir).
//
// Kaydırma durumu: sayfa başında öğe İKİ SATIR (sembol üstte, fiyat
// altta) ve değişim gizli — sade görünüm. `html.cd-kaydi` (csp-delegated.js
// scroll eşiğinde ekler) ile öğe TEK SATIRA geçer ve değişim görünür.
templ cdTicker(s CDShell) {
	<div class="cd-ticker" role="region" aria-label="Piyasa şeridi">
		<div class="cd-wrap">
			<div class="cd-ticker__inner">
				<span class="cd-ticker__canli">
					<span class="cd-ticker__nokta" aria-hidden="true"></span>
					Canlı Piyasalar
				</span>
				<div class="cd-ticker__tabs" role="tablist">
					if s.TickerTab == "stocks" {
						<a class="cd-ticker__tab" role="tab" aria-selected="false" href="?serit=markets">Kripto</a>
						<a class="cd-ticker__tab" role="tab" aria-selected="true" href="?serit=stocks">Hisse Senetleri</a>
					} else {
						<a class="cd-ticker__tab" role="tab" aria-selected="true" href="?serit=markets">Kripto</a>
						<a class="cd-ticker__tab" role="tab" aria-selected="false" href="?serit=stocks">Hisse Senetleri</a>
					}
				</div>
				for _, it := range s.Ticker {
					<a class="cd-ticker__item" href={ "/price/" + it.Slug }>
						<span class="cd-ticker__sym">{ it.Sym }</span>
						<span class="cd-ticker__px">{ it.Price }</span>
						if it.Up {
							<span class="cd-up">{ it.Change }</span>
						} else {
							<span class="cd-down">{ it.Change }</span>
						}
					</a>
				}
			</div>
		</div>
	</div>
}

// cdTopbar üst gezinme. Mega menü Faz 2'de; burada birincil bağlantılar.
templ cdTopbar(s CDShell) {
	<header class="cd-topbar">
		<div class="cd-wrap">
			<div class="cd-topbar__inner">
				@cdLogoMark(s.SiteName)
				@cdMegaNav(s)
				@cdMobilNav(s)
				<div class="cd-topbar__actions">
					<a class="cd-ikon-btn" href={ s.SearchHref } aria-label="Ara">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none"
							stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
							<circle cx="11" cy="11" r="7"></circle>
							<path d="M20 20l-4.2-4.2"></path>
						</svg>
					</a>
					<!-- Tema anahtarı. Varsayılan GİZLİ (`display:none`); init
					     betiği `html.cd-js` ekleyince görünür. JS yoksa ölü
					     düğme göstermiyoruz. Tercih localStorage'da.
					     Simge SVG: projede templ dosyalarında emoji YASAK
					     (emoji_test.go, TestTumTemplDosyalariEmojisiz). -->
					<button class="cd-tema" type="button" data-tema
						aria-label="Koyu temaya geç" aria-pressed="false">
						<!-- Ay simgesi: CoinDesk üst çubuğundaki tema anahtarıyla aynı
						     görsel dil (ölçüm 7 Kasım 2026). Eski yarım daire okunmuyordu. -->
						<svg class="cd-tema__ikon" viewBox="0 0 24 24" width="18" height="18"
							aria-hidden="true" focusable="false" fill="none"
							stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
							stroke-linejoin="round">
							<path d="M20.5 14.5A8.5 8.5 0 019.5 3.5a8.5 8.5 0 1011 11z"/>
						</svg>
					</button>
					if len(s.Diller) > 1 {
						<!-- Dil seçici: satır içi olay YOK (CSP 'unsafe-inline'
						     kapatıldı). data-git ile csp-delegated.js yönlendirir. -->
						<label class="cd-lang">
							<span class="cd-visually-hidden">Dil</span>
							<select class="cd-lang__sec" data-git aria-label="Dil">
								for _, d := range s.Diller {
									if d.Aktif {
										<option value={ d.Href } selected>{ d.Kod }</option>
									} else {
										<option value={ d.Href }>{ d.Kod }</option>
									}
								}
							</select>
						</label>
					} else {
						for _, d := range s.Diller {
							<span class="cd-lang__tek" aria-label="Dil">{ d.Kod }</span>
						}
					}
					if s.LoginHref != "" {
						<a class="cd-btn cd-btn--ghost" href={ s.LoginHref }>Oturum Aç</a>
					}
					if s.SignupHref != "" {
						<a class="cd-btn cd-btn--kayit" href={ s.SignupHref }>Kaydol</a>
					}
				</div>
			</div>
		</div>
	</header>
}

// cdFooter alt bilgi — ölçülen dört bant (spec §7.4).
//
// Sıra: logo → 5 bağlantı sütunu → yasal bağlantılar → feragat + telif.
// İç genişlik 1280 px: gövdenin 1512'sinden DAR (üçüncü kademe).
templ cdFooter(s CDShell) {
	<footer class="cd-footer">
		<div class="cd-footer__ic">
			<a class="cd-footer__logo" href="/">{ s.SiteName }<span>.</span></a>

			<!-- DÖRT sütun; her sütunda 2-3 bölüm ÜST ÜSTE (CoinDesk ölçümü).
			     Sütun başına tek bölüm basan eski yapı alt bilgiyi yarıya
			     indiriyordu (497 px vs 942). -->
			<div class="cd-footer__cols">
				for _, sut := range cdFooterSutunlari(s) {
					<div class="cd-footer__sutun">
						for _, bol := range sut {
							<div class="cd-footer__bolum">
								<h3>{ bol.Title }</h3>
								<ul>
									for _, l := range bol.Links {
										<li>
											<a href={ l[1] }>{ l[0] }</a>
										</li>
									}
								</ul>
							</div>
						}
					</div>
				}
			</div>

			<hr/>

			<!-- Yasal bağlantılar solda, sosyal ikonlar SAĞDA (ölçüldü:
			     CoinDesk /tr alt bilgisi; 10/16 link, 16-24 px ikon, gap 16). -->
			<div class="cd-footer__yasal">
				<div class="cd-footer__yasal-sol">
					<a href="/gizlilik-politikasi">Gizlilik</a>
					<a href="/kullanim-kosullari">Kullanım Koşulları</a>
					<a href="/cerez-politikasi">Çerez Politikası</a>
					<a href="/reklam-politikasi">Reklam Politikası</a>
					<a href="/iletisim">İletişim</a>
					<a href="/rss.xml">RSS</a>
				</div>
				<div class="cd-footer__sosyal">
					<a href="https://x.com/bitcosar" rel="noopener nofollow" aria-label="X">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M18.9 2H22l-7.1 8.1L23 22h-6.6l-5.2-6.8L5.2 22H2l7.6-8.7L1.6 2h6.8l4.7 6.2L18.9 2zm-1.1 18h1.8L6.3 3.8H4.4L17.8 20z"/>
						</svg>
					</a>
					<a href="https://facebook.com/bitcosar" rel="noopener nofollow" aria-label="Facebook">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.3-1.5 1.6-1.5h1.7V4.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.4V14h2.7v8h3.4z"/>
						</svg>
					</a>
					<a href="https://linkedin.com/company/bitcosar" rel="noopener nofollow" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M6.9 8.6v11.5H3.2V8.6h3.7zM5 3.2a2.1 2.1 0 110 4.3 2.1 2.1 0 010-4.3zM20.8 20.1h-3.7v-6.2c0-1.5-.5-2.5-1.8-2.5-1 0-1.6.7-1.9 1.4-.1.2-.1.6-.1.9v6.4H9.6s.1-10.4 0-11.5h3.7v1.6c.5-.8 1.4-1.9 3.4-1.9 2.5 0 4.1 1.6 4.1 5.1v6.7z"/>
						</svg>
					</a>
					<a href="/rss.xml" aria-label="RSS">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
							<circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none"/>
							<path d="M4 11a9 9 0 019 9M4 5a15 15 0 0115 15"/>
						</svg>
					</a>
					<a href="https://instagram.com/bitcosar" rel="noopener nofollow" aria-label="Instagram">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true" focusable="false">
							<rect x="3" y="3" width="18" height="18" rx="5"/>
							<circle cx="12" cy="12" r="4"/>
							<circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>
						</svg>
					</a>
					<a href="https://youtube.com/@bitcosar" rel="noopener nofollow" aria-label="YouTube">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M21.6 7.2a2.5 2.5 0 00-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 00-1.8 1.8A26 26 0 002 12a26 26 0 00.4 4.8 2.5 2.5 0 001.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 001.8-1.8A26 26 0 0022 12a26 26 0 00-.4-4.8zM10 15.2V8.8l5.5 3.2L10 15.2z"/>
						</svg>
					</a>
					<a href="https://t.me/bitcosar" rel="noopener nofollow" aria-label="Telegram">
						<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M21.9 4.3L18.8 19c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.4 12.4 1.5 10.9c-1.1-.3-1.1-1.1.2-1.6l19-7.3c.9-.3 1.7.2 1.2 2.3z"/>
						</svg>
					</a>
				</div>
			</div>

			<hr/>

			<div class="cd-footer__alt">
				<span>© 2026 bitcosar — Tüm hakları saklıdır.</span>
				<span>Kaynaklar atıf ile gösterilir; tam metin yayınlanmaz.</span>
			</div>
		</div>
	</footer>
}

// cdSectionHead bölüm başlığı + "tümü" bağlantısı.
templ cdSectionHead(title, href string) {
	<div class="cd-section-head">
		<h2>{ title }</h2>
		if href != "" {
			<a href={ href }>Tümü →</a>
		}
	</div>
}

// cdAd reklam yuvası. Yükseklik ayrılmış: reklam gelmese de düzen kaymaz (CLS).
templ cdAd(etiket string) {
	<div class="cd-ad" role="complementary" aria-label="Reklam">
		{ etiket }
	</div>
}
